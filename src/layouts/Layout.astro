---
import { ClientRouter } from 'astro:transitions';
import { app, titulo, descri, keywii, linkweb, by, linkme, dtema }  from '../wii.js';
import { witemas } from '../lib/widev/widev.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { rutaRoles } from '../lib/rutas.js';
import estilos from './witema.css?inline';
import googleCss from '../../public/google/fonts.css?raw';
import awesomeCss from '../../public/fontawesome/css/all.min.css?raw';

const globalcss = estilos + '\n' + googleCss + '\n' + awesomeCss;
const ROUTE_ROLES = rutaRoles();
const wtema = dtema;

interface Props {
  name?: string;
  title?: string;
  description?: string;
  keywords?: string | string[];
  path?: string;
  image?: string;
  type?: string;
  robots?: string;
  audience?: string[];
  intent?: string;
}

const {
  name = app,
  title = titulo,
  description = descri,
  keywords = keywii,
  path = Astro.url.pathname,
  image = '/poster.webp',
  type = 'website',
  robots = 'index, follow',
  audience = [],
  intent = ''
} = Astro.props;

const lang = Astro.currentLocale || 'es';
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';

// Calcular URLs alternativas para SEO multilingüe (hreflang)
const cleanPath = path.replace(/^\/en/, '').replace(/\/$/, '') || '/';
const urlEs = new URL(cleanPath === '/' ? '/' : cleanPath, linkweb).toString();
const urlEn = new URL(cleanPath === '/' ? '/en' : `/en${cleanPath}`, linkweb).toString();

const canonical = new URL(path, linkweb).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, linkweb).toString();
const keywordContent = Array.isArray(keywords) ? keywords.join(', ') : keywords;
const schemaType = type === 'article' ? 'Article' : 'WebPage';
const seoSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  headline: type === 'article' ? title : undefined,
  description,
  url: canonical,
  image: imageUrl,
  inLanguage: lang,
  keywords: keywordContent,
  about: intent || undefined,
  audience: audience.length ? audience.map(item => ({ '@type': 'Audience', audienceType: item })) : undefined,
  isPartOf: {
    '@type': 'WebSite',
    name,
    url: linkweb,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${linkweb}/citas?q={search_term_string}`,
      'query-input': 'required name=search_term_string'
    }
  },
  publisher: {
    '@type': 'Organization',
    name,
    url: linkweb,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/poster.webp', linkweb).toString()
    }
  },
  author: {
    '@type': 'Person',
    name: by,
    url: linkme
  }
};
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={urlEs} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlEs} />
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={by} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
    <title>{title}</title>

    <!-- Preload selectivo de la fuente tipográfica crítica (Acelera LCP) -->
    <link rel="preload" href="/google/Poppins-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Habilitamos ClientRouter para navegación instantánea sin F5 -->
    <ClientRouter />
    <!-- Estilos Inline Globales Unificados: witema + google (Poppins & Outfit) + fontawesome (0 peticiones HTTP bloqueantes) -->
    <style is:global data-astro-transition-persist="global-css" set:html={globalcss}></style>

    <!-- Aplicación del tema síncrona inmediata para evitar parpadeo blanco (flash) -->
    <script is:inline define:vars={{ wtema, witemas, lang }}>
      (() => {
        window.__l = lang;
        window.wtema = wtema;
        
        const applyTheme = () => {
          try {
            const activeTheme = localStorage.wiTema || wtema;
            document.documentElement.dataset.theme = activeTheme;
            const themeColor = witemas[activeTheme] || '#FFC107';
            
            const metaThemeColor = document.querySelector('meta[name="theme-color"]') || 
              document.head.appendChild(Object.assign(document.createElement('meta'), { name: 'theme-color' }));
            metaThemeColor.content = themeColor;
          } catch (e) {}
        };
        
        applyTheme();
        
        document.addEventListener('astro:after-swap', () => {
          window.__l = document.documentElement.lang || 'es';
          applyTheme();
        });
      })();
    </script>

    <!-- Guardia Unificada de Rutas (Seguridad y Rendimiento) -->
    <script is:inline define:vars={{ ROUTE_ROLES }}>
      (() => {
        // c: comprueba el acceso y determina redirección si es necesario
        const checkAccess = (p) => {
          const clean = p.replace(/^\/en/, '').replace(/\/$/, '') || '/';
          const r = ROUTE_ROLES.roles[clean];
          if (!r) return 1;
          try {
            const u = JSON.parse(localStorage.getItem('wiSmile') || '{}').value;
            if (u && r.includes(u.rol)) {
              const target = ROUTE_ROLES.require2FA.includes(clean) && sessionStorage.getItem('vault_unlocked') !== 'true' ? '/verificar' : 1;
              if (target === 1) return 1;
              return p.startsWith('/en') ? `/en${target}` : target;
            }
          } catch (e) {}
          return 0;
        };

        // h: ejecuta la redirección física si no tiene privilegios
        const handleRedirect = (p, e) => {
          const r = checkAccess(p);
          if (r !== 1) {
            if (e) e.preventDefault();
            const fb = p.startsWith('/en') ? '/en' : '/';
            window.location.replace(r ? (p.startsWith('/en') ? `/en${r}` : r) : fb);
          }
        };

        handleRedirect(window.location.pathname);
        document.addEventListener('astro:before-preparation', (e) => handleRedirect(e.to.pathname, e));
      })();
    </script>
   
    <slot name="head" />
  </head>
  <body>
    <Header />
    
    <!-- Slot principal donde se renderizará el contenido de cada página -->
    <main id="wimain"> 
      <slot />
     </main>

    <Footer />

    <div id="wiTema">
      <div class="tema" data-ths="cielo"></div>
      <div class="tema" data-ths="dulce"></div>
      <div class="tema" data-ths="paz"></div>
      <div class="tema mtha" data-ths="oro"></div>
      <div class="tema" data-ths="mora"></div>
      <div class="tema" data-ths="futuro"></div>
    </div>

    <!-- Script Interactivo de Selección de Temas (Optimizado al final del Body) -->
    <script>
      import { witema, wiSmart } from '../lib/widev/widev.js';
      import { dtema } from '../wii.js';
      wiSmart({});
      witema(dtema); 
      window.addEventListener('storage', (e) => { if (e.key === 'wiSmile' && !e.newValue) { window.location.replace('/'); } }); //Cerrar session pro
    </script>
  </body>
</html>
