---
// src/pages/en/smile.astro
import Layout from '../../layouts/Layout.astro';
import SmilePage from '../../lib/usuarios/smile/smilePage.astro';
import { app } from '../../wii.js';
import estilosSmile from '../../lib/usuarios/smile/smile.css?inline';
---

<Layout title="Dashboard" name={app} robots="noindex, nofollow">
  <!-- ⚡ Guardia y estilos inyectados en el head -->
  <script is:inline slot="head">localStorage.wiSmile||location.replace('/')</script>
  <style is:global set:html={estilosSmile} slot="head"></style>
  
  <SmilePage />
</Layout>
