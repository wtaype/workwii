---
// src/pages/en/nuevo.astro
import Layout from '../../layouts/Layout.astro';
import NuevoPage from '../../lib/todos/blog/nuevo/nuevoPage.astro';
import { app } from '../../wii.js';
import estilosSlug from '../../lib/todos/blog/slug/slug.css?inline';
import estilosContenido from '../../lib/todos/blog/contenido.css?inline';
import estilosNuevo from '../../lib/todos/blog/nuevo/nuevo.css?inline';
---

<Layout title="Article Creator — Admin" name={app} robots="noindex, nofollow">
  <!-- ⚡ Guardia y estilos inyectados en el head -->
  <script is:inline slot="head">localStorage.wiSmile||location.replace('/')</script>
  <style is:global set:html={estilosSlug + estilosContenido + estilosNuevo} slot="head"></style>
  
  <NuevoPage />
</Layout>
