---
// src/pages/en/[slug].astro
// English Blog Post Routing Wrapper

import { supabase } from '../../lib/supabase.js';
import Layout from '../../layouts/Layout.astro';
import SlugPage from '../../lib/todos/blog/slug/slugPage.astro';

export async function getStaticPaths() {
  try {
    const { data: allPosts, error } = await supabase
      .from('blog')
      .select('id, slug, activo, lang, "traduccionId", titulo, descripcion, categoria, imagen, imagenTop, tags, vistas, likes, lecturaTM, pin, usuario, autor, email, userId, creado, actualizado, metaSEO, contenido')
      .eq('activo', true)
      .order('creado', { ascending: false });

    if (error) throw error;

    if (!allPosts || !allPosts.length) {
      return [{
        params: { slug: 'sample-article-with-more-than-11-characters' },
        props: { post: {} as any, related: [] as any[], latest: [] as any[], prevPost: null as any, nextPost: null as any, translationSlug: null }
      }];
    }

    // Filtrar posts en inglés
    const posts = allPosts.filter((p: any) => p.lang === 'en');

    return posts.map((post: any, index: number) => {
      const related = posts.filter((p: any) => p.categoria === post.categoria && p.slug !== post.slug).slice(0, 3);
      const latest  = posts.filter((p: any) => p.slug !== post.slug).slice(0, 5);
      
      // Encontrar traducción vinculada (Español)
      const partner = allPosts.find((p: any) => (p.lang === 'es' || !p.lang) && (p.id === post.traduccionId || p.traduccionId === post.id));
      const translationSlug = partner ? partner.slug : null;

      return {
        params: { slug: post.slug },
        props: { post, related, latest, prevPost: posts[index + 1] || null, nextPost: posts[index - 1] || null, translationSlug }
      };
    }) as any;
  } catch (err) {
    console.error('[getStaticPaths en]', err);
    return [{
      params: { slug: 'sample-article-with-more-than-11-characters' },
      props: { post: {} as any, related: [] as any[], latest: [] as any[], prevPost: null as any, nextPost: null as any, translationSlug: null }
    }];
  }
}

interface Props {
  post: any;
  related: any[];
  latest: any[];
  prevPost: any;
  nextPost: any;
  translationSlug: string | null;
}

const { post, related, latest, prevPost, nextPost, translationSlug } = Astro.props;

const seoMeta = typeof post.metaSEO === 'string' ? JSON.parse(post.metaSEO) : (post.metaSEO || {});
const keywords = seoMeta.keywords || '';
---

<Layout
  title={post.titulo}
  description={post.descripcion}
  keywords={keywords}
  path={`/en/${post.slug || post.id}`}
  image={post.imagenTop || post.imagen || '/poster.webp'}
  type="article"
>
  <SlugPage post={post} related={related} latest={latest} prevPost={prevPost} nextPost={nextPost} translationSlug={translationSlug} lang="en" />
</Layout>
