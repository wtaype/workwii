      color: var(--tx3);
    }

    /* Checkbox interactivo */
    .rec_checkbox_wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 0.4vh;
    }
    .rec_checkbox {
      width: 20px;
      height: 20px;
      border-radius: 6px;
      border: 2px solid var(--brd2);
