    <!-- RESULTADOS DETALLADOS -->
    <section class="ats_results" id="atsResults">
      <div class="ats_dashboard_split">
        
        <!-- COLUMNA IZQUIERDA: SCORE & BREAKDOWN (STICKY) -->
        <div class="ats_dash_left">
          
          <!-- Círculo de puntuación circular -->
          <div class="ats_card ats_gauge_card">
            <h3 class="ats_card_tit ats_gauge_tit"><i class="fas fa-chart-line"></i> Compatibilidad ATS</h3>
            <div class="ats_gauge_wrap">
              <div class="ats_gauge_glow_center"></div>
              <svg class="ats_gauge" viewBox="0 0 100 100">
                <circle class="ats_gauge_bg" cx="50" cy="50" r="45"></circle>
                <circle class="ats_gauge_fill" cx="50" cy="50" r="45" id="gaugeCircle"></circle>
              </svg>
              <div class="ats_gauge_text">
                <span class="ats_gauge_num" id="gaugeNum">0%</span>
                <span class="ats_gauge_lbl">ATS Match</span>
              </div>
            </div>
            <span class="ats_status_badge" id="gaugeStatus">Excelente Match</span>

            <!-- Banda de contexto del score -->
            <div id="scoreContextBand" class="score_context_band band_good">ÉListo para postular!</div>

            <!-- Stat chips -->
            <div class="stat_chips_row" id="statChips">
              <span class="stat_chip"><i class="fas fa-file-lines"></i> 1 página</span>
              <span class="stat_chip"><i class="fas fa-align-left"></i> 0 palabras</span>
              <span class="stat_chip"><i class="fas fa-layer-group"></i> 0/6 secciones</span>
            </div>

            <!-- Semáforo de legibilidad ATS -->
            <div id="atsSemaforo" class="ats_semaforo sem_ok">
              <span class="sem_dot"></span>
              <span>Verificando legibilidad...</span>
            </div>
          </div>

          <!-- Desglose Analítico (Breakdown) -->
          <div class="ats_card ats_breakdown_card">
            <h3 class="ats_card_tit ats_breakdown_tit"><i class="fas fa-list-check"></i> Desglose de Análisis</h3>
            <div class="ats_breakdown_items">
              <div class="breakdown_item">
                <div class="breakdown_header">
                  <span><i class="far fa-address-card breakdown_icon"></i> Información de Contacto</span>
                  <span id="scoreContact">0%</span>
                </div>
                <div class="breakdown_bar_bg">
                  <div class="breakdown_bar_fill" id="barContact"></div>
                </div>
              </div>
              <div class="breakdown_item">
                <div class="breakdown_header">
                  <span><i class="fas fa-briefcase breakdown_icon"></i> Historial de Experiencia</span>
                  <span id="scoreExperience">0%</span>
                </div>
                <div class="breakdown_bar_bg">
                  <div class="breakdown_bar_fill" id="barExperience"></div>
                </div>
              </div>
              <div class="breakdown_item">
                <div class="breakdown_header">
                  <span><i class="fas fa-graduation-cap breakdown_icon"></i> Nivel de Educación</span>
                  <span id="scoreEducation">0%</span>
                </div>
                <div class="breakdown_bar_bg">
                  <div class="breakdown_bar_fill" id="barEducation"></div>
                </div>
              </div>
              <div class="breakdown_item">
                <div class="breakdown_header">
                  <span><i class="fas fa-award breakdown_icon"></i> Habilidades Clave</span>
                  <span id="scoreSkills">0%</span>
                </div>
                <div class="breakdown_bar_bg">
                  <div class="breakdown_bar_fill" id="barSkills"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Benchmark comparativo -->
          <div class="ats_card">
            <h3 class="ats_card_tit" style="font-size:var(--fz_m1);"><i class="fas fa-chart-bar"></i> ¿Cómo te comparas?</h3>
            <div id="benchmarkCard"></div>
          </div>

        </div>

        <!-- COLUMNA DERECHA: CENTRO DE ANÁLISIS DE PESTAÑAS -->
        <div class="ats_dash_right">
          
          <!-- Pestañas Pills del Dashboard (3 tabs: Resumen+KW unificado, Plan, Formato) -->
          <div class="ats_dashboard_tabs">
            <button class="ats_dash_tab active" data-dash-tab="resumen">
              <i class="fas fa-circle-info"></i> Diagnóstico
            </button>
            <button class="ats_dash_tab" data-dash-tab="plan">
              <i class="fas fa-clipboard-list"></i> Plan de Acción
            </button>
            <button class="ats_dash_tab" data-dash-tab="formato">
              <i class="fas fa-robot"></i> Formato ATS
            </button>
          </div>

          <!-- CONTENIDO DE PESTAÑAS -->
          <div class="ats_dashboard_tab_content">
            
            <!-- PESTAÑA 1: DIAGNÓSTICO PREMIUM -->
            <div class="ats_dash_pane active" id="paneResumen">

              <!-- Resumen ejecutivo -->
              <div class="ats_card ats_feedback_card">
                <h3 class="ats_feedback_title">Análisis de Compatibilidad</h3>
                <p class="ats_feedback_text" id="resultSummary">Evaluando tu currículum con Inteligencia Artificial...</p>
              </div>

              <!-- Perfil detectado por el ATS -->
              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-id-card"></i> Lo que el ATS &quot;vio&quot; en tu CV</h3>
                <p class="ats_tab_desc">Así interpreta el software de reclutamiento la información de tu currículum:</p>
                <div id="detectedProfileCard" style="display:flex;flex-direction:column;gap:1vh;"></div>
              </div>

              <!-- Calidad del lenguaje -->
              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-pen-fancy"></i> Calidad del Lenguaje</h3>
                <p class="ats_tab_desc">Verbos de acción, logros cuantificados y densidad de keywords en tu CV:</p>
                <div id="languageQualityCard"></div>
              </div>

              <!-- Keywords -->
              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-tags"></i> Palabras Clave (Keywords)</h3>
                <p class="ats_tab_desc">Los algoritmos ATS buscan coincidencia de términos exactos. Añade las palabras clave faltantes para mejorar tu score.</p>
                <div class="ats_keyword_grid">
                  <div class="ats_kw_group matched">
                    <h4><i class="fas fa-check-circle"></i> Detectadas en tu CV</h4>
                    <div class="ats_badge_container" id="matchedKeywordsContainer"></div>
                  </div>
                  <div class="ats_kw_group missing">
                    <h4><i class="fas fa-exclamation-triangle"></i> Debes agregar</h4>
                    <div class="ats_badge_container" id="missingKeywordsContainer"></div>
                  </div>
                </div>
              </div>

              <!-- Tips contextuales según score -->
              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-lightbulb"></i> Recomendaciones Rápidas</h3>
                <div id="scoreTipsContainer"></div>
              </div>

            </div>

            <!-- PESTAÑA 3: PLAN DE ACCIÓN -->
            <div class="ats_dash_pane" id="panePlan">
              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-list-check"></i> Plan de Acción y Cambios Sugeridos</h3>
                <p class="ats_tab_desc">A continuación se detalla la lista de cambios prioritarios que debes realizar en tu CV para superar con éxito la prueba del robot. Puedes marcar las tareas que vayas completando.</p>
                
                <!-- Progreso del plan de acción -->
                <div class="plan_progress_wrap" id="planProgressWrap">
                  <div class="plan_progress_header">
                    <span>Progreso de Optimización</span>
                    <span id="planProgressPercent">0%</span>
                  </div>
                  <div class="plan_progress_bar_bg">
                    <div id="planProgressBar"></div>
                  </div>
                  <span id="planProgressText">Has completado 0 de 0 mejoras recomendadas.</span>
                </div>

                <div class="ats_rec_list" id="recommendationsContainer"></div>
              </div>
            </div>

            <!-- PESTAÑA 4: FORMATO ATS (AUDITORÍA COMPLETA) -->
            <div class="ats_dash_pane" id="paneFormato">
              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-robot"></i> Auditoría de Formato de Lectura ATS</h3>
                <p class="ats_tab_desc_lg">Evaluamos la legibilidad de tu currículum frente a los criterios y limitaciones de procesamiento típicos de los softwares de reclutamiento automático.</p>
                
                <div class="ats_audit_list" id="atsAuditList">
                  <!-- Se cargan dinámicamente las tarjetas de auditoría por categoría -->
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- FILA DE ACCIONES (debajo del split, ancho completo) -->
      <div class="ats_action_row">
        <button class="ats_btn ats_btn_optimize" id="btnOptimizeEditor">
          <i class="fas fa-wand-magic-sparkles"></i> Corregir y Optimizar con IA
        </button>
        <button class="ats_btn_sec" id="btnBack">
          <i class="fas fa-arrow-left"></i> Nuevo Análisis
        </button>
        <button class="ats_btn_sec" id="btnCopyReport" title="Copiar informe al portapapeles">
          <i class="fas fa-copy"></i> Copiar Guía
        </button>
      </div>

    </section>

  </div>
</Layout>

<script>
  import { wiRateLimit, Notificacion } from '../lib/widev.js';
  import { initEntrada, getCvData, getJobDescription, resetEntrada } from '../lib/analisar/entrada.js';
  import { analizarCvConGemini } from '../lib/analisar/analisis.js';
  import { initResultado, startLoader, finishLoader, displayResults, copyActionPlan, resetResults } from '../lib/analisar/resultado.js';

  let btnAnalyze: HTMLButtonElement | null = null;

  const init = async () => {
    btnAnalyze = document.getElementById('btnAnalyze') as HTMLButtonElement;

    initEntrada(validateForm);
    initResultado();

    btnAnalyze?.addEventListener('click', startAnalysis);
    document.getElementById('btnBack')?.addEventListener('click', resetWorkspace);
    document.getElementById('btnCopyReport')?.addEventListener('click', copyActionPlan);
  };

  const validateForm = (isValid: boolean) => {
    if (btnAnalyze) btnAnalyze.disabled = !isValid;
  };

  const startAnalysis = async () => {
    const isLogged = localStorage.getItem('wiSmile');
    let rate = null;

    if (!isLogged) {
      rate = wiRateLimit('guest_ats_cv_analysis', 5, 315360000000 as any);
      if (!rate.ok) {
        Notificacion('Has alcanzado el límite de 5 usos de prueba. Regístrate gratis para continuar sin límites.', 'warning', 6000);
        const { abrirLogin } = await import('../lib/login.js');
        abrirLogin('registrar');
        return;
      }
    } else {
      // Validar límite diario para registrados (Anti-Abuso)
      rate = wiRateLimit('ats_cv_analysis', 5, 'dia');
      if (!rate.ok) {
        Notificacion(`Límite diario alcanzado (5 análisis). Intenta nuevamente en ${rate.min} minutos.`, 'warning', 5000);
        return;
      }
    }

    // ── Stepper premium loader ────────────────────────────────────────────
    const loaderHandles = startLoader();

    try {
      const cvInfo = getCvData();
      const jobDesc = getJobDescription();
      const targetRole = (document.getElementById('atsTargetRole') as HTMLInputElement)?.value || '';
      const targetLang = (document.getElementById('atsTargetLang') as HTMLSelectElement)?.value || 'es';

      const report = await analizarCvConGemini(cvInfo.data, jobDesc, cvInfo.type, targetRole, targetLang);
      rate.fail();

      finishLoader(loaderHandles);
      // Breve pausa para que el usuario vea el 100% completado
      await new Promise(r => setTimeout(r, 400));
      displayResults(report);

    } catch (err) {
      console.error(err);
      finishLoader(loaderHandles);
      Notificacion('No se pudo completar el análisis con la IA. Verifica tu conexión e intenta de nuevo.', 'error');
      resetWorkspace();
    }
  };

  const resetWorkspace = () => {
    resetResults();
    resetEntrada();
    const roleInput = document.getElementById('atsTargetRole') as HTMLInputElement;
    if (roleInput) roleInput.value = '';
    const langSelect = document.getElementById('atsTargetLang') as HTMLSelectElement;
    if (langSelect) langSelect.value = 'es';
    if (btnAnalyze) btnAnalyze.disabled = true;
  };

  // Inicializar hooks de Astro
  document.addEventListener('astro:page-load', init);
</script>