---
// src/pages/analisar.astro
import Layout from '../layouts/Layout.astro';
import { app } from '../wii.js';
import { seo } from '../lib/seo.js';
---

<Layout {...seo.analisar}>
  <style is:global>
    /* ==================== CONTENEDOR PRINCIPAL ==================== */
    .anal_ats {
      width: 100%;
      margin: 0 auto;
      padding: 3vh 1.5vh 6vh;
      display: flex;
      flex-direction: column;
      gap: 3.5vh;
      font-family: var(--ff_P);
    }

    /* ==================== CABECERA HÉROE (DISEÑO PREMIUM) ==================== */
    .ats_header {
      text-align: center;
      background: var(--wb);
      border: 1px solid var(--brd);
      border-radius: 2.2vh;
      padding: 4.5vh 3vh;
      box-shadow: var(--bs_l);
      position: relative;
      overflow: hidden;
    }
    .ats_header_glow {
      position: absolute;
      top: -50%;
      left: -20%;
      width: 140%;
      height: 200%;
      background: radial-gradient(circle, color-mix(in srgb, var(--mco) 8%, transparent) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }
    .ats_header_content {
      position: relative;
      z-index: 1;
    }
    .ats_header h1 {
      font-size: var(--fz_l2);
      font-weight: 850;
      color: var(--tx1);
      margin-bottom: 1.2vh;
      letter-spacing: -0.8px;
    }
    .ats_header h1 span {
      background: linear-gradient(135deg, var(--mco), var(--hva));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .ats_header p {
      font-size: var(--fz_m2);
      color: var(--tx3);
      max-width: 750px;
      margin: 0 auto;
      line-height: 1.6;
      font-weight: 500;
    }

    /* ==================== GRID DE TRABAJO ==================== */
    .ats_grid {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 3.5vh;
      align-items: start;
    }
    
    .ats_card {
      background: color-mix(in srgb, var(--wb) 88%, transparent);
      backdrop-filter: blur(10px);
      border: 1px solid var(--brd);
      border-radius: 2.2vh;
      padding: 4vh;
      box-shadow: var(--bs_l);
      display: flex;
      flex-direction: column;
      gap: 2.5vh;
      transition: border-color var(--tr_m), box-shadow var(--tr_m), transform var(--tr_m);
    }
    .ats_card:hover {
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
    }

    .ats_card_tit {
      font-size: var(--fz_m3);
      font-weight: 800;
      color: var(--tx1);
      display: flex;
      align-items: center;
      gap: 1.2vh;
      border-bottom: 2px solid var(--bg4);
      padding-bottom: 1.8vh;
      margin-bottom: 0.5vh;
      letter-spacing: -0.3px;
    }
    .ats_card_tit i {
      color: var(--mco);
    }

    /* ==================== SELECTOR DE PESTAÑAS (PILLS) ==================== */
    .ats_tabs {
      display: flex;
      gap: 0.8vh;
      background: var(--bg);
      padding: 0.6vh;
      border-radius: 1.2vh;
      border: 1px solid var(--brd);
    }
    .ats_tab {
      flex: 1;
      padding: 1.4vh;
      text-align: center;
      border-radius: 1vh;
      font-size: var(--fz_m1);
      font-weight: 700;
      color: var(--tx3);
      cursor: pointer;
      transition: all var(--tr_f) ease;
      background: none;
      border: none;
    }
    .ats_tab.active {
      background: var(--mco);
      color: var(--txa);
      box-shadow: 0 4px 10px color-mix(in srgb, var(--mco) 20%, transparent);
    }
    .ats_tab:hover:not(.active) {
      color: var(--tx1);
      background: var(--bg4);
    }

    /* ==================== ZONA DE ARRASTRE (DROPZONE) ==================== */
    .ats_dropzone {
      border: 2px dashed var(--brd);
      border-radius: 1.8vh;
      padding: 6vh 4vh;
      text-align: center;
      background: var(--bg);
      cursor: pointer;
      transition: all var(--tr_m) ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.8vh;
    }
    .ats_dropzone.dragover {
      border-color: var(--mco);
      background: var(--bg4);
      box-shadow: 0 0 20px color-mix(in srgb, var(--mco) 15%, transparent);
      transform: scale(1.02);
    }
    .ats_dropzone i {
      font-size: 6vh;
      color: var(--mco);
      opacity: 0.9;
      transition: transform var(--tr_m);
    }
    .ats_dropzone:hover i {
      transform: translateY(-0.8vh) scale(1.05);
    }
    .ats_dz_tit {
      font-size: var(--fz_m2);
      font-weight: 800;
      color: var(--tx1);
    }
    .ats_dz_sub {
      font-size: var(--fz_s3);
      color: var(--tx3);
      font-weight: 500;
    }

    /* Previsualización del archivo */
    .file_preview {
      display: flex;
      align-items: center;
      gap: 2vh;
      background: var(--bg);
      border: 1px solid var(--brd);
      border-radius: 1.5vh;
      padding: 2vh 2.5vh;
      margin-top: 0.5vh;
    }
    .file_preview i.file_icon {
      font-size: 4vh;
      color: var(--mco);
    }
    .file_info {
      flex: 1;
      min-width: 0;
    }
    .file_name {
      font-size: var(--fz_m1);
      font-weight: 700;
      color: var(--tx1);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .file_size {
      font-size: var(--fz_s2);
      color: var(--tx3);
      font-weight: 600;
      margin-top: 0.3vh;
    }
    .file_remove {
      background: var(--bg5);
      color: var(--error);
      border: none;
      border-radius: 50%;
      width: 4vh;
      height: 4vh;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: var(--fz_m2);
      transition: all var(--tr_f);
    }
    .file_remove:hover {
      background: var(--error);
      color: var(--white);
      transform: scale(1.1);
    }

    /* Formularios */
    .ats_card label {
      font-size: var(--fz_m1);
      color: var(--tx1);
      font-weight: 700;
      margin-bottom: 0.2vh;
      text-align: center;
    }
    .ats_textarea {
      width: 100%;
      min-height: 28vh;
      background: var(--bg);
      border: 2px solid var(--bg4);
      border-radius: 1.5vh;
      padding: 2.2vh;
      color: var(--tx);
      font-size: var(--fz_m1);
      line-height: 1.7;
      transition: all var(--tr_m) ease;
    }
    .ats_textarea:focus {
      border-color: var(--mco);
      background: var(--wb);
      box-shadow: 0 0 10px var(--bg4);
    }

    .ats_input, .ats_select {
      padding: 1.8vh;
      border: 1px solid var(--brd);
      border-radius: 12px;
      background: var(--bg);
      color: var(--tx);
      font-family: inherit;
      font-size: var(--fz_m1);
      transition: all var(--tr_m) ease;
    }
    .ats_input:focus, .ats_select:focus {
      border-color: var(--mco);
      background: var(--wb);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--mco) 15%, transparent);
      outline: none;
    }
    .ats_select {
      appearance: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23666666' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
      background-repeat: no-repeat;
      background-position: right 1.5vh center;
      background-size: 1.2rem;
      padding-right: 4.5vh;
    }
    #filePreviewContainer{
      justify-content: center;
      
    }
    .char_counter {
      align-self: flex-end;
      font-size: var(--fz_s2);
      color: var(--tx3);
      margin-top: -1vh;
      font-weight: 600;
    }

    /* Botón de Acción */
    .ats_btn {
      padding: 2.2vh;
      background: var(--mco);
      color: var(--txa);
      border: none;
      border-radius: 1.5vh;
      font-size: var(--fz_m2);
      font-weight: 800;
      cursor: pointer;
      transition: all var(--tr_m) ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.2vh;
      box-shadow: 0 6px 20px color-mix(in srgb, var(--mco) 25%, transparent);
    }
    .ats_btn:hover:not(:disabled) {
      transform: translateY(-0.4vh);
      filter: brightness(1.08);
      box-shadow: 0 10px 25px color-mix(in srgb, var(--mco) 40%, transparent);
    }
    .ats_btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    /* ==================== PANTALLA DE CARGA PREMIUM (STEPPER) ==================== */
    .ats_loader {
      display: none;
      flex-direction: column;
      gap: 3vh;
      padding: 5vh 4vh;
    }
    .loader_title {
      font-size: var(--fz_m5);
      font-weight: 850;
      color: var(--tx1);
      letter-spacing: -0.5px;
      text-align: center;
    }
    .loader_eta {
      font-size: var(--fz_s3);
      color: var(--tx3);
      font-weight: 600;
      text-align: center;
      margin-top: -1.5vh;
    }

    /* Barra de progreso del loader */
    .loader_bar_wrap {
      display: flex;
      flex-direction: column;
      gap: 0.8vh;
    }
    .loader_bar_header {
      display: flex;
      justify-content: space-between;
      font-size: var(--fz_s3);
      font-weight: 700;
      color: var(--tx2);
    }
    .loader_bar_bg {
      width: 100%;
      height: 1.4vh;
      background: var(--bg4);
      border-radius: 99px;
      overflow: hidden;
      border: 1px solid var(--brd);
    }
    .loader_bar_fill {
      width: 0%;
      height: 100%;
      border-radius: 99px;
      background: linear-gradient(90deg, var(--mco), var(--hva));
      transition: width 0.25s ease;
      position: relative;
      overflow: hidden;
    }
    .loader_bar_fill::after {
      content: '';
      position: absolute;
      top: 0; left: -100%; width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      animation: bar_shimmer 1.8s infinite linear;
    }

    /* Pasos del stepper */
    #loaderStepper {
      display: flex;
      flex-direction: column;
      gap: 1.2vh;
    }
    .loader_step {
      display: flex;
      align-items: center;
      gap: 2vh;
      padding: 1.5vh 2vh;
      border-radius: 1.4vh;
      border: 1px solid var(--brd);
      background: var(--bg);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      opacity: 0.5;
    }
    .loader_step.active {
      border-color: var(--mco);
      background: color-mix(in srgb, var(--mco) 4%, var(--wb));
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--mco) 12%, transparent);
      opacity: 1;
    }
    .loader_step.done {
      border-color: var(--success);
      background: color-mix(in srgb, var(--success) 4%, var(--wb));
      opacity: 0.75;
    }
    .loader_step_icon {
      width: 4vh;
      height: 4vh;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--fz_m2);
      background: var(--bg4);
      color: var(--tx3);
      flex-shrink: 0;
      transition: all 0.4s ease;
    }
    .loader_step.active .loader_step_icon {
      background: var(--mco);
      color: var(--txa);
      animation: icon_pulse 1.5s infinite ease-in-out;
    }
    .loader_step.done .loader_step_icon {
      background: var(--success);
      color: #fff;
    }
    @keyframes icon_pulse {
      0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--mco) 30%, transparent); }
      50% { box-shadow: 0 0 0 6px transparent; }
    }
    .loader_step_body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.3vh;
    }
    .loader_step_label {
      font-size: var(--fz_m1);
      font-weight: 700;
      color: var(--tx1);
    }
    .loader_step_sub {
      font-size: var(--fz_s2);
      color: var(--tx3);
      font-weight: 500;
    }
    .loader_step_check {
      font-size: var(--fz_m1);
      color: var(--success);
      opacity: 0;
      transition: opacity 0.3s;
    }
    .loader_step.done .loader_step_check { opacity: 1; }
    .loader_step.active .loader_step_label { color: var(--mco); }

    /* Tip rotativo */
    .loader_tip_wrap {
      display: flex;
      align-items: start;
      gap: 1.5vh;
      background: var(--bg4);
      border: 1px solid var(--brd);
      border-radius: 1.5vh;
      padding: 2vh 2.5vh;
    }
    #loaderTipContent {
      display: flex;
      align-items: start;
      gap: 1.5vh;
      font-size: var(--fz_m1);
      color: var(--tx2);
      font-weight: 500;
      line-height: 1.6;
      transition: opacity 0.3s ease;
    }
    .loader_tip_label {
      font-size: var(--fz_s3);
      font-weight: 800;
      color: var(--mco);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      flex-shrink: 0;
      margin-top: 0.2vh;
    }

    /* ==================== PANEL DE RESULTADOS (ATS DASHBOARD SPLIT) ==================== */
    .ats_results {
      display: none;
      flex-direction: column;
      gap: 4vh;
    }

    .ats_dashboard_split {
      display: grid;
      grid-template-columns: 350px 1fr;
      gap: 3.5vh;
      align-items: start;
    }

    .ats_dash_left {
      position: sticky;
      top: 3vh;
      display: flex;
      flex-direction: column;
      gap: 2.5vh;
    }

    .ats_dash_right {
      display: flex;
      flex-direction: column;
      gap: 2.5vh;
      min-width: 0;
    }

    /* Ocultar cabecera cuando se muestran resultados */
    .ats_header_hidden {
      display: none !important;
    }

    /* Fila de acciones debajo del split */
    .ats_action_row {
      display: flex;
      gap: 1.5vh;
      align-items: center;
    }
    .ats_action_row .ats_btn_optimize {
      flex: 2;
    }
    .ats_action_row .ats_btn_sec {
      flex: 1;
      justify-content: center;
    }

    /* Tarjeta de Score circular */
    .ats_gauge_card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4vh 3vh;
    }
    .ats_gauge_wrap {
      position: relative;
      width: 170px;
      height: 170px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 2.5vh;
    }
    .ats_gauge_glow_center {
      position: absolute;
      width: 130px;
      height: 130px;
      border-radius: 50%;
      background: radial-gradient(circle, color-mix(in srgb, var(--mco) 8%, transparent) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
      animation: gauge_glow_pulse 3s infinite ease-in-out;
    }
    @keyframes gauge_glow_pulse {
      0% { transform: scale(0.95); opacity: 0.7; }
      50% { transform: scale(1.05); opacity: 1; }
      100% { transform: scale(0.95); opacity: 0.7; }
    }
    .ats_gauge {
      transform: rotate(-90deg);
      width: 100%;
      height: 100%;
      position: relative;
      z-index: 1;
    }
    .ats_gauge_bg {
      fill: none;
      stroke: var(--bg4);
      stroke-width: 8;
    }
    .ats_gauge_fill {
      fill: none;
      stroke: var(--mco);
      stroke-width: 8;
      stroke-linecap: round;
      stroke-dasharray: 283;
      stroke-dashoffset: 283;
      transition: stroke-dashoffset 2s cubic-bezier(0.25, 0.46, 0.45, 0.94), stroke 0.6s ease;
      filter: drop-shadow(0 0 5px color-mix(in srgb, var(--mco) 45%, transparent));
    }
    .ats_gauge_text {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: var(--ff_O);
    }
    .ats_gauge_num {
      font-size: var(--fz_l1);
      font-weight: 900;
      color: var(--tx1);
      letter-spacing: -1px;
    }
    .ats_gauge_lbl {
      font-size: var(--fz_s4);
      color: var(--tx3);
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 0.8px;
      margin-top: -0.3vh;
    }

    /* Badge de estado */
    .ats_status_badge {
      display: inline-flex;
      align-items: center;
      gap: 0.8vh;
      padding: 0.8vh 2vh;
      border-radius: 5vh;
      font-size: var(--fz_s3);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .ats_status_critico  { background: rgba(255, 56, 73, 0.12);  color: var(--error);   border: 1px solid rgba(255, 56, 73, 0.25);  }
    .ats_status_aceptable{ background: rgba(255,167, 38, 0.12);  color: var(--warning); border: 1px solid rgba(255,167, 38, 0.25); }
    .ats_status_excelente{ background: rgba( 60,215, 65, 0.12);  color: var(--success); border: 1px solid rgba( 60,215, 65, 0.25); }

    /* Banda de contexto del score */
    .score_context_band {
      font-size: var(--fz_s3);
      font-weight: 700;
      padding: 0.8vh 1.8vh;
      border-radius: 1vh;
      text-align: center;
      width: 100%;
    }
    .band_excellent { background: rgba(60,215,65,0.1);  color: var(--success); border: 1px solid rgba(60,215,65,0.2); }
    .band_good      { background: rgba(60,215,65,0.07); color: var(--success); border: 1px solid rgba(60,215,65,0.15); }
    .band_medium    { background: rgba(255,167,38,0.1); color: var(--warning); border: 1px solid rgba(255,167,38,0.2); }
    .band_critical  { background: rgba(255,56,73,0.1);  color: var(--error);   border: 1px solid rgba(255,56,73,0.2);  }

    /* Stat chips */
    .stat_chips_row {
      display: flex;
      gap: 0.8vh;
      flex-wrap: wrap;
      justify-content: center;
    }
    .stat_chip {
      display: inline-flex;
      align-items: center;
      gap: 0.6vh;
      padding: 0.6vh 1.4vh;
      background: var(--bg4);
      border: 1px solid var(--brd);
      border-radius: 5vh;
      font-size: var(--fz_s3);
      font-weight: 700;
      color: var(--tx2);
    }
    .stat_chip i { color: var(--mco); }

    /* Semáforo de legibilidad ATS */
    .ats_semaforo {
      display: flex;
      align-items: center;
      gap: 1vh;
      padding: 1.2vh 2vh;
      border-radius: 1vh;
      font-size: var(--fz_s3);
      font-weight: 700;
      width: 100%;
      justify-content: center;
    }
    .sem_ok    { background: rgba(60,215,65,0.08);  color: var(--success); border: 1px solid rgba(60,215,65,0.2); }
    .sem_error { background: rgba(255,56,73,0.08);  color: var(--error);   border: 1px solid rgba(255,56,73,0.2); }
    .sem_dot {
      width: 10px; height: 10px;
      border-radius: 50%;
      background: currentColor;
      animation: sem_blink 1.5s infinite;
    }
    @keyframes sem_blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }

    /* Benchmark comparativo */
    .bch_row {
      display: flex;
      align-items: center;
      gap: 1.2vh;
      padding: 1.2vh 0;
      border-bottom: 1px solid var(--bg4);
      font-size: var(--fz_s3);
      flex-wrap: wrap;
    }
    .bch_row:last-child { border-bottom: none; }
    .bch_label { flex: 1; display: flex; align-items: center; gap: 0.8vh; color: var(--tx2); font-weight: 600; }
    .bch_label i { color: var(--mco); }
    .bch_val  { font-family: var(--ff_O); font-weight: 800; font-size: var(--fz_m2); color: var(--tx1); min-width: 3.5rem; text-align: right; }
    .bch_up   { color: var(--success); font-weight: 700; font-size: var(--fz_s3); }
    .bch_down { color: var(--error);   font-weight: 700; font-size: var(--fz_s3); }
    .bch_neutral { color: var(--mco);  font-weight: 700; font-size: var(--fz_s3); }
    .bch_threshold .bch_label i { color: var(--warning); }

    /* Perfil detectado — datos reales del CV */
    .profile_row {
      display: flex;
      align-items: center;
      gap: 1.5vh;
      padding: 1.4vh 1.8vh;
      border-radius: 1.4vh;
      border: 1px solid var(--brd);
      background: var(--bg);
      cursor: default;
      transition: border-color var(--tr_f), background var(--tr_f);
    }
    .profile_row:hover {
      background: color-mix(in srgb, var(--bg4) 60%, var(--wb));
    }
    .prow_icon {
      width: 3.8vh;
      height: 3.8vh;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--fz_m1);
      flex-shrink: 0;
    }
    .prow_ok  .prow_icon { background: rgba(60,215,65,0.12);  color: var(--success); }
    .prow_missing .prow_icon { background: rgba(255,56,73,0.1);   color: var(--error); }
    .prow_body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.2vh;
      min-width: 0;
    }
    .prow_label {
      font-size: var(--fz_s3);
      font-weight: 700;
      color: var(--tx3);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .prow_value {
