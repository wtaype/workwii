          <div class="ats_field flex_2">
            <label for="atsTargetRole">Puesto o Título Deseado</label>
            <input type="text" id="atsTargetRole" class="ats_input" placeholder="Ej: Desarrollador React, Diseñador UX..." />
          </div>
          <div class="ats_field flex_1">
            <label for="atsTargetLang">Idioma del Reporte</label>
            <select id="atsTargetLang" class="ats_select">
              <option value="es" selected>Español(Latinoamerica)</option>
              <option value="en">Inglés (English EEUU)</option>
            </select>
          </div>
        </div>

        <!-- Botón de Análisis -->
        <button id="btnAnalyze" class="ats_btn" disabled>
          <i class="fa-solid fa-wand-magic-sparkles"></i> Analizar Compatibilidad con IA
        </button>
      </div>

    </main>

    <!-- PANTALLA DE CARGA PREMIUM (STEPPER) -->
    <section class="ats_card ats_loader" id="atsLoader">
      <h3 class="loader_title"><i class="fas fa-brain" style="color:var(--mco);"></i> Analizando tu currículum con IA</h3>
      <p class="loader_eta" id="loaderEta">Analizando · ~15 segundos restantes</p>

      <!-- Barra de progreso -->
      <div class="loader_bar_wrap">
        <div class="loader_bar_header">
          <span>Progreso del análisis</span>
          <span id="loaderBarPct" style="color:var(--mco);font-family:var(--ff_O);font-weight:800;">0%</span>
        </div>
        <div class="loader_bar_bg">
          <div class="loader_bar_fill" id="loaderBarFill"></div>
        </div>
      </div>

      <!-- Stepper de 5 fases -->
      <div id="loaderStepper"></div>

      <!-- Tip rotativo -->
      <div class="loader_tip_wrap">
        <span class="loader_tip_label"><i class="fas fa-lightbulb"></i> Tip</span>
        <div id="loaderTipContent">Cargando consejo...</div>
      </div>
