      font-size: var(--fz_s4);
      font-weight: 700;
      color: var(--tx1);
    }

    /* ==================== GAUGE CARD HEADER ==================== */
    .ats_gauge_tit {
      margin-bottom: 2vh;
      border-bottom: none;
      padding-bottom: 0;
      font-size: var(--fz_m1);
