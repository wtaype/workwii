    }
    .val_error:focus {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--error) 15%, transparent) !important;
    }
    
    .conv_dropdown_item {
      background: none;
      border: none;
      color: var(--tx2);
      padding: 1.2vh 1.5vh;
      font-size: var(--fz_s2);
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
