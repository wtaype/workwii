    /* Animaciones generales */
    @keyframes conv_spin {
      to { transform: rotate(360deg); }
    }
    @keyframes conv_fade_in {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Fila paralela para Puesto e Idioma */
    .conv_row_fields {
      display: flex;
