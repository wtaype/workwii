        <!-- Barra de Herramientas -->
        <div class="conv_preview_tools">
          <div class="conv_preview_tools_left">
            <span><i class="fas fa-circle-check"></i> Vista Previa ATS</span>
            <button class="conv_tip_btn_icon" id="convPreviewTipFoto" title="Consejo de foto" data-witip="Esta plantilla está diseñada sin foto por defecto porque los filtros de contratación automáticos ATS en EE.UU. y Europa penalizan o no leen currículums con imágenes. Te recomendamos descargar el CV sin foto." data-wtipo="info" data-wtiempo="6000">
              <i class="fas fa-circle-info"></i>
            </button>
          </div>
          <div class="conv_preview_actions">
            <button class="conv_btn_sec" id="convBtnReset"><i class="fas fa-rotate-left"></i> Convertir otro</button>
            
            <div class="conv_download_dropdown">
              <button class="conv_btn" id="convBtnPrint"><i class="fas fa-download"></i> Descargar CV</button>
              <button class="conv_btn_dropdown_toggle" id="convBtnDownloadToggle" aria-haspopup="true" aria-expanded="false" title="Más formatos de descarga">
                <i class="fas fa-chevron-down"></i>
              </button>
              <div class="conv_dropdown_menu" id="convDownloadMenu">
                <button class="conv_dropdown_item" id="convBtnPrintNative"><i class="fas fa-print"></i> Imprimir PDF (Recomendado ATS)</button>
                <button class="conv_dropdown_item" id="convBtnDownloadPdfDirect"><i class="fas fa-file-pdf"></i> Descargar PDF (Exportación Directa)</button>
                <button class="conv_dropdown_item" id="convBtnDownloadDocx"><i class="fas fa-file-word"></i> Descargar Word (.docx)</button>
                <button class="conv_dropdown_item" id="convBtnDownloadTxt"><i class="fas fa-file-alt"></i> Descargar Texto (.txt)</button>
                <button class="conv_dropdown_item" id="convBtnDownloadMd"><i class="fab fa-markdown"></i> Descargar Markdown (.md)</button>
                <button class="conv_dropdown_item" id="convBtnDownloadJson"><i class="fas fa-file-code"></i> Respaldar datos (.json)</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Escritorio de Vista Previa -->
        <div class="conv_a4_wrapper">
          <div id="convPreviewA4">
            <!-- La hoja A4 se inyecta desde visual.js -->
          </div>
        </div>

      </section>
      
    </main>

  </div>
</Layout>

<script>
  import { initEntrada, removeFile } from '../lib/convertir/entrada.js';
  import { estructurarCvConIA } from '../lib/convertir/convertidor.js';
  import { initVisual } from '../lib/convertir/visual.js';
  import { Notificacion, wiRateLimit } from '../lib/widev.js';

  // Referencias a los pasos
  let step1: HTMLElement | null;
  let step2: HTMLElement | null;
  let step3: HTMLElement | null;
  
  let btnSubmit: HTMLButtonElement | null;
  let loaderMsg: HTMLElement | null;

  const init = () => {
    step1 = document.getElementById('convStep1');
    step2 = document.getElementById('convLoader');
    step3 = document.getElementById('convWorkspace');
    btnSubmit = document.getElementById('convBtnSubmit') as HTMLButtonElement;
    loaderMsg = document.getElementById('convLoaderMsg');

    // Inicializar lógica de lectura de archivos
    initEntrada(
      // Callback de extracción
      (text: string) => {
        const textareaContainer = document.getElementById('convTextareaContainer');
        if (textareaContainer) textareaContainer.style.display = 'flex';
        
        if (btnSubmit) {
          btnSubmit.disabled = !text.trim();
        }
      },
      // Callback de reset
      () => {
        const textareaContainer = document.getElementById('convTextareaContainer');
        if (textareaContainer) textareaContainer.style.display = 'none';
        if (btnSubmit) btnSubmit.disabled = true;
      }
    );

    // Eventos de botones
    btnSubmit?.addEventListener('click', procesarConversionConIA);
    document.getElementById('convBtnReset')?.addEventListener('click', reiniciarFlujo);

    // Cargar caché local de CV activo (F5) - Se ejecuta al final para que los event listeners ya estén registrados
    const activeKey = localStorage.getItem('convertir_ats_active_key');
    if (activeKey) {
      const cached = localStorage.getItem(activeKey);
      if (cached) {
        try {
          const parsed = JSON.parse(cached);
          if (step1) step1.style.display = 'none';
          if (step3) step3.style.display = 'grid';
          initVisual(parsed);
          return;
        } catch (e) {
          console.error('Error al cargar caché local:', e);
        }
      }
    }
  };

  const procesarConversionConIA = async () => {
    const rawTextarea = document.getElementById('convTextarea') as HTMLTextAreaElement;
    const targetRoleInp = document.getElementById('convTargetRole') as HTMLInputElement;

    if (!rawTextarea || !rawTextarea.value.trim()) {
      Notificacion('Por favor, ingresa el texto de tu currículum.', 'warning');
      return;
    }

    // Control de límite de uso contra abusos
    const isLogged = localStorage.getItem('wiSmile');
    let rate = null;

    if (!isLogged) {
      rate = wiRateLimit('guest_ats_cv_conversion', 5, 315360000000 as any);
      if (!rate.ok) {
        Notificacion('Has alcanzado el límite de 5 conversiones de prueba. Regístrate gratis para continuar sin límites.', 'warning', 6000);
        const { abrirLogin } = await import('../lib/login.js');
        abrirLogin('registrar');
        return;
      }
    } else {
      rate = wiRateLimit('ats_cv_conversion', 5, 'dia');
      if (!rate.ok) {
        Notificacion(`Límite diario alcanzado (5 conversiones). Regresa en ${rate.min} minutos.`, 'warning', 5000);
        return;
      }
    }

    // Transicionar al Paso 2: Loader
    if (step1) step1.style.display = 'none';
    if (step2) step2.style.display = 'flex';

    // Rotación de mensajes del cargador
    const messages = [
      'Leyendo estructura del CV...',
      'Estructurando datos en formato ATS estándar...',
      'Buscando secciones de experiencia...',
      'Optimizando logros con verbos de acción fuertes...',
      'Alineando habilidades técnicas...',
      'Asegurando legibilidad del formato para robots...'
    ];
    let msgIdx = 0;
    const timer = setInterval(() => {
      if (loaderMsg) {
        loaderMsg.textContent = messages[msgIdx];
        msgIdx = (msgIdx + 1) % messages.length;
      }
    }, 2000);

    try {
      const textToConvert = rawTextarea.value.trim();
      const targetRole = targetRoleInp ? targetRoleInp.value.trim() : '';
      const targetLangSelect = document.getElementById('convTargetLang') as HTMLSelectElement;
      const targetLang = targetLangSelect ? targetLangSelect.value : 'es';

      // Llamada a la IA de Workwii
      const structuredCv = await estructurarCvConIA(textToConvert, targetRole, targetLang);

      // Guardar en caché local persistente única
      const cacheKey = `convertir_ats_${Date.now()}`;
      localStorage.setItem(cacheKey, JSON.stringify(structuredCv));
      localStorage.setItem('convertir_ats_active_key', cacheKey);

      // Guardar el consumo exitoso en el navegador
      if (rate) rate.fail();

      clearInterval(timer);
      
      // Ocultar Loader
      if (step2) step2.style.display = 'none';

      // Inicializar y mostrar el Paso 3: Workspace
      if (step3) step3.style.display = 'grid';
      initVisual(structuredCv);

      Notificacion('¡CV estructurado y optimizado con éxito! Revisa la vista previa.', 'success', 4000);
    } catch (err: any) {
      console.error(err);
      clearInterval(timer);
      
      if (step2) step2.style.display = 'none';
      if (step1) step1.style.display = 'flex';
      
      Notificacion(err.message || 'No se pudo completar la estructuración con la IA.', 'error');
    }
  };

  const reiniciarFlujo = () => {
    // Limpiar caché activa
    localStorage.removeItem('convertir_ats_active_key');

    // Resetear archivos
    removeFile();
    
    // Limpiar input del puesto e idioma
    const targetRoleInp = document.getElementById('convTargetRole') as HTMLInputElement;
    if (targetRoleInp) targetRoleInp.value = '';

    const targetLangSelect = document.getElementById('convTargetLang') as HTMLSelectElement;
    if (targetLangSelect) targetLangSelect.value = 'es';

    // Volver a mostrar pantalla de subida
    if (step3) step3.style.display = 'none';
    if (step2) step2.style.display = 'none';
    if (step1) step1.style.display = 'flex';
  };

  // Escuchar Astro page-load hooks
  document.addEventListener('astro:page-load', init);
</script>