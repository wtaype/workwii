    /* ══════════════════ REGLAS DE IMPRESIÓN EXCLUSIVAS (PDF) ══════════════════ */
    @media print {
      @page {
        size: A4 portrait;
        margin: 0; /* Hides headers/footers completely */
      }
      body {
        background: #fff !important;
        color: #000 !important;
      }
      /* Ocultar elementos de la web */
      header, footer, nav, #notificationsContainer, #wiTema, .conv_header, .conv_left_pane, .conv_preview_tools {
        display: none !important;
      }
      /* Evitar saltos de página en medio de las experiencias o secciones */
      .cr_cv_section, .cr_cv_item {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      .conv_wrap {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
      }
      .conv_workspace_split {
        grid-template-columns: 1fr !important;
        gap: 0 !important;
        margin: 0 !important;
      }
      .conv_right_pane {
        position: static !important;
        width: 100% !important;
        top: 0 !important;
      }
      .conv_a4_wrapper {
        background: none !important;
        padding: 0 !important;
        border: none !important;
        box-shadow: none !important;
        overflow: visible !important;
      }
      .cr_cv_document {
        width: 21cm !important;
        height: 29.7cm !important;
        box-shadow: none !important;
        padding: 10mm 12mm !important;
        margin: 0 !important;
        background: #fff !important;
        background-image: none !important;
      }
      .cr_cv_page_next {
        page-break-before: always !important;
        break-before: page !important;
      }
    }
  </style>

  <div class="conv_wrap">
    
    <!-- Encabezado general -->
    <header class="conv_header">
      <h1>Convertidor de CV a <span>Formato ATS</span></h1>
      <p>Sube tu currículum en PDF o Word y nuestra IA lo optimizará y estructurará al instante para superar los filtros de selección.</p>
    </header>

    <!-- PASO 1: SUBIR / PEGAR -->
    <section class="conv_step_card" id="convStep1">
      <div class="conv_field">
        <label>Arrastra tu currículum existente</label>
        
        <!-- Dropzone de archivo -->
        <div class="conv_dropzone" id="convDropzone">
          <i class="fas fa-cloud-arrow-up"></i>
          <span class="conv_dz_tit">Arrastra tu archivo aquí o haz clic</span>
          <span class="conv_dz_sub">Admite formatos PDF y Word (.docx) — Máximo 4MB</span>
          <input type="file" id="convFileInput" accept=".pdf,.docx" class="dpn">
        </div>

        <!-- Progreso de lectura -->
        <div id="convProgressContainer" class="upload_progress_container">
          <div class="upload_progress_header">
            <span><i class="fas fa-spinner fa-spin"></i> Leyendo contenido...</span>
            <span id="convProgressPercent">0%</span>
          </div>
          <div class="upload_progress_bar_bg">
            <div id="convProgressBar" class="upload_progress_bar_fill"></div>
          </div>
        </div>

        <!-- Preview de archivo cargado -->
        <div id="convPreviewContainer" class="dpn"></div>
      </div>

      <!-- Textarea de revisión de texto extraído bruto -->
      <div class="conv_textarea_container" id="convTextareaContainer">
        <label for="convTextarea">Texto extraído del documento (Verifica o edita si es necesario):</label>
        <textarea id="convTextarea" class="conv_field conv_raw_textarea" placeholder="Aquí aparecerá el texto de tu currículum al subir el archivo..."></textarea>
      </div>

      <!-- Fila de Puesto Deseado e Idioma de Optimización -->
      <div class="conv_row_fields">
        <div class="conv_field flex_2">
          <label for="convTargetRole">Puesto o Área al que postulas (Opcional)</label>
          <input type="text" id="convTargetRole" placeholder="Ej: Desarrollador React, Especialista en Marketing, Asistente Administrativo" />
          <span class="conv_small_help">La IA orientará el vocabulario de tu CV hacia este rol específico.</span>
        </div>
        <div class="conv_field flex_1">
          <label for="convTargetLang">Idioma de optimización</label>
          <select id="convTargetLang" class="conv_select">
            <option value="es" selected>Español Latinoamericano</option>
            <option value="en">Inglés (English)</option>
          </select>
          <span class="conv_small_help">La IA traducirá y redactará todo tu CV en este idioma.</span>
        </div>
      </div>

      <!-- Botón de Envío -->
      <button class="conv_btn" id="convBtnSubmit" disabled>
        <i class="fas fa-wand-magic-sparkles"></i> Optimizar y Organizar con IA
      </button>
    </section>

    <!-- PASO 2: CARGANDO -->
    <section class="conv_loader" id="convLoader">
      <div class="conv_loader_spinner"></div>
      <h3 id="convLoaderMsg">Analizando currículum...</h3>
      <p>Nuestra Inteligencia Artificial está estructurando tu información y optimizando tus logros para superar los filtros de contratación. Esto tomará unos segundos.</p>
    </section>

    <!-- PASO 3: EDITAR Y PREVISUALIZAR (Split workspace) -->
    <main class="conv_workspace_split" id="convWorkspace">
      
      <!-- Panel Izquierdo: Formularios -->
      <section class="conv_left_pane">
        <!-- Navegación interna de pestañas -->
        <div class="conv_tabs_header" id="convTabsHeader">
          <!-- Renderizado dinámico desde visual.js -->
        </div>

        <!-- Contenido dinámico del formulario -->
        <form id="convFormContent" onsubmit="return false;">
          <!-- Renderizado dinámico desde visual.js -->
        </form>
