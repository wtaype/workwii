<script>
  import { protegerRuta } from '../lib/auth.js';
  import { initIA } from '../lib/crear/creando.js';
  import { initResultado, updatePreview, updateSteps } from '../lib/crear/resultado.js';
  import { initEntrada } from '../lib/crear/entrada.js';

  const init = async () => {
    // 1. Proteger ruta usando el guard centralizado de Supabase + localStorage
    const uLocal = await protegerRuta(['usuario', 'editor', 'gestor', 'admin']);
    if (!uLocal) return;

    // 2. Inicializar Módulos de Entrada
    initEntrada((cvData: any) => {
      // Callback cada vez que cambian datos (guardado en caché local)
      updatePreview(cvData);
    });

    // 3. Inicializar Módulos de Vista Previa y Pasos
    initResultado((step: number) => {
      // Callback opcional si deseamos registrar cambio de vista en el wizard
    });

    // 4. Inicializar modal y eventos de la Inteligencia Artificial
    initIA();

    // 5. Iniciar paso de visualización en el primer tab (Datos de Contacto)
    updateSteps(1);
  };

  document.addEventListener('astro:page-load', init);
</script>