---
// src/pages/crear.astro
// Creador de CV ATS interactivo con Optimización de IA (Gemini) y soporte de Supabase
import Layout from '../layouts/Layout.astro';
import { app } from '../wii.js';
import { seo } from '../lib/seo.js';
import estilos from '../lib/crear/crear.css?inline';
import Consejos from '../lib/crear/consejos.astro';
---

<Layout {...seo.crear}>
<style set:html={estilos}></style>

  <div class="conv_wrap">
    <!-- Header -->
    <header class="conv_header">
      <div class="cr_header_flex">
        <div class="cr_header_left">
          <h1><i class="fas fa-file-signature cr_header_icon"></i>Creador de CV <span>ATS Profesional</span></h1>
          <p class="cr_header_sub">Escribe y optimiza tu CV con inteligencia artificial para superar los algoritmos de selección.</p>
        </div>
        <div class="cr_header_right">
          <!-- Hidden file input for resume parser -->
          <input type="file" id="cr_header_cv_file" accept=".pdf,.docx" class="dpn" />
          
          <!-- Selector de idioma premium para subida -->
          <div class="cr_upload_lang_container" data-witip="Elige el idioma en el que deseas extraer y redactar tu currículum al subir el archivo antiguo.">
            <select id="cr_upload_lang" class="cr_upload_lang_select">
              <option value="es" selected>🇪🇸 Español Latino</option>
              <option value="en">🇺🇸 Inglés EEUU</option>
            </select>
            <i class="fas fa-chevron-down cr_upload_lang_arrow"></i>
          </div>
          
          <!-- Upload button -->
          <button id="cr_btn_upload_cv" class="conv_btn_sec cr_btn_upload_dash" data-witip="¿Tienes un CV antiguo? Súbelo en PDF o Word y rellenaremos los campos automáticamente. ¡Es opcional, pero te ahorrará mucho tiempo!">
            <i class="fas fa-magic"></i> Subir CV existente (Opcional)
          </button>
          
          <!-- New CV button -->
          <button id="cr_btn_reset_all" class="conv_btn_sec" data-witip="Esto borrará todo tu progreso actual en tu navegador para que puedas crear un currículum nuevo desde cero."><i class="fas fa-file-circle-plus"></i> Crear nuevo CV</button>
          
          <!-- Download dropdown -->
          <div class="conv_download_dropdown">
            <button class="conv_btn" id="cr_btn_download_final" data-witip="Descarga directa de tu currículum en formato PDF optimizado para ATS."><i class="fas fa-download"></i> Descargar CV</button>
            <button class="conv_btn_dropdown_toggle" id="crBtnDownloadToggle" aria-haspopup="true" aria-expanded="false" title="Más formatos de descarga">
              <i class="fas fa-chevron-down"></i>
            </button>
            <div class="conv_dropdown_menu" id="crDownloadMenu">
              <button class="conv_dropdown_item" id="cr_btn_print"><i class="fas fa-print"></i> Imprimir PDF (Recomendado ATS)</button>
              <button class="conv_dropdown_item" id="cr_btn_dw_pdf"><i class="fas fa-file-pdf"></i> Descargar PDF (Exportación Directa)</button>
              <button class="conv_dropdown_item" id="cr_btn_dw_docx"><i class="fas fa-file-word"></i> Descargar Word (.docx)</button>
              <button class="conv_dropdown_item" id="cr_btn_dw_txt"><i class="fas fa-file-alt"></i> Descargar Texto (.txt)</button>
              <button class="conv_dropdown_item" id="cr_btn_dw_md"><i class="fab fa-markdown"></i> Descargar Markdown (.md)</button>
              <button class="conv_dropdown_item" id="cr_btn_dw_json"><i class="fas fa-file-code"></i> Respaldar datos (.json)</button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Workspace Split -->
    <main class="conv_workspace_split" id="crearWorkspace">
      
      <!-- Panel Izquierdo: Formularios -->
      <section class="conv_left_pane">
        <!-- Navegación interna de pestañas (Renderizado dinámico) -->
        <div class="conv_tabs_header" id="crTabsHeader">
          <!-- Renderizado dinámico desde visual.js -->
        </div>

        <!-- Contenido dinámico del formulario -->
        <form id="crFormContent" onsubmit="return false;">
          <!-- Renderizado dinámico desde visual.js -->
        </form>

        <!-- Scorecard ATS al final del panel izquierdo -->
        <div class="cr_scorecard_bottom">
          <div class="cr_score_header">
            <span class="cr_score_title">Compatibilidad ATS:</span>
            <div class="cr_score_actions">
              <button id="cr_btn_optimize_all" class="cr_btn_optimize_botwii" data-witip="Haz clic para que Botwii optimice automáticamente todo tu currículum: reescribirá tus logros con verbos fuertes, pulirá tu resumen e integrará mejoras ATS clave.">
                <i class="fas fa-wand-magic-sparkles"></i> Optimizar con Botwii
              </button>
              <div class="cr_score_badge" data-witip="Tu porcentaje de compatibilidad ATS actual. Mientras más alto, más probabilidades tendrás de superar los filtros automáticos.">
                <span id="cr_score_val">0</span>/100
              </div>
            </div>
          </div>
          <!-- Progress bar -->
          <div class="cr_score_bar_bg">
            <div id="cr_score_fill" class="cr_progress_fill"></div>
          </div>
          <!-- Checklist -->
          <div id="cr_checklist">
            <!-- Advertencias inyectadas por auditor.js -->
          </div>
        </div>
      </section>

      <!-- Panel Derecho: Vista previa -->
      <section class="conv_right_pane">
        <!-- Escritorio de Vista Previa -->
        <div class="conv_a4_wrapper" data-witip="Esta es una plantilla ATS clásica limpia. Los reclutadores prefieren este formato sobrio porque los robots de IA pueden leerlo sin errores.">
          <div id="cr_cv_printable_area" class="cr_printable_pages_container">
            <!-- Las páginas A4 se inyectan dinámicamente desde visual.js -->
          </div>
        </div>
      </section>
      
    </main>

  </div>

  <div class="consejos_crear">
    <Consejos />
  </div>

  <!-- Modal para la Optimización de Logros con IA -->
  <div id="cr_ai_modal" class="cr_modal">
    <div class="cr_modal_content">
      <div class="cr_modal_header">
        <h3><i class="fas fa-wand-magic-sparkles"></i> Optimizar Logro con IA</h3>
        <button id="cr_btn_close_modal" class="cr_modal_close">&times;</button>
      </div>
      <div class="cr_modal_body">
        <p>La inteligencia artificial de Gemini reescribirá tu experiencia aplicando reglas de impacto ATS (verbos de acción fuertes y enfoque a resultados).</p>
        <div class="cr_ai_diff_grid">
          <div class="cr_ai_diff_card">
            <h4>Tu redacción original:</h4>
            <div id="cr_ai_original_text" class="cr_ai_text_box"></div>
          </div>
          <div class="cr_ai_diff_card">
            <h4>Sugerencia de Gemini ✨:</h4>
            <div id="cr_ai_optimized_container">
              <div id="cr_ai_loading" class="cr_ai_loading dpn">
                <i class="fas fa-spinner fa-spin"></i>
                <p>Optimizando tu redacción, por favor espera...</p>
              </div>
              <div id="cr_ai_optimized_text" class="cr_ai_text_box success dpn" contenteditable="true"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="cr_modal_footer">
        <button id="cr_btn_discard_ai" class="cr_btn outline small">Descartar</button>
        <button id="cr_btn_apply_ai" class="cr_btn primary small" disabled>Aplicar Cambios</button>
      </div>
    </div>
  </div>

  <!-- Modal de confirmación para crear nuevo CV (Premium) -->
  <div id="cr_reset_modal" class="wiModal">
    <div class="modalBody cr_confirm_modal_body">
      <button class="modalX" id="cr_btn_close_reset_modal">&times;</button>
      <div class="cr_confirm_content">
        <div class="cr_confirm_icon_wrapper">
          <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3>¿Crear nuevo currículum?</h3>
        <p>Esto borrará de forma permanente todo tu progreso actual en este navegador. ¿Estás seguro de que deseas empezar de cero?</p>
        <div class="cr_confirm_actions">
          <button id="cr_btn_confirm_reset" class="cr_btn_confirm_yes">Sí, crear nuevo</button>
          <button id="cr_btn_cancel_reset" class="cr_btn_confirm_no">Cancelar</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initVisual } from '../lib/crear/visual.js';
  import { Notificacion } from '../lib/widev.js';

  const init = () => {
    // 1. Inicializar Módulo Visual modularizado del Creador de CV
    initVisual();

    // 2. Controlar la interactividad del dropdown de descargas
    const toggleBtn = document.getElementById('crBtnDownloadToggle');
    const menu = document.getElementById('crDownloadMenu');
    
    if (toggleBtn && menu) {
      const toggleMenu = (e: MouseEvent) => {
        e.stopPropagation();
        const isOpen = menu.classList.contains('show');
        if (isOpen) {
          menu.classList.remove('show');
          toggleBtn.setAttribute('aria-expanded', 'false');
        } else {
          menu.classList.add('show');
          toggleBtn.setAttribute('aria-expanded', 'true');
        }
      };

      toggleBtn.addEventListener('click', toggleMenu);

      // Cerrar al hacer clic fuera
      document.addEventListener('click', () => {
        menu.classList.remove('show');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    }

    // 3. Notificación motivadora cuando el Score llega a 92+
    let scoreNotified = false;
    const scoreValObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'childList') {
          const score = parseInt(mutation.target.textContent || '0');
          if (score >= 92 && !scoreNotified) {
            Notificacion('¡Excelente compatibilidad ATS! Has superado el umbral recomendado para pasar los filtros de selección corporativos. 🌟', 'success', 5000);
            scoreNotified = true;
          } else if (score < 92) {
            scoreNotified = false;
          }
        }
      });
    });

    const scoreValEl = document.getElementById('cr_score_val');
    if (scoreValEl) {
      scoreValObserver.observe(scoreValEl, { childList: true });
    }
  };

  document.addEventListener('astro:page-load', init);
</script>