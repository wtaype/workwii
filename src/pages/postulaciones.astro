---
import Layout from '../layouts/Layout.astro';
import PostulacionesPage from '../lib/usuarios/postulaciones/postulacionesPage.astro';
import estilosPost from '../lib/usuarios/postulaciones/postulaciones.css?inline';
import estilosChat from '../lib/usuarios/postulaciones/chatwii/components/wii.css?inline';
---
<Layout title="Mis Postulaciones" robots="noindex, nofollow">
  <script is:inline slot="head">localStorage.wiSmile||location.replace('/')</script>
  <style is:global set:html={estilosPost + estilosChat} slot="head"></style>
  <PostulacionesPage/>
</Layout>
