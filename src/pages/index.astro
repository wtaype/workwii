---
import Layout from '../layouts/Layout.astro';
import { Saludar } from '../lib/widev.js';
import { app } from '../wii.js';
import { seoPages } from '../lib/seo.js';

const PREGUNTAS = [
  '¿Cansado de enviar decenas de currículums y solo recibir el silencio como respuesta?',
  '¿Temes que los filtros automáticos (ATS) descarten tu CV antes de que una persona lo lea?',
  '¿Te paralizan los nervios y la ansiedad antes de una entrevista de trabajo decisiva?',
];

const BENEFICIOS = [
  ['fa-robot', 'Optimización ATS Inteligente', 'Alinea tu CV con las palabras clave que buscan los reclutadores para pasar los filtros de selección en segundos.', '#0EBEFF'],
  ['fa-file-signature', 'Creador de CV con IA', 'Diseña y redacta un currículum profesional, moderno e impecable sin dolores de cabeza.', '#FF5C69'],
  ['fa-comments', 'Simulación de Entrevistas', 'Practica tus respuestas frente a un reclutador virtual con IA y recibe retroalimentación inmediata.', '#29C72E'],
  ['fa-user-tie', 'Estudio de Retratos IA', 'Transforma una selfie común en una fotografía corporativa impecable para tu perfil de LinkedIn.', '#FFB800'],
];

const PASOS = [
  ['1', 'Crea o Sube tu Perfil', 'Importa tu CV actual o introduce tus datos en nuestro editor interactivo paso a paso.'],
  ['2', 'Optimiza con IA', 'Nuestra IA analiza tu perfil frente a la vacante sugerida para garantizar la máxima compatibilidad.'],
  ['3', 'Conquista tu Puesto', 'Entrena en el simulador y postula con la seguridad de que tu perfil pasará cualquier filtro.'],
];
---

<style is:global>
.inicio { max-width: 1400px; margin: 0 auto; padding: 0 2vw }

.font_o { font-family: var(--ff_O) !important; }

/* ══════════════════ HERO ══════════════════ */
.hero { display: grid; grid-template-columns: 1.2fr 1.5fr; gap: 4vw; align-items: center; min-height: 85vh; padding: 6vh 0 }
.hero_txt { display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
.hero_saludo { display: inline-flex; align-items: center; gap: 1vh; font-size: var(--fz_m4); font-weight: 600; color: var(--tx); margin-bottom: 2vh; animation: slideIn .8s ease }
.hero_wave { display: inline-block; font-size: var(--fz_l1); transform-origin: 70% 70%; animation: wave 1.8s ease-in-out infinite; }

.mainh { font-size: var(--fz_x3); font-weight: 950; color: var(--tx); line-height: 1.15; margin-bottom: 0.5vh; animation: slideIn .8s ease .2s backwards; letter-spacing: -1.5px; }
.hero_sub_tit { font-size: var(--fz_l1); font-weight: 800; display: block; margin-bottom: 2vh; animation: slideIn .8s ease .3s backwards }
.gradiente { background: linear-gradient(135deg, var(--mco), var(--hva)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text }
.hero_roles { height: 4vh; margin-bottom: 3vh; position: relative; overflow: hidden; display: flex; justify-content: flex-start; width: 100%; animation: slideIn .8s ease .4s backwards }
.role { position: absolute; font-size: var(--fz_l1); font-weight: 700; color: var(--mco); opacity: 0; transform: translateY(100%); transition: all .5s cubic-bezier(.4, 0, .2, 1) }
.role.active { opacity: 1; transform: translateY(0) }
.hero_oracion { font-size: clamp(1.2rem, 2.2vw, 1.45rem); color: var(--tx1); line-height: 1.8; margin: 0 0 4vh 0; max-width: 95%; font-weight: 500; text-align: left; animation: slideIn .8s ease .6s backwards }
.hero_oracion p { margin-bottom: 1.5vh; }
.hero_oracion .amen { font-weight: 800; color: var(--tx); margin-top: 2vh; font-size: var(--fz_m4); }
.hero_visual { position: relative; display: flex; justify-content: center; align-items: center; animation: fadeIn 1s ease .5s backwards; width: 100%; }

.hero_ctas { display: flex; gap: 2vh; flex-wrap: wrap; animation: slideIn .8s ease .7s backwards; }
.btn_principal { background: var(--mco) !important; color: #fff !important; border-color: var(--mco) !important; }
.btn_principal:hover { opacity: 0.9; transform: translateY(-0.3vh); }

/* ══════════════════ CV MOCKUP ══════════════════ */
.cv_mockup {
  width: 100%;
  max-width: 440px;
  background: var(--wb);
  border: 1px solid var(--brd);
  border-radius: 2vh;
  box-shadow: var(--bs_l);
  overflow: hidden;
  animation: float 4s ease-in-out infinite;
  text-align: left;
  z-index: 1;
}
.mock_header {
  background: var(--bg4);
  padding: 1.5vh 2.2vh;
  display: flex;
  align-items: center;
  gap: 1.5vh;
  border-bottom: 1px solid var(--brd);
}
.mock_dots { display: flex; gap: 0.8vh; }
.mock_dots span { width: 1.2vh; height: 1.2vh; border-radius: 50%; background: #ff5f56; }
.mock_dots span:nth-child(2) { background: #ffbd2e; }
.mock_dots span:nth-child(3) { background: #27c93f; }
.mock_title { font-size: var(--fz_s4); font-weight: 700; color: var(--tx3); font-family: var(--ff_O); }
.mock_body { padding: 3vh; display: flex; flex-direction: column; gap: 2.5vh; }
.mock_profile { display: flex; align-items: center; gap: 2vh; }
.mock_avatar { width: 6vh; height: 6vh; border-radius: 50%; background: color-mix(in srgb, var(--mco) 15%, transparent); color: var(--mco); display: flex; align-items: center; justify-content: center; font-size: var(--fz_l1); }
.mock_name { font-weight: 850; font-size: var(--fz_m4); color: var(--tx); font-family: var(--ff_O); }
.mock_role { font-size: var(--fz_s4); color: var(--tx3); }
.mock_bars { display: flex; flex-direction: column; gap: 1.8vh; }
.mock_bar_item { display: grid; grid-template-columns: 1fr 1.5fr 45px; align-items: center; gap: 1.5vh; font-size: var(--fz_s3); font-weight: 600; color: var(--tx2); }
.bar_container { height: 1.2vh; background: var(--bg4); border-radius: 50px; overflow: hidden; }
.bar_fill { height: 100%; background: var(--mco); border-radius: 50px; }
.bar_val { text-align: right; font-weight: 700; color: var(--tx1); }
.mock_badges { display: flex; gap: 1.2vh; flex-wrap: wrap; }
.m_badge { font-size: var(--fz_s2); font-weight: 700; padding: 0.6vh 1.5vh; border-radius: 5vh; background: var(--bg4); color: var(--tx3); }
.m_badge.active { background: color-mix(in srgb, var(--success) 12%, transparent); color: var(--success); }
.m_badge.warn { background: color-mix(in srgb, var(--warning) 12%, transparent); color: var(--warning); }

/* Botones flotantes */
.hero_badge_float { position: absolute; background: var(--wb); border: 2px solid var(--brd); border-radius: 50px; padding: 1.2vh 2.5vh; display: flex; justify-content: center; align-items: center; gap: 1vh; font-size: var(--fz_m2); font-weight: 600; color: var(--tx); box-shadow: 0 1vh 3vh rgba(0,0,0,.1); animation: slideInRight .7s cubic-bezier(.4,0,.2,1) backwards, float 3.5s ease-in-out var(--fd, 1s) infinite; animation-delay: var(--d, 0s), calc(var(--d, 0s) + .7s); transition: box-shadow 0.3s, transform 0.3s; z-index: 2; white-space: nowrap; font-family: var(--ff_O); }
.hero_badge_float i { color: var(--mco); font-size: var(--fz_m3); }
.hero_badge_float:hover { box-shadow: 0 1.5vh 4vh rgba(0,0,0,.15); transform: scale(1.05); }
.hb_1 { top: 12%; right: -5%; --fd:0s; }
.hb_2 { bottom: 35%; left: -8%; --fd:.5s; }
.hb_3 { bottom: 8%; right: 2%; --fd:1s; }

.hero_deco { position: absolute; inset: 0; pointer-events: none; overflow: hidden }
.hero_deco i { position: absolute; color: var(--mco); opacity: .12; animation: spin 20s linear infinite }
.hero_deco i:nth-child(1) { top: 10%; left: 15%; font-size: 3vh }
.hero_deco i:nth-child(2) { top: 60%; right: 20%; font-size: 5vh; animation-delay: -5s }
.hero_deco i:nth-child(3) { bottom: 20%; left: 30%; font-size: 3.5vh; animation-delay: -10s }

@keyframes slideIn { from { opacity: 0; transform: translateX(-30px) } to { opacity: 1; transform: translateX(0) } }
@keyframes slideInRight { from { opacity: 0; transform: translateX(30px) } to { opacity: 1; transform: translateX(0) } }
@keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }
@keyframes float { 0%, 100% { transform: translateY(0) } 50% { transform: translateY(-2vh) } }
@keyframes spin { to { transform: rotate(360deg) } }
@keyframes pulse { 0%, 100% { transform: scale(1) } 50% { transform: scale(1.05) } }
@keyframes wave { 0%, 100% { transform: rotate(0deg); } 10%, 30% { transform: rotate(14deg); } 20% { transform: rotate(-8deg); } 40% { transform: rotate(-4deg); } 50% { transform: rotate(10deg); } }

/* ══════════════════ SECCIONES (base) ══════════════════ */
.inicio section { padding: 8vh 0 }
.mainh1 { font-size: var(--fz_x1); font-weight: 800; display: flex; align-items: center; justify-content: center; gap: 1vh; color:var(--tx) }
.sec_head { text-align: center; margin-bottom: 2vh }
.sec_head h2 { font-size: var(--fz_x1); font-weight: 800; color: var(--tx); display: flex; align-items: center; justify-content: center; gap: 1.5vh }
.sec_head h2 i { color: var(--mco) }
.sec_line { width: 80px; height: 4px; background: linear-gradient(90deg, var(--mco), var(--hva)); margin: 1vh auto 0; border-radius: 2px }
.sec_desc { text-align: center; font-size: var(--fz_m3); color: var(--tx2); margin-bottom: 4vh }

.btn_sec { display: inline-flex; align-items: center; gap: 1vh; padding: 1.5vh 3vh; border-radius: 1vh; font-size: var(--fz_m3); font-weight: 700; text-decoration: none; transition: all .3s; cursor: pointer; background: transparent; color: var(--tx); border: 2px solid var(--brd) }
.btn_sec:hover { border-color: var(--mco); background: rgba(255,255,255,0.1); transform: translateY(-.3vh) }

/* ══════════════════ PREGUNTAS (DOLORES) ══════════════════ */
.sec_preguntas { background: var(--bg4); border-radius: 2.2vh; padding: 6vh 4vh !important; margin: 4vh auto; }
.preg_grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 3.5vh; margin-top: 4vh; }
.preg_card { background: var(--wb); border: 1px solid var(--brd); border-radius: 1.5vh; padding: 3.5vh; position: relative; transition: transform .3s, border-color .3s; }
.preg_card:hover { transform: translateY(-5px); border-color: var(--mco); }
.preg_num { font-size: var(--fz_l2); font-weight: 900; color: color-mix(in srgb, var(--mco) 25%, transparent); margin-bottom: 1.5vh; }
.preg_card p { font-size: var(--fz_m2); font-weight: 600; color: var(--tx1); line-height: 1.6; }

/* ══════════════════ FRASES / VERSICULOS ══════════════════ */
.ej_grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 3vh }
.ej_item { display: block; background: var(--wb); padding: 3vh; border-radius: 1.5vh; border: 2px solid transparent; transition: all .5s; color: inherit }
.ej_item:hover { transform: translateY(-.8vh); border-color: var(--x); box-shadow: 0 1vh 3vh rgba(0,0,0,.12) }
.ej_top { display: flex; align-items: center; gap: 1vh; margin-bottom: 1.5vh }
.ej_top > span:first-child { font-size: var(--fz_l2); color: var(--x); }
.ej_tag { font-size: var(--fz_s4); font-weight: 600; color: var(--x); background: color-mix(in srgb, var(--x) 12%, transparent); padding: .4vh 1.2vh; border-radius: 50px }
.ej_item p { font-size: var(--fz_m3); font-weight: 500; color: var(--tx); line-height: 1.6; font-style: italic; margin-bottom: 1.5vh }
.ej_meta { display: flex; gap: 2vh; font-size: var(--fz_m1); font-weight: 700; color: var(--tx2); margin-bottom: 0 }
.ej_meta i { color: var(--x); opacity: 0.7; }

/* ══════════════════ FEATURES / PASOS ══════════════════ */
.feat_grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 3vh; margin-top: 4vh }
.feat_card { background: var(--wb); padding: 4vh 3vh; border-radius: 1.5vh; text-align: center; border: 2px solid transparent; transition: all .3s; }
.feat_card:hover { transform: translateY(-.8vh); border-color: var(--mco); box-shadow: 0 1vh 3vh rgba(0,0,0,.1) }
.feat_ico { width: 8vh; height: 8vh; background: color-mix(in srgb, var(--mco) 10%, transparent); color: var(--mco); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fz_l2); margin: 0 auto 2vh; transition: all .3s }
.feat_card:hover .feat_ico { background: var(--mco); color: #fff; transform: scale(1.1) rotate(5deg) }
.feat_card h3 { font-size: var(--fz_m4); font-weight: 800; color: var(--tx); margin-bottom: 1.5vh }
.feat_card p { font-size: var(--fz_m1); color: var(--tx2); line-height: 1.6 }

.paso_card { text-align: left; display: flex; flex-direction: column; align-items: flex-start; }
.paso_num { font-size: var(--fz_l2); font-weight: 900; width: 6vh; height: 6vh; margin: 0 0 2vh 0; }

/* ══════════════════ ACERCA DE NOSOTROS ══════════════════ */
.sec_test { padding: 0 }
.test_bg { background: linear-gradient(135deg, var(--mco), var(--hva)); border-radius: 2vh; padding: 8vh 4vh; position: relative; overflow: hidden; box-shadow: 0 2vh 4vh rgba(0,0,0,.1) }
.test_bg::before { content: ''; position: absolute; inset: 0; background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80"><circle cx="40" cy="40" r="1.5" fill="white" opacity=".08"/></svg>') repeat; pointer-events: none }
.test_inner_single { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; text-align: center; }
.test_left h2 { font-size: var(--fz_l2); font-weight: 800; color: var(--txa); margin-bottom: 4vh; display: flex; align-items: center; justify-content: center; gap: 1vh }
.test_left h2 i { font-size: var(--fz_l1) }
.about_text { background: rgba(255,255,255,.1); backdrop-filter: blur(10px); padding: 5vh; border-radius: 2vh; border: 1px solid rgba(255,255,255,.2); font-size: var(--fz_m2); color: var(--txa); line-height: 1.8; text-align: left; }
.about_text p { margin-bottom: 2.5vh; }
.about_text p:last-of-type { margin-bottom: 0; }
.about_text strong { font-weight: 700; color: #fff; }

/* ══════════════════ RESPONSIVE ══════════════════ */
@media (max-width: 900px) {
  .hero { grid-template-columns: 1fr; text-align: center; padding: 3vh 0 }
  .hero_txt { align-items: center; text-align: center; }
  .hero_visual { order: -1 }
  .hero_oracion { max-width: 100%; margin: 0 auto 3vh; text-align: center; }
  .hero_roles { display: flex; justify-content: center }
  .hero_ctas { justify-content: center; }
  .cv_mockup { margin: 0 auto; }
  section { padding: 5vh 0 }
  .test_bg { padding: 5vh 3vh; border-radius: 0 }
  .about_text { padding: 3vh; }
}
@media (max-width: 480px) {
  .mainh { font-size: var(--fz_x1) }
  .sec_head h2 { font-size: var(--fz_l2) }
  .hero_oracion { font-size: var(--fz_m2); }
  .about_text { font-size: var(--fz_m1); }
  .cv_mockup { max-width: 100%; }
}

/* ══════════════════ INICIO BLOG ══════════════════ */
.ib_grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2.5vh;
  margin-top: 2vh;
}

.ib_card {
  background: var(--wb);
  border: 1px solid var(--brd);
  border-radius: 1.5vh;
  overflow: hidden;
  cursor: pointer;
  transition: transform .3s, box-shadow .3s, border-color .3s;
  display: flex;
  flex-direction: column;
}
.ib_card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 32px rgba(0,0,0,.1);
  border-color: var(--mco);
}

.ib_img {
  aspect-ratio: 16/9;
  background-size: cover;
  background-position: center;
  background-color: var(--bg4);
  position: relative;
  flex-shrink: 0;
}
.ib_cat {
  position: absolute;
  top: 1.2vh;
  left: 1.2vh;
  font-size: var(--fz_s2);
  font-weight: 700;
  padding: .4vh 1.2vh;
  border-radius: 5vh;
  backdrop-filter: blur(4px);
}

.ib_body {
  padding: 2vh 2.2vh;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: .8vh;
}
.ib_tit {
  font-size: var(--fz_m2);
  font-weight: 700;
  color: var(--tx);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ib_resumen {
  font-size: var(--fz_s4);
  color: var(--tx3);
  line-height: 1.5;
  flex: 1;
}
.ib_meta {
  display: flex;
  gap: 2vh;
  font-size: var(--fz_s2);
  color: var(--tx3);
  margin-top: auto;
  padding-top: .8vh;
  border-top: 1px solid var(--brd);
}
.ib_meta i { color: var(--mco); margin-right: .3vh; }

.ib_footer { text-align: center; margin-top: 4vh; }
.ib_ver_mas { background: var(--mco) !important; color: #fff !important; border-color: var(--mco) !important; padding: 1.6vh 4vh !important; font-size: var(--fz_m2) !important; }
.ib_ver_mas:hover { opacity: .88; transform: translateY(-.3vh) !important; }

.ib_empty { text-align: center; color: var(--tx3); padding: 6vh; font-size: var(--fz_m2); grid-column: 1/-1; }
.ib_empty i { display: block; font-size: var(--fz_l2); margin-bottom: 1.5vh; opacity: .4; }

/* Skeleton */
.ib_sk { background: var(--wb); border: 1px solid var(--brd); border-radius: 1.5vh; overflow: hidden; }
.ib_sk_img { aspect-ratio: 16/9; }
.ib_sk_body { padding: 2vh; display: flex; flex-direction: column; gap: 1.2vh; }
.ib_sk_cat  { height: 2.2vh; width: 35%; border-radius: 5vh; }
.ib_sk_tit  { height: 1.8vh; width: 90%; border-radius: .6vh; }
.ib_sk_t2   { width: 65%; }

/* Shimmer */
@keyframes shimmer { 0% { background-position: -200% 0 } 100% { background-position: 200% 0 } }
.shimmer { background: linear-gradient(90deg, var(--bg4) 25%, var(--bg5) 50%, var(--bg4) 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }

@media (max-width: 1100px) { .ib_grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 750px)  { .ib_grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px)  { .ib_grid { grid-template-columns: 1fr; } }
</style>

<Layout {...seoPages.inicio}>
  <div class="inicio">
    <section class="hero">
      <div class="hero_txt">
        <div class="hero_saludo">
          <span>{Saludar()} Candidat@</span><span class="hero_wave">👋</span>
        </div>
        <h2 class="font_o mainh">Impulsa tu carrera</h2>
        <span class="gradiente hero_sub_tit font_o">Consigue tu trabajo ideal con IA</span>
        <div class="hero_roles">
          <span class="role active">Optimiza tu CV 🚀</span>
          <span class="role">Vence los Filtros ATS 🤖</span>
          <span class="role">Entrena Entrevistas 🗣️</span>
          <span class="role">Destaca en LinkedIn 💼</span>
        </div>
        <div class="hero_oracion font_o">
          <p style="font-weight: 700; color: var(--tx); font-size: var(--fz_m4);">¿Sientes que tu currículum desaparece en un agujero negro sin respuestas?</p>
          <p>No estás sol@. El 75% de las postulaciones son descartadas automáticamente por algoritmos (ATS) antes de llegar a un reclutador. Tu talento merece ser visto y valorado.</p>
          <p><strong>Workwii</strong> es tu aliado tecnológico para adaptar tu perfil, ganar total confianza y conquistar las entrevistas que cambiarán tu futuro.</p>
        </div>
        <div class="hero_ctas" data-herowi="50">
          <button class="btn_sec btn_principal font_o bt_auth registrar" id="btn-hero-cta">
            <i class="fas fa-rocket"></i><span>Comenzar Gratis</span>
          </button>
          <a href="#dolores" class="btn_sec font_o">
            <span>Saber más</span><i class="fas fa-arrow-down"></i>
          </a>
        </div>
      </div>
      <div class="hero_visual">
        <div class="hero_badge_float hb_1" style="--d:.5s" data-witip="Compatibilidad ATS: 98%"><i class="fas fa-shield-halved"></i> 98% ATS</div>
        <div class="hero_badge_float hb_2" style="--d:.7s" data-witip="Simulador de Entrevista Activo"><i class="fas fa-microphone"></i> IA Feedback</div>
        <div class="hero_badge_float hb_3" style="--d:.9s" data-witip="CV Aprobado"><i class="fas fa-circle-check"></i> CV Listo</div>
        
        <div class="cv_mockup">
          <div class="mock_header">
            <div class="mock_dots"><span></span><span></span><span></span></div>
            <div class="mock_title">Curriculum Vitae — Optimizador ATS</div>
          </div>
          <div class="mock_body">
            <div class="mock_profile">
              <div class="mock_avatar"><i class="fas fa-user-tie"></i></div>
              <div class="mock_info">
                <div class="mock_name">Sofía Mendoza</div>
                <div class="mock_role">Desarrolladora de Software</div>
              </div>
            </div>
            <div class="mock_bars">
              <div class="mock_bar_item">
                <span>Puntuación ATS</span>
                <div class="bar_container"><div class="bar_fill" style="width: 95%"></div></div>
                <span class="bar_val">95%</span>
              </div>
              <div class="mock_bar_item">
                <span>Palabras Clave</span>
                <div class="bar_container"><div class="bar_fill" style="width: 89%; background: #FF5C69"></div></div>
                <span class="bar_val">89%</span>
              </div>
            </div>
            <div class="mock_badges">
              <span class="m_badge active">✓ Legible para Reclutadores</span>
              <span class="m_badge active">✓ Formato PDF</span>
              <span class="m_badge warn">⚠ Sin Enlace a GitHub</span>
            </div>
          </div>
        </div>

        <div class="hero_deco"><i class="fas fa-briefcase"></i><i class="fas fa-star"></i><i class="fas fa-arrow-trend-up"></i></div>
      </div>
    </section>

    <section class="sec_preguntas" id="dolores">
      <div class="sec_head">
        <h2><i class="fas fa-circle-question"></i> ¿Te pasa algo de esto?</h2>
        <div class="sec_line"></div>
      </div>
      <p class="sec_desc">Buscar empleo es un proceso emocionalmente agotador. Queremos ayudarte a superar estos obstáculos:</p>
      <div class="preg_grid" data-herowi="100">
        {PREGUNTAS.map((p, idx) => (
          <div class="preg_card">
            <div class="preg_num font_o">0{idx + 1}</div>
            <p>{p}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="wi_ad_container" style="text-align:center; margin: 4vh auto; max-width: 90vw; min-height: 100px;">
      <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1362457560630815" data-ad-slot="8397551727" data-ad-format="auto" data-full-width-responsive="true"></ins>
    </div>

    <section class="sec_ej" id="beneficios">
      <div class="sec_head">
        <h2><i class="fas fa-award"></i> Lo que ganarás con Workwii</h2>
        <div class="sec_line"></div>
      </div>
      <p class="sec_desc">Herramientas diseñadas con IA para darte una ventaja competitiva en el mercado laboral</p>
      <div class="ej_grid" data-herowi="100">
        {BENEFICIOS.map(b => (
          <div class="ej_item" style={`--x:${b[3]}`}>
            <div class="ej_top"><span><i class={`fas ${b[2]}`}></i></span><span class="ej_tag font_o">Herramienta</span></div>
            <h3 class="font_o" style="font-size: var(--fz_m4); font-weight: 800; color: var(--tx1); margin-bottom: 1.5vh;">{b[1]}</h3>
            <p class="font_o" style="font-style: normal; color: var(--tx2); line-height: 1.6; margin-bottom: 0;">{b[2]}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="wi_ad_container" style="text-align:center; margin: 4vh auto; max-width: 90vw; min-height: 100px;">
      <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1362457560630815" data-ad-slot="8397551727" data-ad-format="auto" data-full-width-responsive="true"></ins>
    </div>

    <section class="sec_feat" id="sec_funcionamiento">
      <div class="sec_head"><h2><i class="fas fa-circle-nodes"></i> Tu camino al éxito en 3 pasos</h2><div class="sec_line"></div></div>
      <p class="sec_desc">Una metodología sencilla para pasar de postular a ser contratado</p>
      <div class="feat_grid" data-herowi="150">
        {PASOS.map(([num, t, d]) => (
          <div class="feat_card paso_card">
            <div class="feat_ico paso_num font_o">{num}</div>
            <h3 class="font_o">{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="sec_ib" id="sec_blog">
      <h1 class="mainh1"><i class="fas fa-graduation-cap"></i> Consejos y Estrategias Profesionales</h1>
      <p class="sec_desc">Aprende a destacar tu perfil, redactar tu trayectoria y triunfar en entrevistas</p>
      <div class="ib_grid" id="ib_grid" data-herowi="100">
        <!-- Skeleton fallback that renders server-side -->
        {Array(12).fill(0).map(() => (
          <div class="ib_sk">
            <div class="ib_sk_img shimmer"></div>
            <div class="ib_sk_body">
              <div class="ib_sk_cat shimmer"></div>
              <div class="ib_sk_tit shimmer"></div>
              <div class="ib_sk_tit ib_sk_t2 shimmer"></div>
            </div>
          </div>
        ))}
      </div>
      <div class="ib_footer">
        <a class="btn_sec ib_ver_mas font_o" href="/blog">
          <i class="fas fa-arrow-right"></i><span>Ver todos los artículos</span>
        </a>
      </div>
    </section>

    <section class="sec_test" style="margin-top: 4vh; margin-bottom: 8vh;">
      <div class="test_bg">
        <div class="test_inner_single">
          <div class="test_left" style="text-align: center;">
            <h2 class="font_o"><i class="fas fa-briefcase"></i> Sobre Workwii</h2>
            <div class="about_text">
              <p><strong>Workwii</strong> nació de la frustración real de no saber por qué los CVs eran ignorados automáticamente. Creemos firmemente que ningún talento debe quedar en la sombra debido a un mal formato o la falta de palabras clave.</p>
              <p>Nuestra misión es empoderar a cada profesional con inteligencia artificial gratuita y accesible para potenciar sus fortalezas. ¡Queremos que postules con la seguridad y confianza de que pasarás cualquier filtro!</p>
              <div class="sec_cta" style="margin-top: 3vh; text-align: left;">
                <a href="/acerca" class="btn_sec font_o" style="color: white; border-color: rgba(255,255,255,0.3);"><i class="fas fa-arrow-right"></i><span>Conoce nuestra historia</span></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { herowi } from '../lib/widev.js';
  import { supabase } from '../lib/supabase.js';

  /** @type {ReturnType<typeof setInterval>|null} */
  let roleInterval: any = null;

  const catColor = (c: string) => ({ Animales:'#0EBEFF', Naturaleza:'#25b62a', Amor:'#ff3849', Inspiración:'#ffa726', Vida:'#6a00f5' }[c] ?? 'var(--mco)');

  /** @param {Record<string,any>} p */
  const blogCard = (p: any) => {
    const c = catColor(p.categoria);
    return `
      <a href="/${p.slug || p.id || ''}" class="ib_card">
        <div class="ib_img" style="background-image:url('${p.imagen || p.portada || '/poster.webp'}')">
          <span class="ib_cat" style="background:color-mix(in srgb,${c} 20%,transparent);color:${c}">${p.categoria || 'Blog'}</span>
        </div>
        <div class="ib_body">
          <h3 class="ib_tit">${p.titulo || 'Sin título'}</h3>
          <p class="ib_resumen">${(p.resumen || p.descripcion || '').slice(0, 90)}...</p>
          <div class="ib_meta">
            <span><i class="fas fa-calendar-alt"></i> ${p.creado ? new Date(p.creado).toLocaleDateString('es-PE', { day:'numeric', month:'short', year:'numeric' }) : ''}</span>
            <span><i class="fas fa-eye"></i> ${p.vistas || 0}</span>
            <span><i class="fas fa-heart" style="color:#fe0149"></i> ${p.likes || 0}</span>
          </div>
        </div>
      </a>`;
  };

  const cleanup = () => { if (roleInterval) { clearInterval(roleInterval); roleInterval = null; } };

  const cargarBlog = async (hasCache: boolean) => {
    try {
      const { data: rawPosts, error } = await supabase
        .from('blog')
        .select('id, slug, titulo, descripcion, categoria, creado, imagen, vistas, likes')
        .eq('activo', true)
        .order('creado', { ascending: false })
        .limit(16);

      if (error) throw error;

      const posts = rawPosts?.map((p: any) => ({
        id: p.id,
        slug: p.slug,
        titulo: p.titulo,
        resumen: p.descripcion || '',
        categoria: p.categoria,
        creado: p.creado,
        imagen: p.imagen || '/poster.webp',
        vistas: p.vistas || 0,
        likes: p.likes || 0
      })) || [];

      if (!posts.length) {
        if (!hasCache) {
          const grid = document.getElementById('ib_grid');
          if (grid && !grid.querySelector('.ib_card')) {
            grid.innerHTML = '<p class="ib_empty"><i class="fas fa-dove"></i> Próximamente nuevos artículos</p>';
          }
        }
        return;
      }

      try { localStorage.setItem('wi_blogs', JSON.stringify({ value: posts, expiry: Date.now() + 10800000 })); } catch(_){}

      const grid = document.getElementById('ib_grid');
      if (grid) grid.innerHTML = posts.map(blogCard).join('');
      herowi();
    } catch(e) {
      if (!hasCache) {
        const grid = document.getElementById('ib_grid');
        if (grid && !grid.querySelector('.ib_card')) {
          grid.innerHTML = '<p class="ib_empty"><i class="fas fa-dove"></i> Error al cargar artículos...</p>';
        }
      }
    }
  };

  const checkSession = () => {
    const wi = localStorage.getItem('wiSmile');
    const btnCta = document.getElementById('btn-hero-cta');
    if (btnCta) {
      if (wi) {
        btnCta.innerHTML = '<i class="fas fa-house-user"></i> <span>Ir a mi Panel</span>';
        btnCta.setAttribute('data-target-url', '/smile');
        btnCta.classList.remove('bt_auth', 'registrar');
      } else {
        btnCta.innerHTML = '<i class="fas fa-rocket"></i> <span>Comenzar Gratis</span>';
        btnCta.removeAttribute('data-target-url');
        btnCta.classList.add('bt_auth', 'registrar');
      }
    }
  };

  const init = () => {
    cleanup();

    let idx = 0;
    const roles = document.querySelectorAll('.hero_roles .role');
    if (roles.length) {
      roleInterval = setInterval(() => {
        roles[idx].classList.remove('active');
        idx = (idx + 1) % roles.length;
        roles[idx].classList.add('active');
      }, 2500);
    }

    checkSession();

    const btnCta = document.getElementById('btn-hero-cta');
    if (btnCta) {
      btnCta.addEventListener('click', (e) => {
        const targetUrl = btnCta.getAttribute('data-target-url');
        if (targetUrl) {
          e.preventDefault();
          window.location.href = targetUrl;
        }
      });
    }

    herowi();

    let cached: any = null;
    try {
      const raw = localStorage.getItem('wi_blogs');
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed && Date.now() < parsed.expiry) cached = parsed;
        else localStorage.removeItem('wi_blogs');
      }
    } catch(_) {}

    const hasCache = !!(cached && cached.value && cached.value.length);
    if (hasCache) {
      const grid = document.getElementById('ib_grid');
      if (grid) grid.innerHTML = cached.value.map(blogCard).join('');
      herowi();
    }
    cargarBlog(hasCache);
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-preparation', cleanup);
</script>
