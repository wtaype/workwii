// Helper functions for PageSpeed circular metrics
const getScoreClass = (score: number) => {
  if (score >= 90) return 'score-high';
  if (score >= 60) return 'score-med';
  return 'score-low';
};

const radius = 50;
const circumference = 2 * Math.PI * radius; // ~314.16
const getOffset = (score: number) => circumference - (circumference * score) / 100;
---

<style>
/* ── ESTILOS DEL DASHBOARD DE EMPLEO REMOTO (TIPO PAGESPEED CARD - 100% ANCHO) ── */
.remoto_ct {
  width: 100%;
  margin: 0 auto;
  padding: 3vh 2vh 8vh;
  font-family: var(--ff_P);
  box-sizing: border-box;
}

/* 1. CABECERA INTEGRADA MINIMALISTA */
.re_header_ct {
  text-align: center;
  margin-top: 4vh;
  margin-bottom: 5vh;
  padding: 0 4vw;
}
.re_header_ct h1 {
  font-family: var(--ff_O);
  font-size: var(--fz_x2);
  font-weight: 950;
  color: var(--tx1);
  margin: 0 0 2vh;
  letter-spacing: -1.5px;
}
.re_header_ct p {
  font-family: var(--ff_P);
  font-size: var(--fz_m2);
  color: var(--tx2);
  line-height: 1.7;
  max-width: 800px;
  margin: 0 auto;
}

/* 2. LAYOUT DIVIDIDO (SIDEBAR INDEX 25% | MAIN CONTENT 75%) */
.remoto_layout {
  display: flex;
  gap: 2.5%;
  align-items: flex-start;
  width: 100%;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* BARRA LATERAL INDEX */
.remoto_sidebar {
  width: 25%;
  position: sticky;
  top: 8vh;
  flex-shrink: 0;
  background: var(--wb);
  border: 1px solid var(--brd);
  border-radius: 1.8vh;
  padding: 2.2vh;
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), padding 0.3s ease, opacity 0.2s ease;
}

.sidebar_header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2vh;
  border-bottom: 1px solid var(--brd);
  padding-bottom: 1.5vh;
}
.sidebar_title {
  font-family: var(--ff_P);
  font-size: var(--fz_m1);
  font-weight: 800;
  color: var(--tx1);
  display: flex;
  align-items: center;
  gap: 1vh;
  white-space: nowrap;
  transition: opacity 0.25s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.sidebar_title i {
  color: var(--mco);
}
.btn_collapse {
  background: color-mix(in srgb, var(--mco) 8%, var(--wb));
  border: 1px solid color-mix(in srgb, var(--mco) 20%, var(--brd));
  border-radius: 1vh;
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--mco);
  transition: all var(--tr_f);
  flex-shrink: 0;
}
.btn_collapse:hover {
  background: var(--mco);
  color: var(--wb);
  border-color: var(--mco);
}

.sidebar_nav {
  display: flex;
  flex-direction: column;
  gap: 1.5vh;
}
.sidebar_item {
  display: flex;
  align-items: center;
  gap: 1.2vh;
  padding: 1.2vh 1.5vh;
  border-radius: 1vh;
  text-decoration: none;
  color: var(--tx2);
  font-weight: 600;
  transition: all var(--tr_f);
  border: .1vh solid var(--brd);
  background: var(--wb);
  position: relative;
  overflow: hidden;
}
.sidebar_rank {
  font-family: var(--ff_P);
  font-size: var(--fz_s3);
  font-weight: 900;
  padding: 0.4vh 0.8vh;
  border-radius: 0.6vh;
  min-width: 35px;
  text-align: center;
  display: inline-block;
  line-height: 1;
  flex-shrink: 0;
  transition: transform var(--tr_f);
  box-sizing: border-box;
}
.rank_1 {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%) !important;
  color: #000 !important;
}
.rank_2 {
  background: linear-gradient(135deg, #C0C0C0 0%, #909090 100%) !important;
  color: #fff !important;
}
.rank_3 {
  background: linear-gradient(135deg, #CD7F32 0%, #8B4513 100%) !important;
  color: #fff !important;
}
.rank_other {
  background: transparent;
  color: var(--tx1);
  border: 1px solid var(--brd);
}
.sidebar_name {
  font-family: var(--ff_P);
  font-size: var(--fz_s4);
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: opacity 0.25s ease;
  text-align: left;
}
.sidebar_tag {
  font-family: var(--ff_P);
  font-size: var(--fz_s1);
  font-weight: 700;
  text-transform: capitalize;
  padding: 0.4vh 0.8vh;
  border-radius: 0.5vh;
  letter-spacing: 0.5px;
  white-space: nowrap;
  margin-left: auto;
  transition: opacity 0.25s ease;
}
.tag_tech    { background: color-mix(in srgb, var(--mco) 10%, transparent); color: var(--mco); }
.tag_premium { background: color-mix(in srgb, var(--warning) 10%, transparent); color: var(--warning); }
.tag_latam   { background: color-mix(in srgb, var(--success) 10%, transparent); color: var(--success); }
.tag_general { background: color-mix(in srgb, var(--mco) 10%, transparent); color: var(--mco); }

.sidebar_item:hover {
  background: var(--bg4);
  color: var(--tx1);
  border-color: var(--cc);
  transform: translateX(2px);
}
.sidebar_item:hover .sidebar_rank {
  transform: scale(1.08) rotate(-3deg);
}
.sidebar_item.active {
  background: color-mix(in srgb, var(--cc) 8%, var(--wb)) !important;
  color: var(--cc) !important;
  border: 1px solid var(--cc) !important;
  border-left: 4.5px solid var(--cc) !important;
  font-weight: 750;
}
.sidebar_item.active .sidebar_rank {
  transform: scale(1.03);
}

.sidebar_divider {
  border-top: 1.5px dashed color-mix(in srgb, var(--warning) 40%, var(--brd));
  margin: 1vh 0;
  width: 100%;
}

/* Special Advice Sidebar Item */
.sidebar_advice_item {
  border-radius: 1vh !important;
}
.rank_advice {
  background: linear-gradient(135deg, #FFDA34 0%, #FF9800 100%) !important;
  color: #000 !important;
  box-shadow: 0 4px 10px rgba(255, 218, 52, 0.25);
  border-radius: 50% !important;
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.tag_advice {
  background: color-mix(in srgb, var(--warning) 10%, transparent);
  color: var(--warning) !important;
  border: 1px solid color-mix(in srgb, var(--warning) 20%, transparent);
  margin-left: auto;
}

/* ESTADO COLAPSADO DEL LAYOUT Y SIDEBAR */
.remoto_layout.sidebar-collapsed .remoto_sidebar {
  width: 76px;
  padding: 2.2vh 1vh;
}
.remoto_layout.sidebar-collapsed .sidebar_title,
.remoto_layout.sidebar-collapsed .sidebar_name,
.remoto_layout.sidebar-collapsed .sidebar_tag,
.remoto_layout.sidebar-collapsed .sidebar_divider {
  opacity: 0;
  pointer-events: none;
  display: none;
}
.remoto_layout.sidebar-collapsed #collapse-icon {
  transform: rotate(180deg);
}

/* CONTENIDO PRINCIPAL (75%) */
.remoto_content {
  flex: 1;
  min-width: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* BUSCADOR SUPERIOR */
.re_search_wrap {
  display: flex;
  align-items: center;
  gap: 1.5vh;
  background: var(--wb);
  border: 1px solid var(--brd);
  border-radius: 1.5vh;
  padding: 1.5vh 2.5vh;
  margin-bottom: 4vh;
  transition: all var(--tr_f);
  box-sizing: border-box;
}
.re_search_wrap:focus-within {
  border-color: var(--mco);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--mco) 12%, transparent);
}
.re_search_ico {
  color: var(--tx3);
  font-size: var(--fz_m3);
  flex-shrink: 0;
}
.re_search_wrap:focus-within .re_search_ico {
  color: var(--mco);
}
.re_search {
  flex: 1;
  border: none;
  background: transparent;
  font-size: var(--fz_m2);
  color: var(--tx1);
  outline: none;
  font-family: var(--ff_P);
}
.re_search::placeholder {
  color: var(--tx3);
}
.re_search_count {
  font-family: var(--ff_O);
  font-size: var(--fz_s3);
  color: var(--tx3);
