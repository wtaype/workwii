<Layout {...seo.remotos}>
  <div class="remoto_ct">
    
    <!-- Cabecera Integrada y Minimalista -->
    <header class="re_header_ct">
      <h1>Trabajos Remotos Seguros</h1>
      <p>
        Encontrar empleo remoto no debería ser una ruleta rusa de estafas virtuales. Analizamos de forma honesta las mejores plataformas reales en 2026 para que postules de manera inteligente y segura.
      </p>
    </header>

    <!-- Layout de Dos Columnas (25% Sidebar Collapsible | 75% Contenido) -->
    <div class="remoto_layout" id="remoto-layout">
      
      <!-- BARRA LATERAL: Selector e Índice Top 10 -->
      <aside class="remoto_sidebar" id="remoto-sidebar" aria-label="Índice de portales">
        <div class="sidebar_header">
          <span class="sidebar_title"><i class="fas fa-star"></i> Los más recomendados</span>
          <button id="toggle-sidebar" class="btn_collapse" aria-label="Contraer barra lateral" title="Contraer/Expandir barra lateral">
            <i class="fas fa-chevron-left" id="collapse-icon"></i>
          </button>
        </div>
        
        <nav class="sidebar_nav">
          {plataformas.map((p, idx) => {
            const rank = idx + 1;
            let rankClass = 'rank_other';
            if (rank === 1) rankClass = 'rank_1';
            else if (rank === 2) rankClass = 'rank_2';
            else if (rank === 3) rankClass = 'rank_3';
            
            let categoryColor = 'var(--mco)';
            if (p.categoria === 'latam') categoryColor = 'var(--success)';
            else if (p.categoria === 'premium') categoryColor = 'var(--warning)';
            else if (p.categoria === 'general') categoryColor = 'var(--info)';
            
            return (
              <a href={`#platform-${p.id}`} class="sidebar_item" data-id={p.id} data-cat={p.categoria} style={`--cc: ${categoryColor};`}>
                <span class={`sidebar_rank ${rankClass}`}>#{rank}</span>
                <span class="sidebar_name">{p.nombre}</span>
                <span class={`sidebar_tag tag_${p.categoria}`}>{p.categoriaLabel}</span>
              </a>
            );
          })}
          
          <div class="sidebar_divider"></div>
          
          <a href="#advice-section" class="sidebar_item sidebar_advice_item" data-id="advice-section" style="--cc: var(--warning);">
            <span class="sidebar_rank rank_advice"><i class="fas fa-lightbulb"></i></span>
            <span class="sidebar_name">¿Qué haría en tu lugar?</span>
            <span class="sidebar_tag tag_advice">Consejo</span>
          </a>
        </nav>


      </aside>

      <!-- COLUMNA PRINCIPAL DE CONTENIDO -->
      <div class="remoto_content" id="remoto-content">
        
        <!-- Buscador Superior -->
        <div class="re_search_wrap">
          <i class="fas fa-search re_search_ico"></i>
          <input id="re-search" class="re_search" type="text" placeholder="Buscar plataforma por nombre, categoría o descripción..." autocomplete="off">
          <span class="re_search_count">{plataformas.length} plataformas</span>
        </div>
        
        <p class="re_empty" id="re-empty-msg" style="display:none"><i class="fas fa-search"></i> Sin resultados para tu búsqueda</p>

        <!-- Lista de Tarjetas (PageSpeed Cards) -->
        <section class="remoto_list_wrap" id="remoto-list-wrap">
          {plataformas.map((p, idx) => {
            const isReversed = idx % 2 === 1;
            const rank = idx + 1;
            let rankClass = 'rank_other';
            if (rank === 1) rankClass = 'rank_1';
            else if (rank === 2) rankClass = 'rank_2';
            else if (rank === 3) rankClass = 'rank_3';

            return (
              <article class={`remoto_horizontal_row ${isReversed ? 'row-reversed' : ''}`} id={`platform-${p.id}`} data-cat={p.categoria} data-id={p.id}>
                
                <!-- Columna Izquierda: Contenido e Información Directa -->
                <div class="remoto_row_left">
                  <div class="remoto_row_header">
                    <span class={`re_rank_badge ${rankClass}`}>#{rank}</span>
                    <h3>
                      <a href={p.url} target="_blank" rel="noopener noreferrer" class="re_title_link" title={`Visitar sitio oficial de ${p.nombre}`}>
                        {p.nombre}
                      </a>
                    </h3>
                    <span class={`re_badge badge_${p.categoria}`}>{p.categoriaLabel}</span>
                  </div>
                  
                  <p class="remoto_row_desc">{p.descripcion}</p>
                  
                  <div class="re_pros_cons_list">
                    <div class="re_list_group">
                      <strong class="pros_title"><i class="fas fa-circle-check"></i> Pros</strong>
                      <ul>
                        {p.pros.map(pro => (
                          <li>
                            <i class="fas fa-circle-check text-success list-icon"></i>
                            <span>{pro}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    
                    <div class="re_list_group">
                      <strong class="contras_title"><i class="fas fa-circle-xmark"></i> Contras</strong>
                      <ul>
                        {p.contras.map(con => (
                          <li>
                            <i class="fas fa-circle-xmark text-error list-icon"></i>
                            <span>{con}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>


                  <!-- Países Disponibles (Ubicación) -->
                  <div class="re_location_line">
                    <i class="fas fa-earth-americas"></i>
                    <div>
                      <strong>Países Disponibles:</strong> {p.paises}
                    </div>
                  </div>

                  <div class="re_requirements">
                    <strong><i class="fas fa-clipboard-list"></i> Requisitos de Postulación:</strong> {p.requisitos}
                  </div>
                </div>

                <!-- Columna Derecha: Círculos PageSpeed y Detalles de Soporte -->
                <div class="remoto_row_right">
                  
                  <!-- Fila de Puntuaciones al estilo PageSpeed de arriba -->
                  <div class="re_metrics_box">
                    <h4 class="re_metrics_title">Métricas de Evaluación</h4>
                    <div class="re_metrics_row">
                      <div class="re_metric_item">
                        <svg class="ps_circle_mini" viewBox="0 0 120 120">
                          <circle class={`ps_circle_track track_${getScoreClass(p.metrics.seguridad)}`} cx="60" cy="60" r="50" />
                          <circle class={`ps_circle_val ${getScoreClass(p.metrics.seguridad)}`} cx="60" cy="60" r="50" style={`stroke-dasharray: ${circumference}; stroke-dashoffset: ${getOffset(p.metrics.seguridad)};`} />
                          <text class={`ps_circle_text ${getScoreClass(p.metrics.seguridad)}`} x="60" y="60" dominant-baseline="middle" text-anchor="middle">{p.metrics.seguridad}</text>
                        </svg>
                        <span>Seguridad</span>
                      </div>
                      
                      <div class="re_metric_item">
                        <svg class="ps_circle_mini" viewBox="0 0 120 120">
                          <circle class={`ps_circle_track track_${getScoreClass(p.metrics.vacantes)}`} cx="60" cy="60" r="50" />
                          <circle class={`ps_circle_val ${getScoreClass(p.metrics.vacantes)}`} cx="60" cy="60" r="50" style={`stroke-dasharray: ${circumference}; stroke-dashoffset: ${getOffset(p.metrics.vacantes)};`} />
                          <text class={`ps_circle_text ${getScoreClass(p.metrics.vacantes)}`} x="60" y="60" dominant-baseline="middle" text-anchor="middle">{p.metrics.vacantes}</text>
                        </svg>
                        <span>Vacantes</span>
                      </div>
                      
                      <div class="re_metric_item">
                        <svg class="ps_circle_mini" viewBox="0 0 120 120">
                          <circle class={`ps_circle_track track_${getScoreClass(p.metrics.soporte)}`} cx="60" cy="60" r="50" />
                          <circle class={`ps_circle_val ${getScoreClass(p.metrics.soporte)}`} cx="60" cy="60" r="50" style={`stroke-dasharray: ${circumference}; stroke-dashoffset: ${getOffset(p.metrics.soporte)};`} />
                          <text class={`ps_circle_text ${getScoreClass(p.metrics.soporte)}`} x="60" y="60" dominant-baseline="middle" text-anchor="middle">{p.metrics.soporte}</text>
                        </svg>
                        <span>Soporte</span>
                      </div>
                      
                      <div class="re_metric_item">
                        <svg class="ps_circle_mini" viewBox="0 0 120 120">
                          <circle class={`ps_circle_track track_${getScoreClass(p.metrics.gratuito)}`} cx="60" cy="60" r="50" />
                          <circle class={`ps_circle_val ${getScoreClass(p.metrics.gratuito)}`} cx="60" cy="60" r="50" style={`stroke-dasharray: ${circumference}; stroke-dashoffset: ${getOffset(p.metrics.gratuito)};`} />
                          <text class={`ps_circle_text ${getScoreClass(p.metrics.gratuito)}`} x="60" y="60" dominant-baseline="middle" text-anchor="middle">{p.metrics.gratuito}</text>
                        </svg>
                        <span>Gratis</span>
                      </div>
                    </div>
                  </div>

                  <!-- Caja Vista Previa: Logo real + Opinión del Experto -->
                  <div class="re_card_preview_box">
                    <div class="re_logo_container">
                      <img src={p.logo} alt={p.nombre} />
                    </div>
                    <div class="re_expert_opinion">
                      <strong><i class="fas fa-user-tie"></i> Opinión del Experto</strong>
                      <p>{p.tipExperto}</p>
                    </div>
                  </div>

                  {p.evitarEstafas && (
                    <div class="re_safety_tip">
                      <strong><i class="fas fa-triangle-exclamation"></i> Evitar Estafas</strong>
                      <p>{p.evitarEstafas}</p>
                    </div>
                  )}

                  <div class="re_actions_row">
                    {p.guiaUrl ? (
                      <>
                        <a href={p.guiaUrl} class="re_btn_guide_main" title="Ver guía paso a paso de cómo postular">
                          <i class="fas fa-book-open"></i> Cómo Postular
                        </a>
                        <a href={p.url} target="_blank" rel="noopener noreferrer" class="re_btn_visit_main" title={`Ir al sitio oficial de ${p.nombre}`}>
                          <i class="fas fa-external-link-alt"></i> Sitio Web
                        </a>
                      </>
                    ) : (
                      <a href={p.url} target="_blank" rel="noopener noreferrer" class="re_btn_visit_main" title={`Ir al sitio oficial de ${p.nombre}`}>
                        <i class="fas fa-external-link-alt"></i> Visitar Sitio de {p.nombre}
                      </a>
                    )}
                  </div>
                </div>

              </article>
            );
          })}
        </section>

        <!-- Centro de Seguridad (Anti-Estafas) -->
        <section class="re_security">
          <h2><i class="fas fa-circle-exclamation"></i> Centro de Seguridad Anti-Fraude (Vigente 2026)</h2>
          <p>
            Las estafas de empleo remoto han crecido mucho en los últimos años. Utiliza esta lista rápida de comprobación para identificar ofertas fraudulentas antes de enviar tus datos personales:
          </p>
          
          <div class="re_sec_grid">
            <div class="re_sec_item">
              <i class="fas fa-sack-xmark"></i>
              <div>
                <strong>Nunca pagues por trabajar</strong>
                <p>Ninguna empresa legítima te pedirá dinero para "certificaciones", "trámites de ingreso" o para "enviarte las herramientas de trabajo". Si te piden pagar, es estafa.</p>
              </div>
            </div>

            <div class="re_sec_item">
              <i class="fas fa-envelope-open-text"></i>
              <div>
                <strong>Dominios de correo sospechosos</strong>
                <p>Los reclutadores de empresas serias te escribirán desde correos corporativos (ej. @google.com). Desconfía si te contactan desde @gmail.com o @outlook.com.</p>
              </div>
            </div>

            <div class="re_sec_item">
              <i class="fas fa-comments"></i>
              <div>
                <strong>Entrevistas solo por chat</strong>
                <p>Si la "entrevista" consiste en responder preguntas escritas por WhatsApp, Telegram o cuestionarios de Google Forms sin videollamada, no continúes.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Sección de Consejo Personal Empático (Reemplaza a PageSpeed 100/100) -->
        <section class="re_advice_sec" id="advice-section" data-id="advice-section">
          <div class="re_advice_card">
            <h2 class="re_advice_title">
              <i class="fas fa-heart-circle-check"></i>
              <span class="gradient_text">Si llegaste hasta aquí: esto es lo que yo haría en tu lugar</span>
            </h2>
            <p class="re_advice_subtitle">
              Buscar empleo remoto puede ser agotador y confuso en 2026. Si yo estuviera en tu posición buscando trabajo hoy mismo, no gastaría mi energía postulando a ciegas en las diez plataformas a la vez. Sería estratégico y enfocaría mi tiempo en estas 3 opciones clave:
            </p>

            <div class="re_advice_list">
              <!-- Item 1: We Work Remotely -->
              <div class="re_advice_item">
                <div class="re_advice_num" style="background: linear-gradient(135deg, var(--mco) 0%, color-mix(in srgb, var(--mco) 70%, #000) 100%); color: #fff;">1</div>
                <div class="re_advice_item_content">
                  <h3 class="re_advice_item_title">We Work Remotely (Nuestra recomendada #1)</h3>
                  <p class="re_advice_reason">
                    Es la bolsa de trabajo gratuito más confiable del mundo para candidatos. Como las empresas pagan $299 por publicar, te aseguras de que no existen ofertas falsas ni estafas. Es el lugar ideal para programadores, diseñadores y perfiles digitales.
                  </p>
                  <p class="re_advice_gold_tip">
                    <strong>Consejo de Oro:</strong> Las ofertas de calidad reciben cientos de aplicantes en horas. Entra todos los días a la misma hora, filtra por "Worldwide" y postula únicamente a los listados que tengan menos de 24 horas de publicados.
                  </p>
                </div>
              </div>

              <!-- Item 2: Pros Marketplace -->
              <div class="re_advice_item">
                <div class="re_advice_num" style="background: linear-gradient(135deg, var(--success) 0%, color-mix(in srgb, var(--success) 70%, #000) 100%); color: #fff;">2</div>
                <div class="re_advice_item_content">
                  <h3 class="re_advice_item_title">Pros Marketplace (Ideal para Latinoamérica)</h3>
                  <p class="re_advice_reason">
                    Si resides en LATAM, esta plataforma es un puente directo a empresas en Estados Unidos. Lo mejor de todo es que te guían en el proceso y te aseguran contratos B2B estables pagados directamente en dólares, adaptándose a tu zona horaria local.
                  </p>
                  <p class="re_advice_gold_tip">
                    <strong>Consejo de Oro:</strong> Tómate muy en serio la grabación de tu video de introducción de un minuto. Una buena iluminación y un inglés conversacional fluido te conseguirán entrevistas automáticas antes de que lean tu currículum.
                  </p>
                </div>
              </div>

              <!-- Item 3: FlexJobs -->
              <div class="re_advice_item">
                <div class="re_advice_num" style="background: linear-gradient(135deg, var(--warning) 0%, color-mix(in srgb, var(--warning) 70%, #000) 100%); color: #000; font-weight: 900;">3</div>
                <div class="re_advice_item_content">
                  <h3 class="re_advice_item_title">FlexJobs (La mejor opción de pago)</h3>
                  <p class="re_advice_reason">
                    Aunque requiere una suscripción mensual, vale totalmente la pena si quieres evitar al 100% ofertas basura o dudosas. Cada oferta es revisada manualmente por un equipo de personas reales para garantizar tu seguridad.
                  </p>
                  <p class="re_advice_gold_tip">
                    <strong>Consejo de Oro:</strong> Contrata su suscripción de prueba de una semana (es muy económica), descarga las vacantes directas de las páginas corporativas y ponte en contacto con los reclutadores directamente en LinkedIn.
                  </p>
                </div>
              </div>
            </div>

            <p class="re_advice_closing">
              "La clave del éxito en el trabajo remoto no es postular de forma masiva, sino la especificidad. Elige tus batallas, optimiza tu CV con IA para pasar los filtros ATS de estas plataformas, y sé de los primeros en enviar tu solicitud. ¡Tú puedes, mucho éxito en tu camino!"
            </p>
          </div>
        </section>


      </div>
    </div>

  </div>

  <!-- Script de Interactividad (Buscador, Collapse y ScrollSpy Reactivo) -->
  <script is:inline>
    const initPage = () => {
      const toggleBtn = document.getElementById('toggle-sidebar');
      const layout = document.getElementById('remoto-layout');
      const searchInput = document.getElementById('re-search');
      const cards = document.querySelectorAll('.remoto_horizontal_row');
      const spyTargets = document.querySelectorAll('.remoto_horizontal_row, .re_advice_sec');
      const sidebarItems = document.querySelectorAll('.sidebar_item');
      const searchCount = document.querySelector('.re_search_count');
      const emptyMsg = document.getElementById('re-empty-msg');


      // 1. Sidebar Collapse (Persistente con localStorage)
      if (toggleBtn && layout) {
        const isCollapsed = localStorage.getItem('wiRemotosSidebarCollapsed') === 'true';
        if (isCollapsed) {
          layout.classList.add('sidebar-collapsed');
        }

        toggleBtn.addEventListener('click', () => {
          layout.classList.toggle('sidebar-collapsed');
          const nowCollapsed = layout.classList.contains('sidebar-collapsed');
          localStorage.setItem('wiRemotosSidebarCollapsed', nowCollapsed.toString());
        });
      }

      // 2. Buscador Reactivo en Tiempo Real
      if (searchInput) {
        searchInput.addEventListener('input', () => {
          const q = searchInput.value.toLowerCase().trim();
          let vis = 0;

          cards.forEach(card => {
            const nom = card.getAttribute('data-id').toLowerCase();
            const cat = card.getAttribute('data-cat').toLowerCase();
            const title = card.querySelector('h3').textContent.toLowerCase();
            const desc = card.querySelector('.remoto_row_desc').textContent.toLowerCase();
            
            const match = !q || title.includes(q) || desc.includes(q) || cat.includes(q) || nom.includes(q);
            
            if (match) {
              card.classList.remove('hidden');
              vis++;
            } else {
              card.classList.add('hidden');
            }

            // Filtrar también el índice de la barra lateral
            const id = card.getAttribute('data-id');
            const sideItem = document.querySelector(`.sidebar_item[data-id="${id}"]`);
            if (sideItem) {
              if (match) {
                sideItem.style.display = '';
              } else {
                sideItem.style.display = 'none';
              }
            }
          });

          if (searchCount) {
            searchCount.textContent = `${vis} plataforma${vis !== 1 ? 's' : ''}`;
          }

          if (emptyMsg) {
            emptyMsg.style.display = vis === 0 ? 'block' : 'none';
          }
        });
      }

      // 3. ScrollSpy con IntersectionObserver (Alto Rendimiento)
      const spyOptions = {
        root: null,
        rootMargin: '-15% 0px -70% 0px',
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('data-id');
            sidebarItems.forEach(item => {
              item.classList.toggle('active', item.getAttribute('data-id') === id);
            });
          }
        });
      }, spyOptions);

      spyTargets.forEach(target => observer.observe(target));

      // Sincronizar ScrollSpy al llegar al final de la página (para viewports altos)
      window.addEventListener('scroll', () => {
        if ((window.innerHeight + window.scrollY) >= document.documentElement.scrollHeight - 60) {
          sidebarItems.forEach(item => {
            item.classList.toggle('active', item.getAttribute('data-id') === 'advice-section');
          });
        }
      });


      // 4. Scroll Suave al hacer clic en ítems del índice
      sidebarItems.forEach(item => {
        item.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = item.getAttribute('href');
          const targetEl = document.querySelector(targetId);
          if (targetEl) {
            const headerOffset = 90; // Evita solapamiento con el header fijo
            const elementPosition = targetEl.getBoundingClientRect().top + window.scrollY;
            const offsetPosition = elementPosition - headerOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        });
      });
    };

    // Inicializar en carga y tras cambios de página por Astro transitions
    initPage();
    document.addEventListener('astro:after-swap', initPage);
  </script>
</Layout>
