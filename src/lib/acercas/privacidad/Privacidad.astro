---
import Layout from '../../../layouts/Layout.astro';
import { app } from '../../../wii.js';
import { seo } from '../../../lib/seo.js';
import { idiomaPrivacidad } from './idiomaPrivacidad.js';
import estilosAcercas from '../acercas.css?inline';

const { lang = 'es' } = Astro.props as { lang?: 'es' | 'en' };
const t = (idiomaPrivacidad as any)[lang] || idiomaPrivacidad['es'];
const currentYear = new Date().getFullYear();

const route = (path: string) => lang === 'en' ? `/en${path}` : path;
---

<style is:global set:html={estilosAcercas}></style>

<Layout {...(lang === 'en' ? (seo.privacidad as any).en : (seo.privacidad as any).es)}>
<div class="ac_wrap tm_wrap">

  <!-- ══ HERO ══ -->
  <section class="ac_hero tm_hero">
    <div class="ac_hero_orb ac_orb1"></div>
    <div class="ac_hero_orb ac_orb2"></div>
    <div class="ac_hero_orb ac_orb3"></div>
    <div class="ac_hero_body">
      <div class="ac_hero_badge"><i class="fas fa-lock"></i> {t.hero.badge}</div>
      <h1 class="ac_hero_tit">{t.hero.tit1}<br><span class="ac_grad">{t.hero.titGrad}</span></h1>
      <p class="ac_hero_sub" set:html={t.hero.sub}></p>
      <div class="tm_hero_chips">
        <span class="tm_chip"><i class="fas fa-ban"></i> {t.hero.chip1}</span>
        <span class="tm_chip"><i class="fas fa-eye-slash"></i> {t.hero.chip2}</span>
        <span class="tm_chip"><i class="fas fa-shield-halved"></i> {t.hero.chip3}</span>
      </div>
      <div class="tm_last_upd">
        <i class="fas fa-calendar-check"></i>
        {t.hero.lastUpd} {currentYear}
      </div>
    </div>
  </section>

  <!-- ══ ÍNDICE RÁPIDO ══ -->
  <div class="tm_index_band">
    {t.indices.map((idx: any) => (
      <a href={`#${idx.id}`} class="tm_index_item">
        <i class={idx.ico} style={`color:${idx.color}`}></i>
        <span>{idx.txt}</span>
      </a>
    ))}
  </div>

  <!-- ══ SECCIONES ══ -->
  <section class="ac_sec tm_secciones">
    <div class="ac_sec_head">
      <div class="ac_sec_badge"><i class="fas fa-shield-halved"></i> {t.sections.badge}</div>
      <h2 class="ac_sec_tit">{t.sections.tit}<span class="ac_grad">{t.sections.titGrad}</span></h2>
      <p class="ac_sec_sub">{t.sections.sub}</p>
    </div>
    <div class="tm_secs_grid">
      <!-- 01 -->
      <div class="tm_sec_card wi_fadeUp" id="tm_sec_0">
        <div class="tm_sec_header">
          <div class="tm_sec_ico" style="--tc:#0EBEFF"><i class="fas fa-database"></i></div>
          <div>
            <span class="tm_sec_num" style="color:#0EBEFF">01</span>
            <h2 class="tm_sec_tit">{t.sections.s1_tit}</h2>
          </div>
        </div>
        <div class="tm_sec_body">
          <p>{t.sections.s1_desc}</p>
          <ul class="tm_list">
            <li set:html={t.sections.s1_item1}></li>
            <li set:html={t.sections.s1_item2}></li>
            <li set:html={t.sections.s1_item3}></li>
            <li set:html={t.sections.s1_item4}></li>
          </ul>
          <div class="tm_alert">
            <i class="fas fa-heart"></i>
            <p>{t.sections.s1_warning}</p>
          </div>
        </div>
      </div>

      <!-- 02 -->
      <div class="tm_sec_card wi_fadeUp" id="tm_sec_1">
        <div class="tm_sec_header">
          <div class="tm_sec_ico" style="--tc:#29C72E"><i class="fas fa-gear"></i></div>
          <div>
            <span class="tm_sec_num" style="color:#29C72E">02</span>
            <h2 class="tm_sec_tit">{t.sections.s2_tit}</h2>
          </div>
        </div>
        <div class="tm_sec_body">
          <p>{t.sections.s2_desc}</p>
          <ul class="tm_list">
            <li><i class="fas fa-check"></i>{t.sections.s2_item1}</li>
            <li><i class="fas fa-check"></i>{t.sections.s2_item2}</li>
            <li><i class="fas fa-check"></i>{t.sections.s2_item3}</li>
            <li><i class="fas fa-check"></i>{t.sections.s2_item4}</li>
            <li><i class="fas fa-check"></i>{t.sections.s2_item5}</li>
          </ul>
        </div>
      </div>

      <!-- 03 -->
      <div class="tm_sec_card wi_fadeUp" id="tm_sec_2">
        <div class="tm_sec_header">
          <div class="tm_sec_ico" style="--tc:#FF5C69"><i class="fas fa-bullhorn"></i></div>
          <div>
            <span class="tm_sec_num" style="color:#FF5C69">03</span>
            <h2 class="tm_sec_tit">{t.sections.s3_tit}</h2>
          </div>
        </div>
        <div class="tm_sec_body">
          <p set:html={t.sections.s3_desc}></p>
          <ul class="tm_list">
            <li set:html={t.sections.s3_item1}></li>
            <li set:html={t.sections.s3_item2}></li>
            <li set:html={t.sections.s3_item3}></li>
            <li set:html={t.sections.s3_item4}></li>
          </ul>
          <div class="tm_alert">
            <i class="fas fa-info-circle"></i>
            <p set:html={t.sections.s3_warning}></p>
          </div>
        </div>
      </div>

      <!-- 04 -->
      <div class="tm_sec_card wi_fadeUp" id="tm_sec_3">
        <div class="tm_sec_header">
          <div class="tm_sec_ico" style="--tc:#7000FF"><i class="fas fa-share-nodes"></i></div>
          <div>
            <span class="tm_sec_num" style="color:#7000FF">04</span>
            <h2 class="tm_sec_tit">{t.sections.s4_tit}</h2>
          </div>
        </div>
        <div class="tm_sec_body">
          <p>{t.sections.s4_desc}</p>
          <ul class="tm_list">
            <li set:html={t.sections.s4_item1}></li>
            <li set:html={t.sections.s4_item2}></li>
            <li set:html={t.sections.s4_item3}></li>
          </ul>
          <p>{t.sections.s4_footer}</p>
        </div>
      </div>

      <!-- 05 -->
      <div class="tm_sec_card wi_fadeUp" id="tm_sec_4">
        <div class="tm_sec_header">
          <div class="tm_sec_ico" style="--tc:#FFDA34"><i class="fas fa-cookie-bite"></i></div>
          <div>
            <span class="tm_sec_num" style="color:#FFDA34">05</span>
            <h2 class="tm_sec_tit">{t.sections.s5_tit}</h2>
          </div>
        </div>
        <div class="tm_sec_body">
          <p set:html={t.sections.s5_desc}></p>
