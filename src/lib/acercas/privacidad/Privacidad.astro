          </ul>
        </div>
      </div>

      <!-- 06 -->
      <div class="tm_sec_card wi_fadeUp" id="tm_sec_5">
        <div class="tm_sec_header">
          <div class="tm_sec_ico" style="--tc:#0EBEFF"><i class="fas fa-user-lock"></i></div>
          <div>
            <span class="tm_sec_num" style="color:#0EBEFF">06</span>
            <h2 class="tm_sec_tit">{t.sections.s6_tit}</h2>
          </div>
        </div>
        <div class="tm_sec_body">
          <p>{t.sections.s6_desc}</p>
          <ul class="tm_list">
            <li set:html={t.sections.s6_item1}></li>
            <li set:html={t.sections.s6_item2}></li>
            <li set:html={t.sections.s6_item3}></li>
            <li set:html={t.sections.s6_item4}></li>
            <li set:html={t.sections.s6_item5}></li>
          </ul>
          <div class="tm_alert">
            <i class="fas fa-envelope"></i>
            <p set:html={t.sections.s6_warning}></p>
          </div>
        </div>
      </div>

      <!-- 07 -->
      <div class="tm_sec_card wi_fadeUp" id="tm_sec_6">
        <div class="tm_sec_header">
          <div class="tm_sec_ico" style="--tc:#29C72E"><i class="fas fa-shield-halved"></i></div>
          <div>
            <span class="tm_sec_num" style="color:#29C72E">07</span>
            <h2 class="tm_sec_tit">{t.sections.s7_tit}</h2>
          </div>
        </div>
        <div class="tm_sec_body">
          <p>{t.sections.s7_desc}</p>
          <ul class="tm_list">
            <li><i class="fas fa-check"></i>{t.sections.s7_item1}</li>
            <li><i class="fas fa-check"></i>{t.sections.s7_item2}</li>
            <li><i class="fas fa-check"></i>{t.sections.s7_item3}</li>
            <li><i class="fas fa-check"></i>{t.sections.s7_item4}</li>
          </ul>
        </div>
      </div>

      <!-- 08 -->
      <div class="tm_sec_card wi_fadeUp" id="tm_sec_7">
        <div class="tm_sec_header">
          <div class="tm_sec_ico" style="--tc:#FF5C69"><i class="fas fa-child"></i></div>
          <div>
            <span class="tm_sec_num" style="color:#FF5C69">08</span>
            <h2 class="tm_sec_tit">{t.sections.s8_tit}</h2>
          </div>
        </div>
        <div class="tm_sec_body">
          <p>{t.sections.s8_desc}</p>
          <ul class="tm_list">
            <li><i class="fas fa-check"></i>{t.sections.s8_item1}</li>
            <li><i class="fas fa-check"></i>{t.sections.s8_item2}</li>
            <li><i class="fas fa-check"></i>{t.sections.s8_item3}</li>
          </ul>
        </div>
      </div>

      <!-- 09 -->
      <div class="tm_sec_card wi_fadeUp" id="tm_sec_8">
        <div class="tm_sec_header">
          <div class="tm_sec_ico" style="--tc:#7000FF"><i class="fas fa-rotate"></i></div>
          <div>
            <span class="tm_sec_num" style="color:#7000FF">09</span>
            <h2 class="tm_sec_tit">{t.sections.s9_tit}</h2>
          </div>
        </div>
        <div class="tm_sec_body">
          <p>{t.sections.s9_desc}</p>
          <div class="tm_alert">
            <i class="fas fa-calendar-check"></i>
            <p>
              {t.sections.s9_warning}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <section class="ac_cta_sec">
    <div class="ac_cta_wrap wi_fadeUp">
      <div class="ac_hero_orb ac_orb1"></div>
      <div class="ac_hero_orb ac_orb2"></div>
      <div class="ac_cta_glow"></div>
      <div class="ac_cta_inner">
        <span class="ac_cta_emoji">🔒</span>
        <h2>{t.cta.tit}</h2>
        <p>{t.cta.sub}</p>
        <div class="ac_cta_btns">
          <a href="mailto:wilder.taype@hotmail.com" class="ac_btn_p ac_btn_lg">
            <i class="fas fa-envelope"></i> {t.cta.btnContacto}
          </a>
          <a href={route('/terminos')} class="ac_btn_s ac_btn_lg tm_nav">
            <i class="fas fa-file-contract"></i> {t.cta.btnTerminos}
          </a>
        </div>
      </div>
    </div>
  </section>

</div>
</Layout>

<script is:inline>
const initPrivacidad = () => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.wi_fadeUp').forEach(el => {
    observer.observe(el);
  });

  document.querySelectorAll('.tm_index_item').forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const href = this.getAttribute('href');
      const target = document.querySelector(href);
      if (target) {
        window.scrollTo({ 
          top: target.getBoundingClientRect().top + window.scrollY - 90, 
          behavior: 'smooth' 
        });
      }
    });
  });

  console.log('🔒 Privacy ready');
  window.__WIREADY__ = true;
};

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initPrivacidad);
} else {
  initPrivacidad();
}
</script>
