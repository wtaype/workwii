<style>
  .lab_spy_link.active {
    background: var(--bg3) !important;
    color: var(--mco) !important;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }
</style>

<script>
  import { 
    Saludar, 
    wiTip, 
    herowi, 
    showi, 
    wiVista, 
    wiFade, 
    wicopy, 
    year,
    wiDate,
    fechaHoy, 
    formatearFechaParaInput,
    formatearFechaHora,
    wiTiempo, 
    calcMeses, 
    imgwii,
    Mensaje,
    abrirModal,
    cerrarModal,
    cerrarTodos,
    wiPath,
    Capit,
    NombreApellido,
    getNombre,
    avatar,
    Notificacion,
    wiRateLimit,
    wiScroll,
    setMeta,
    wiSpin,
    savels,
    getls,
    removels,
    superFun,
    Capi,
    mis10,
    minus,
    wiCode,
    wiIp,
    wiSuma,
    adtm,
    wiSmart,
    wiMd,
    langwii
  } from '../widev/widev.js';
  import { wiAuth } from '../wiauth/sesion.js';

  const initLab = () => {
    // 1. Ejecutar Saludo
    const saludoEl = document.getElementById('lab_saludo');
    if (saludoEl) {
      saludoEl.textContent = Saludar('Wilder');
    }

    // 2. Inicializar Tooltips, Animaciones e Imágenes
    try {
      wiTip();
      herowi();
      showi();
      imgwii.ver();
      
      // 3. Inicializar wiVista
      wiVista('.lab_vista_item', (el: Element, idx: number) => {
        console.log(`🧪 [wiVista] Elemento index [${idx}] visible en pantalla:`, el.textContent);
      }, { anim: 'wi_visible', threshold: 0.2 });

      // 4. Configurar botón para wiFade
      const btnFade = document.getElementById('btn_fade');
      const fadeTarget = document.getElementById('fade_target');
      if (btnFade && fadeTarget) {
        const newBtn = btnFade.cloneNode(true);
        btnFade.parentNode?.replaceChild(newBtn, btnFade);

        newBtn.addEventListener('click', async () => {
          const isOriginal = fadeTarget.textContent.trim().toLowerCase().includes('original');
          const newHtml = isOriginal
            ? langwii.n('✨ ¡Cambiado suavemente con wiFade!', '✨ Swapped smoothly with wiFade!')
            : langwii.n('Texto original (wiFade)', 'Original text (wiFade)');
          
          await wiFade(fadeTarget, newHtml, 150);
        });
      }

      // 5. Configurar botón para @starting-style
      const btnAddAlert = document.getElementById('btn_add_alert');
      const alertContainer = document.getElementById('alert_container');
      if (btnAddAlert && alertContainer) {
        const newBtnAlert = btnAddAlert.cloneNode(true);
        btnAddAlert.parentNode?.replaceChild(newBtnAlert, btnAddAlert);

        newBtnAlert.addEventListener('click', () => {
          const alert = document.createElement('div');
          alert.className = 'lab_alert_starting';
          alert.textContent = langwii.n(
            '✨ ¡Nueva alerta animada nativamente con CSS @starting-style!',
            '✨ New alert animated natively with CSS @starting-style!'
          );
          
          alertContainer.appendChild(alert);

          // Remover la alerta después de unos segundos
          setTimeout(() => {
            alert.style.opacity = '0';
            alert.style.transform = 'scale(0.9)';
            setTimeout(() => alert.remove(), 400);
          }, 3000);
        });
      }

      // 6. Configurar wicopy
      const btnCopyInput = document.getElementById('btn_copy_input');
      if (btnCopyInput) {
        const newBtnCopy = btnCopyInput.cloneNode(true);
        btnCopyInput.parentNode?.replaceChild(newBtnCopy, btnCopyInput);
        
        newBtnCopy.addEventListener('click', (e) => {
          wicopy('#input_copy_demo', e.currentTarget as any);
        });
      }

      // 7. Inyectar datos de fechas (Lista completa de 7 funciones)
      const txtYear = document.getElementById('txt_year');
      if (txtYear) {
        txtYear.textContent = String(year());
      }

      const txtFechaHoy = document.getElementById('txt_fecha_hoy');
      if (txtFechaHoy) {
        txtFechaHoy.textContent = fechaHoy();
      }

      const txtTiempoRel = document.getElementById('txt_tiempo_rel');
      if (txtTiempoRel) {
        txtTiempoRel.textContent = wiTiempo(Date.now() - 120000); // hace 2 min
      }

      const txtMesesDiff = document.getElementById('txt_meses_diff');
      if (txtMesesDiff) {
        txtMesesDiff.textContent = String(calcMeses('2026-01-01'));
      }

      const txtFechaHora = document.getElementById('txt_fecha_hora');
      if (txtFechaHora) {
        txtFechaHora.textContent = formatearFechaHora(new Date());
      }

      const txtFechaInput = document.getElementById('txt_fecha_input');
      if (txtFechaInput) {
        txtFechaInput.textContent = formatearFechaParaInput(new Date());
      }

      const txtWiDateMock = document.getElementById('txt_widate_mock');
      if (txtWiDateMock) {
        // Simulamos un Timestamp de Firebase (seconds y nanoseconds)
        const mockFirebaseTimestamp = { seconds: Math.floor(Date.now() / 1000) };
        const dummyDb = { fromDate: (d: Date) => d.toISOString() }; // Mock DB interface
        const dateHelper = wiDate(dummyDb);
        txtWiDateMock.textContent = dateHelper.get(mockFirebaseTimestamp, 'full');
      }

      // 8. Configurar Toasts (Mensaje)
      document.querySelectorAll('.btn-toast').forEach(btn => {
        const newBtn = btn.cloneNode(true);
        btn.parentNode?.replaceChild(newBtn, btn);
        
        newBtn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const tipo = target.getAttribute('data-tipo') || 'success';
          Mensaje(
            langwii.n(
              `¡Éxito! Alerta flotante de tipo ${tipo} disparada.`,
              `Success! Triggered a dynamic ${tipo} notification.`
            ),
            tipo
          );
        });
      });

      // 9. Configurar Modales
      const btnOpenModal = document.getElementById('btn_open_modal');
      if (btnOpenModal) {
        const newBtn = btnOpenModal.cloneNode(true);
        btnOpenModal.parentNode?.replaceChild(newBtn, btnOpenModal);
        newBtn.addEventListener('click', () => abrirModal('lab_test_modal'));
      }
      
      const btnModalSave = document.getElementById('btn_modal_save');
      if (btnModalSave) {
        const newBtn = btnModalSave.cloneNode(true);
        btnModalSave.parentNode?.replaceChild(newBtn, btnModalSave);
        newBtn.addEventListener('click', () => {
          Mensaje(
            langwii.n('¡Ajustes guardados con éxito!', 'Settings saved successfully!'), 
            'success'
          );
          cerrarTodos();
        });
      }

      // 10. Configurar Rutas (wiPath)
      const txtPathActual = document.getElementById('txt_wipath_actual');
      const txtPathParams = document.getElementById('txt_wipath_params');
      
      const updateRouteInfo = () => {
        if (txtPathActual) txtPathActual.textContent = wiPath.actual;
        if (txtPathParams) txtPathParams.textContent = JSON.stringify(wiPath.params());
      };
      
      updateRouteInfo();
      window.removeEventListener('popstate', updateRouteInfo);
      window.addEventListener('popstate', updateRouteInfo);

      const btnSimularRuta = document.getElementById('btn_simular_ruta');
      if (btnSimularRuta) {
        const newBtn = btnSimularRuta.cloneNode(true);
        btnSimularRuta.parentNode?.replaceChild(newBtn, btnSimularRuta);
        newBtn.addEventListener('click', () => {
          const rand = Math.floor(Math.random() * 100);
          wiPath.poner(`${wiPath.actual}?user=wilder&rand=${rand}`);
        });
      }

      // 11. Configurar Formateador de Nombres
      const inputNombreDemo = document.getElementById('input_nombre_demo') as HTMLInputElement;
      const txtNombreCapit = document.getElementById('txt_nombre_capit');
      const txtNombreCompleto = document.getElementById('txt_nombre_completo');
      const txtNombreGet = document.getElementById('txt_nombre_get');
      const txtNombreAvatar = document.getElementById('txt_nombre_avatar');
      
      const updateNameDemo = () => {
        if (inputNombreDemo) {
          const val = inputNombreDemo.value;
          if (txtNombreCapit) txtNombreCapit.textContent = Capit(val);
          if (txtNombreCompleto) txtNombreCompleto.textContent = NombreApellido(val);
          if (txtNombreGet) txtNombreGet.textContent = getNombre(val);
          if (txtNombreAvatar) txtNombreAvatar.textContent = avatar(val);
        }
      };
      
      if (inputNombreDemo) {
        const newBtn = inputNombreDemo.cloneNode(true);
        inputNombreDemo.parentNode?.replaceChild(newBtn, inputNombreDemo);
        newBtn.addEventListener('input', (e) => {
          const target = e.currentTarget as HTMLInputElement;
          const val = target.value;
          if (txtNombreCapit) txtNombreCapit.textContent = Capit(val);
          if (txtNombreCompleto) txtNombreCompleto.textContent = NombreApellido(val);
          if (txtNombreGet) txtNombreGet.textContent = getNombre(val);
          if (txtNombreAvatar) txtNombreAvatar.textContent = avatar(val);
        });
      }
      updateNameDemo();

      // 12. Configurar Notificaciones Apilables (Notificacion)
      document.querySelectorAll('.btn-notif').forEach(btn => {
        const newBtn = btn.cloneNode(true);
        btn.parentNode?.replaceChild(newBtn, btn);
        
        newBtn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const tipo = target.getAttribute('data-tipo') || 'success';
          Notificacion(
            langwii.n(
              `¡Éxito! Banner de notificación de tipo ${tipo} disparado.`,
              `Success! Triggered a dynamic ${tipo} notification banner.`
            ),
            tipo
          );
        });
      });

      // 13. Configurar Rate Limiter (wiRateLimit)
      const btnRateLimitTrigger = document.getElementById('btn_ratelimit_trigger');
      const btnRateLimitReset = document.getElementById('btn_ratelimit_reset');
      const txtRateLimitRemaining = document.getElementById('txt_ratelimit_remaining');
      
      const updateAttempts = (remaining: number) => {
        if (txtRateLimitRemaining) {
          txtRateLimitRemaining.textContent = String(remaining);
          if (remaining === 0) {
            txtRateLimitRemaining.style.color = 'var(--error)';
          } else {
            txtRateLimitRemaining.style.color = 'var(--success)';
          }
        }
      };
      
      if (btnRateLimitTrigger) {
        const newBtn = btnRateLimitTrigger.cloneNode(true);
        btnRateLimitTrigger.parentNode?.replaceChild(newBtn, btnRateLimitTrigger);
        newBtn.addEventListener('click', () => {
          const limit = wiRateLimit('lab_click_limit', 3, 60000 as any);
          
          if (!limit.ok) {
            Mensaje(
              langwii.n(
                `¡Límite alcanzado! Bloqueado por ${limit.min} min.`,
                `Limit reached! Locked for ${limit.min} min.`
              ),
              'error'
            );
            updateAttempts(0);
            return;
          }
          
          limit.fail();
          
          const s = JSON.parse(localStorage.getItem('limiteHoy_lab_click_limit') || '{}');
          const currentAttempts = s.n || 0;
          const remaining = Math.max(0, 3 - currentAttempts);
          
          updateAttempts(remaining);
          
          if (remaining === 0) {
            Mensaje(
              langwii.n('¡Bloqueado! Excediste el límite.', 'Locked! You hit the limit.'), 
              'warning'
            );
          } else {
            Mensaje(
              langwii.n(
                `Acción registrada. Restantes: ${remaining}`,
                `Action counted. Remaining: ${remaining}`
              ), 
              'info'
            );
          }
        });
      }
      
      if (btnRateLimitReset) {
        const newBtn = btnRateLimitReset.cloneNode(true);
        btnRateLimitReset.parentNode?.replaceChild(newBtn, btnRateLimitReset);
        newBtn.addEventListener('click', () => {
          localStorage.removeItem('limiteHoy_lab_click_limit');
          updateAttempts(3);
          Mensaje(langwii.n('¡Limitador reseteado!', 'Limiter reset!'), 'success');
        });
      }
      
      const getInitialAttempts = () => {
        try {
          const item = localStorage.getItem('limiteHoy_lab_click_limit');
          if (item) {
            const s = JSON.parse(item);
            if (Date.now() < s.bloqueadoHasta) {
              updateAttempts(0);
              return;
            }
            updateAttempts(Math.max(0, 3 - (s.n || 0)));
          } else {
            updateAttempts(3);
          }
        } catch(e) {}
      };
      getInitialAttempts();

      // 14. Configurar Scroll Spy (wiScroll)
      const spyContainer = document.getElementById('spy_scroll_container');
      if (spyContainer) {
        wiScroll(
          ['lab_sec_demo1', 'lab_sec_demo2'],
          '.lab_spy_link',
          {
            root: spyContainer,
            margin: '0px 0px -50% 0px',
            cls: 'active'
          }
        );
      }

      // 15. Configurar SEO y Metadatos (setMeta)
      const btnSimularSeo = document.getElementById('btn_simular_seo');
      const txtSeoTitle = document.getElementById('txt_seo_title');
      
      const updateSeoInfo = () => {
        if (txtSeoTitle) txtSeoTitle.textContent = document.title;
      };
      updateSeoInfo();

      if (btnSimularSeo) {
        const newBtn = btnSimularSeo.cloneNode(true);
        btnSimularSeo.parentNode?.replaceChild(newBtn, btnSimularSeo);
        newBtn.addEventListener('click', () => {
          setMeta({
            title: langwii.n('Artículo de Test de Super SEO', 'Super SEO Test Article'),
            desc: langwii.n('Simulación de SEO dinámico de artículo', 'Simulated dynamic article SEO'),
            path: '/lab/seo-test',
            type: 'Article',
            datePublished: new Date().toISOString() as any
          });
          updateSeoInfo();
          
          Mensaje(
            langwii.n(
              '¡Meta schema de SEO dinámico generado en el head!',
              'SEO schema dynamic meta generated in head!'
            ),
            'success'
          );
        });
      }

      // 16. Configurar Button Spinner (wiSpin)
      const btnSpinDemo = document.getElementById('btn_spin_demo');
      if (btnSpinDemo) {
        const newBtn = btnSpinDemo.cloneNode(true);
        btnSpinDemo.parentNode?.replaceChild(newBtn, btnSpinDemo);
        newBtn.addEventListener('click', () => {
          wiSpin(newBtn, true, langwii.n('Enviando...', 'Sending...'));
          
          setTimeout(() => {
            wiSpin(newBtn, false);
            Mensaje(
              langwii.n('¡Proceso finalizado!', 'Process complete!'),
              'success'
            );
          }, 2000);
        });
      }

      // 17. Configurar Almacenamiento (storage.js)
      const btnStorageSave = document.getElementById('btn_storage_save');
      const btnStorageRead = document.getElementById('btn_storage_read');
      const txtStorageState = document.getElementById('txt_storage_state');
      
      if (btnStorageSave) {
        const newBtn = btnStorageSave.cloneNode(true);
        btnStorageSave.parentNode?.replaceChild(newBtn, btnStorageSave);
        newBtn.addEventListener('click', () => {
          const val = Math.floor(Math.random() * 1000);
          savels('lab_temp_data', { score: val }, 0.00138); // ~5 segundos (5/3600 horas)
          if (txtStorageState) {
            txtStorageState.textContent = langwii.n(
              `Guardado: ${val} (Expira en 5s)`,
              `Saved: ${val} (Expires in 5s)`
            );
            txtStorageState.style.color = 'var(--mco)';
          }
          Mensaje(langwii.n('¡Dato guardado en localStorage!', 'Value saved in localStorage!'), 'success');
        });
      }
      
      if (btnStorageRead) {
        const newBtn = btnStorageRead.cloneNode(true);
        btnStorageRead.parentNode?.replaceChild(newBtn, btnStorageRead);
        newBtn.addEventListener('click', () => {
          const data = getls('lab_temp_data');
          if (txtStorageState) {
            if (data) {
              txtStorageState.textContent = langwii.n(
                `Leído: ${JSON.stringify(data)}`,
                `Read: ${JSON.stringify(data)}`
              );
              txtStorageState.style.color = 'var(--success)';
            } else {
              txtStorageState.textContent = langwii.n(
                'Expiró o sin datos',
                'Expired or no data'
              );
              txtStorageState.style.color = 'var(--error)';
            }
          }
        });
      }

      // 18. Configurar Carga Diferida (superFun)
      const btnSuperFunTrigger = document.getElementById('btn_superfun_trigger');
      const txtSuperFunStatus = document.getElementById('txt_superfun_status');
      
      if (btnSuperFunTrigger) {
        const newBtn = btnSuperFunTrigger.cloneNode(true);
        btnSuperFunTrigger.parentNode?.replaceChild(newBtn, btnSuperFunTrigger);
        newBtn.addEventListener('click', () => {
          localStorage.removeItem('superFun');
          if (txtSuperFunStatus) {
            txtSuperFunStatus.textContent = langwii.n(
              '¡Encolado! Haz scroll, clic o mueve el mouse para disparar...',
              'Enqueued! Scroll, click or move mouse to trigger...'
            );
            txtSuperFunStatus.style.color = 'var(--warning)';
          }
          
          superFun(() => {
            if (txtSuperFunStatus) {
              txtSuperFunStatus.textContent = langwii.n(
                '⚡ ¡Script pesado ejecutado con éxito!',
                '⚡ Executed heavy script successfully!'
              );
              txtSuperFunStatus.style.color = 'var(--success)';
            }
            Mensaje(
              langwii.n('¡SuperFun ejecutado!', 'SuperFun executed!'), 
              'success'
            );
          });
        });
      }

      // 19. Configurar Utilidades de Texto (texto.js)
      const inputTextoMinus = document.getElementById('input_texto_minus') as HTMLInputElement;
      const txtTextoMis10 = document.getElementById('txt_texto_mis10');
      
      if (inputTextoMinus) {
        const newBtn = inputTextoMinus.cloneNode(true) as HTMLInputElement;
        inputTextoMinus.parentNode?.replaceChild(newBtn, inputTextoMinus);
        minus(newBtn);
        
        newBtn.addEventListener('input', (e) => {
          const target = e.currentTarget as HTMLInputElement;
          if (txtTextoMis10) {
            txtTextoMis10.textContent = mis10(target.value);
          }
        });
      }

      // 20. Configurar Formato de Código (wiCode)
      const btnWicodeTrigger = document.getElementById('btn_wicode_trigger');
      if (btnWicodeTrigger) {
        const newBtn = btnWicodeTrigger.cloneNode(true);
        btnWicodeTrigger.parentNode?.replaceChild(newBtn, btnWicodeTrigger);
        newBtn.addEventListener('click', () => {
          wiCode('.lab_wicode_demo');
          Mensaje(langwii.n('¡wiCode formateado!', 'wiCode formatted!'), 'success');
        });
      }

      // 21. Configurar Ubicación y Telemetría (wiIp)
      const btnWiipTrigger = document.getElementById('btn_wiip_trigger');
      const txtWiipCity = document.getElementById('txt_wiip_city');
      const txtWiipBrowser = document.getElementById('txt_wiip_browser');
      
      if (btnWiipTrigger) {
        const newBtn = btnWiipTrigger.cloneNode(true);
        btnWiipTrigger.parentNode?.replaceChild(newBtn, btnWiipTrigger);
        newBtn.addEventListener('click', () => {
          wiIp().then(data => {
            if (data) {
              if (txtWiipCity) txtWiipCity.textContent = `${data.ip} (${data.city}, ${data.country})`;
              if (txtWiipBrowser) txtWiipBrowser.textContent = `${data.os} / ${data.browser} (${data.device})`;
              Mensaje(langwii.n('¡Telemetría consultada!', 'Telemetry queried!'), 'success');
            } else {
              Mensaje('Error querying IP', 'error');
            }
          });
        });
      }

      // 22. Configurar Atajos DOM (more.js)
      const btnWisumaSecret = document.getElementById('btn_wisuma_secret');
      const btnAdtmDemo = document.getElementById('btn_adtm_demo');
      
      if (btnWisumaSecret) {
        const newBtn = btnWisumaSecret.cloneNode(true);
        btnWisumaSecret.parentNode?.replaceChild(newBtn, btnWisumaSecret);
        wiSuma(newBtn, () => {
          Mensaje(langwii.n('💥 ¡Combinación secreta disparada!', '💥 Secret combination triggered!'), 'success');
        }, 5);
      }
      
      if (btnAdtmDemo) {
        const newBtn = btnAdtmDemo.cloneNode(true);
        btnAdtmDemo.parentNode?.replaceChild(newBtn, btnAdtmDemo);
        newBtn.addEventListener('click', () => {
          adtm(
            newBtn, 
            'lab_btn_saving_state', 
            langwii.n('Guardando...', 'Saving...'), 
            langwii.n('Guardar Estado', 'Save Status')
          );
        });
      }

      // 23. Configurar Carga Inteligente (wiSmart)
      const btnWismartTrigger = document.getElementById('btn_wismart_trigger');
      const txtWismartStatus = document.getElementById('txt_wismart_status');
      
      if (btnWismartTrigger) {
        const newBtn = btnWismartTrigger.cloneNode(true);
        btnWismartTrigger.parentNode?.replaceChild(newBtn, btnWismartTrigger);
        newBtn.addEventListener('click', () => {
          localStorage.removeItem('wiSmart');
          
          if (txtWismartStatus) {
            txtWismartStatus.textContent = langwii.n(
              '¡Encolado! Haz scroll o clic en cualquier lado para disparar...',
              'Enqueued! Scroll or click anywhere to trigger...'
            );
            txtWismartStatus.style.color = 'var(--warning)';
          }

          wiSmart({
            css: ['https://fonts.googleapis.com/css2?family=Lobster&display=swap'],
            custom: [
              () => {
                return new Promise((resolve) => {
                  if (txtWismartStatus) {
                    txtWismartStatus.textContent = langwii.n(
                      '⚡ ¡Fuente Lobster Cargada! Estilo de tarjeta actualizado.',
                      '⚡ Lobster Font Loaded! Element style updated.'
                    );
                    txtWismartStatus.style.color = 'var(--success)';
                    txtWismartStatus.style.fontFamily = "'Lobster', cursive";
                  }
                  resolve(true);
                });
              }
            ]
          });
        });
      }

      // 24. Configurar Bus de Autenticación (wiAuth)
      const btnAuthLogin = document.getElementById('btn_auth_login');
      const btnAuthLogout = document.getElementById('btn_auth_logout');
      const txtAuthStatus = document.getElementById('txt_auth_status');

      // Escuchar cambios reactivos en la sesión
      const cancelAuthSub = wiAuth.on((user: any) => {
        if (txtAuthStatus) {
          if (user) {
            txtAuthStatus.textContent = langwii.n(
              `Logueado: ${user.nombre} (${user.rol})`,
              `Logged in: ${user.nombre} (${user.rol})`
            );
            txtAuthStatus.style.color = 'var(--success)';
          } else {
            txtAuthStatus.textContent = langwii.n('Sin usuario activo', 'No user active');
            txtAuthStatus.style.color = 'var(--error)';
          }
        }
      });

      if (btnAuthLogin) {
        const newBtn = btnAuthLogin.cloneNode(true);
        btnAuthLogin.parentNode?.replaceChild(newBtn, btnAuthLogin);
        newBtn.addEventListener('click', () => {
          wiAuth.login({ id: 101, nombre: 'Wilder Alexander', rol: 'admin', tema: 'mora' });
          Mensaje(langwii.n('¡Sesión simulada activada!', 'Mock session logged in!'), 'success');
        });
      }

      if (btnAuthLogout) {
        const newBtn = btnAuthLogout.cloneNode(true);
        btnAuthLogout.parentNode?.replaceChild(newBtn, btnAuthLogout);
        newBtn.addEventListener('click', () => {
          wiAuth.logout();
          Mensaje(langwii.n('¡Sesión cerrada con éxito!', 'Logged out successfully!'), 'warning');
        });
      }

      // 25. Configurar Markdown Parser (wiMd)
      const txtWimdInput = document.getElementById('txt_wimd_input') as HTMLTextAreaElement;
      const txtWimdOutput = document.getElementById('txt_wimd_output');

      const renderMd = () => {
        if (txtWimdInput && txtWimdOutput) {
          txtWimdOutput.innerHTML = wiMd(txtWimdInput.value);
        }
      };

      if (txtWimdInput) {
        txtWimdInput.addEventListener('input', renderMd);
        renderMd(); // primer render
      }

      console.log('🧪 [Lab] Módulos de widev/ re-inicializados con éxito.');
    } catch (e) {
      console.error('🧪 [Lab] Error al inicializar:', e);
    }
  };

  document.addEventListener('astro:page-load', initLab);
</script>
