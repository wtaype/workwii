---
// src/lib/wii/Lab.astro
import Layout from '../../layouts/Layout.astro';
import './lab.css';
import './chatwii/estilo.css';
import { idiomaLab } from './idiomaLab.js';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = idiomaLab[lang] || idiomaLab['es'];
---

<Layout title={t['lab.titulo']}>
  <div class="lab_wrapper">
    <!-- Cabecera -->
    <header class="lab_header_sec">
      <h1><i class="fas fa-flask"></i> {t['lab.titulo']}</h1>
      <p>{t['lab.subtitulo']}</p>
    </header>

    <!-- Layout del Laboratorio -->
    <div class="lab_layout">
      <!-- Columna Izquierda: Formulario Mock CV -->
      <div class="lab_col">
        <div class="lab_card_panel">
          <h2><i class="fas fa-file-invoice"></i> {t['lab.colEditor']}</h2>
          
          <!-- Datos Personales -->
          <fieldset style="border: none; padding: 0; margin-bottom: 3vh;">
            <legend style="font-weight: 700; font-size: 1.1rem; margin-bottom: 2vh; color: var(--mco);"><i class="fas fa-user"></i> {t['lab.personal']}</legend>
            
            <div class="lab_group">
              <label for="cv_nombre">{t['lab.nombre']}</label>
              <input type="text" id="cv_nombre" class="lab_input" placeholder="Ej. Juan Pérez" />
            </div>

            <div class="lab_group">
              <label for="cv_titulo">{t['lab.tituloProf']}</label>
              <input type="text" id="cv_titulo" class="lab_input" placeholder="Ej. Frontend Developer" />
            </div>

            <div class="lab_group">
              <label for="cv_resumen">{t['lab.resumen']}</label>
              <textarea id="cv_resumen" class="lab_input lab_textarea" placeholder="Ej. Desarrollador con más de 2 años de experiencia..."></textarea>
            </div>
          </fieldset>

          <!-- Experiencias Laborales -->
          <div style="margin-bottom: 3vh;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2vh;">
              <h3 style="font-weight: 700; font-size: 1.1rem; color: var(--mco); margin: 0;"><i class="fas fa-briefcase"></i> {t['lab.experiencias']}</h3>
              <button type="button" id="btn_add_exp" class="lab_btn secondary" style="padding: 0.8vh 1.8vh; font-size: 0.8rem;">
                <i class="fas fa-plus"></i> {t['lab.nuevaExp']}
              </button>
            </div>
            
            <div id="experiences_container">
              <!-- Experiencias cargadas dinámicamente -->
            </div>
          </div>

          <!-- Acciones del Formulario -->
          <div class="lab_btn_row">
            <button type="button" id="btn_reset_cv" class="lab_btn danger">
              <i class="fas fa-undo"></i> {t['lab.limpiarDatos']}
            </button>
            <button type="button" id="btn_save_cv" class="lab_btn primary">
              <i class="fas fa-save"></i> {t['lab.guardar']}
            </button>
          </div>
        </div>

      </div>

      <!-- Columna Derecha: Debug Visualizador JSON y ATS Score -->
      <div class="lab_col">
        <!-- ATS Score Meter Panel -->
        <div class="lab_card_panel" style="text-align: center;">
          <h2 style="border-bottom: 1px solid var(--brd); padding-bottom: 1.5vh; margin-bottom: 2vh; text-align: left;">
            <i class="fas fa-chart-pie"></i> Puntuación ATS (En vivo)
          </h2>
          <div style="display: flex; justify-content: center; align-items: center; gap: 4vh; margin: 2vh 0; flex-wrap: wrap;">
            <!-- Círculo SVG de Score -->
            <div style="position: relative; width: 120px; height: 120px;">
              <svg width="120" height="120" viewBox="0 0 120 120" style="transform: rotate(-90deg);">
                <circle cx="60" cy="60" r="50" fill="transparent" stroke="var(--bg4, #fafafa)" stroke-width="10" />
                <circle id="ats_score_circle" cx="60" cy="60" r="50" fill="transparent" stroke="var(--success, #10b981)" stroke-width="10" 
                        stroke-dasharray="314.16" stroke-dashoffset="314.16" style="transition: stroke-dashoffset 0.6s ease;" />
              </svg>
              <div id="ats_score_text" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 800; color: var(--tx1);">0%</div>
            </div>
            <!-- Estado ATS -->
            <div style="text-align: left; flex: 1; min-width: 150px;">
              <div id="ats_score_level" style="font-weight: 700; font-size: 1.1rem; margin-bottom: 1vh; color: var(--success);">Bajo</div>
              <p style="font-size: 0.85rem; color: var(--tx3); margin: 0; line-height: 1.4;">Esta puntuación estima qué tan bien optimizado está tu CV para superar los filtros ATS.</p>
            </div>
          </div>
          
          <!-- Lista de Chequeo ATS -->
          <div style="text-align: left; border-top: 1px solid var(--brd); padding-top: 2vh; margin-top: 2.5vh;">
            <h3 style="font-size: 0.9rem; font-weight: 700; margin-bottom: 1.5vh; color: var(--tx2);"><i class="fas fa-list-check"></i> Recomendaciones ATS</h3>
            <ul id="ats_checklist" style="list-style: none; padding: 0; margin: 0; font-size: 0.8rem; color: var(--tx2); line-height: 1.8;">
              <!-- Recomendaciones dinámicas -->
            </ul>
          </div>
        </div>

        <!-- Visualizador JSON -->
        <div class="lab_card_panel" style="flex: 1; display: flex; flex-direction: column;">
          <h2><i class="fas fa-code"></i> {t['lab.verJson']}</h2>
          <pre class="lab_json_view" id="cv_json_debug" style="flex: 1; max-height: none; min-height: 40vh;"></pre>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initChat } from './chatwii/visual.js';

  // Datos semilla de CV para pruebas
  const MOCK_CV_SEED = {
    nombre: "Wilder Vilchez",
    titulo: "Systems Engineer and Full Stack Developer",
    resumen: "Systems Engineer and Full Stack Developer with over 2 years of experience building scalable digital solutions using Astro, Supabase, and Firebase.",
    ubicacion: "Lima, Perú",
    skills: "Troubleshooting, Empathy, Technical Writing, Remote Collaboration, Problem Solving, Customer Success, JavaScript, TypeScript, PHP, REST APIs, SQL, Agile Methodologies, UI/UX Design, Artificial Intelligence",
    experiencias: [
      {
        id: "exp_1",
        puesto: "Digital Analyst / Developer",
        empresa: "Banco de Crédito BCP",
        logros: "- Optimized high-traffic banking applications, reducing latency by 35% and improving end-user experience.\n- Automated internal workflows, reducing technical incident response times by 50%."
      },
      {
        id: "exp_2",
        puesto: "Customer Support Agent",
        empresa: "Covisian",
        logros: "- Led the resolution of complex technical incidents across digital channels, prioritizing Customer Support & Success.\n- Developed 'DSCTO MOVIL', an internal tool that automated commission calculations."
      }
    ],
    educacion: [],
    proyectos: [],
    certificaciones: []
  };

  let currentCv = JSON.parse(JSON.stringify(MOCK_CV_SEED));

  // Inicializar o cargar de sessionStorage (limpieza automática al cerrar pestaña)
  const savedCv = sessionStorage.getItem('chatwii_lab_mock_cv');
  if (savedCv) {
    try {
      currentCv = JSON.parse(savedCv);
    } catch (_) {
      currentCv = JSON.parse(JSON.stringify(MOCK_CV_SEED));
    }
  }

  const saveToStorage = () => {
    sessionStorage.setItem('chatwii_lab_mock_cv', JSON.stringify(currentCv));
  };

  // Referencias DOM
  const inputNombre = document.getElementById('cv_nombre');
  const inputTitulo = document.getElementById('cv_titulo');
  const inputResumen = document.getElementById('cv_resumen');
  const expContainer = document.getElementById('experiences_container');
  const jsonDebug = document.getElementById('cv_json_debug');

  // Calcular y renderizar el ATS Score de forma reactiva en el cliente
  const recalculateAtsScore = () => {
    let score = 0;
    const recommendations = [];

    // 1. Datos Personales (max 20 pts)
    if (currentCv.nombre && currentCv.nombre.trim().length > 2) {
      score += 5;
    } else {
      recommendations.push(`<i class="fas fa-circle-exclamation" style="color:var(--error, #ef4444); margin-right:0.5vh;"></i> Añade tu nombre completo.`);
    }

    if (currentCv.titulo && currentCv.titulo.trim().length > 2) {
      score += 5;
    } else {
      recommendations.push(`<i class="fas fa-circle-exclamation" style="color:var(--error, #ef4444); margin-right:0.5vh;"></i> Agrega tu título profesional (ej. Frontend Engineer).`);
    }

    if (currentCv.resumen && currentCv.resumen.trim().length > 15) {
      score += 5;
      if (currentCv.resumen.trim().length < 60) {
        recommendations.push(`<i class="fas fa-triangle-exclamation" style="color:var(--warning, #f59e0b); margin-right:0.5vh;"></i> Tu resumen profesional es muy corto, amplíalo un poco.`);
      }
    } else {
      recommendations.push(`<i class="fas fa-circle-exclamation" style="color:var(--error, #ef4444); margin-right:0.5vh;"></i> Escribe un resumen profesional introductorio.`);
    }

    if (currentCv.ubicacion && currentCv.ubicacion.trim().length > 2) {
      score += 5;
    } else {
      recommendations.push(`<i class="fas fa-circle-info" style="color:var(--info, #3b82f6); margin-right:0.5vh;"></i> Añade tu ubicación (ej. Lima, Perú).`);
    }

    // 2. Habilidades / Skills (max 20 pts)
    if (currentCv.skills && currentCv.skills.trim().length > 0) {
      const skillsList = currentCv.skills.split(',').map(s => s.trim()).filter(Boolean);
      if (skillsList.length >= 10) {
        score += 20;
      } else if (skillsList.length >= 5) {
        score += 15;
        recommendations.push(`<i class="fas fa-circle-info" style="color:var(--info, #3b82f6); margin-right:0.5vh;"></i> Añade más palabras clave o habilidades técnicas (mínimo 10).`);
      } else {
        score += 5;
        recommendations.push(`<i class="fas fa-triangle-exclamation" style="color:var(--warning, #f59e0b); margin-right:0.5vh;"></i> Tienes muy pocas habilidades registradas, agrega al menos 5.`);
      }
    } else {
      recommendations.push(`<i class="fas fa-circle-exclamation" style="color:var(--error, #ef4444); margin-right:0.5vh;"></i> Agrega habilidades y tecnologías clave (skills).`);
    }

    // 3. Experiencias Laborales (max 40 pts)
    const exps = currentCv.experiencias || [];
    if (exps.length > 0) {
      score += Math.min(20, exps.length * 10);
      if (exps.length < 2) {
        recommendations.push(`<i class="fas fa-circle-info" style="color:var(--info, #3b82f6); margin-right:0.5vh;"></i> Agrega al menos dos experiencias laborales si las tienes.`);
      }

      // Buscar métricas cuantitativas (% o números) en los logros
      let numbersCount = 0;
      exps.forEach((exp) => {
        if (exp.logros) {
          const matches = exp.logros.match(/\d+|%/g);
          if (matches) {
            numbersCount += matches.length;
          }
        }
      });

      if (numbersCount >= 3) {
        score += 20;
      } else if (numbersCount >= 1) {
        score += 10;
        recommendations.push(`<i class="fas fa-lightbulb" style="color:var(--warning, #f59e0b); margin-right:0.5vh;"></i> <strong>Consejo ATS:</strong> Añade más métricas numéricas o porcentajes en tus logros.`);
      } else {
        recommendations.push(`<i class="fas fa-lightbulb" style="color:var(--warning, #f59e0b); margin-right:0.5vh;"></i> <strong>Importante ATS:</strong> No tienes métricas en tus logros. Los reclutadores prefieren resultados medibles (ej: "Reduje latencia en 30%").`);
      }
    } else {
      recommendations.push(`<i class="fas fa-circle-exclamation" style="color:var(--error, #ef4444); margin-right:0.5vh;"></i> Añade experiencias laborales en tu CV.`);
    }

    // 4. Proyectos y Certificaciones (max 20 pts)
    const projs = currentCv.proyectos || [];
    const certs = currentCv.certificaciones || [];

    if (projs.length > 0) {
      score += 10;
    } else {
      recommendations.push(`<i class="fas fa-circle-info" style="color:var(--info, #3b82f6); margin-right:0.5vh;"></i> Añadir proyectos destacados (SaaS, apps) fortalece mucho tu perfil.`);
    }

    if (certs.length > 0) {
      score += 10;
    } else {
      recommendations.push(`<i class="fas fa-circle-info" style="color:var(--info, #3b82f6); margin-right:0.5vh;"></i> Agrega certificaciones o cursos relevantes.`);
    }

    // Actualizar UI
    const circle = document.getElementById('ats_score_circle');
    const scoreText = document.getElementById('ats_score_text');
    const scoreLevel = document.getElementById('ats_score_level');
    const checklist = document.getElementById('ats_checklist');

    if (circle) {
      const circumference = 314.16;
      const offset = circumference - (score / 100) * circumference;
      circle.setAttribute('stroke-dashoffset', String(offset));
      
      // Cambiar color del círculo según puntaje
      if (score >= 80) {
        circle.setAttribute('stroke', 'var(--success, #10b981)');
      } else if (score >= 50) {
        circle.setAttribute('stroke', 'var(--warning, #f59e0b)');
      } else {
        circle.setAttribute('stroke', 'var(--danger, #ef4444)');
      }
    }

    if (scoreText) {
      scoreText.textContent = `${score}%`;
    }

    if (scoreLevel) {
      if (score >= 80) {
        scoreLevel.textContent = 'Excelente';
        scoreLevel.style.color = 'var(--success, #10b981)';
      } else if (score >= 55) {
        scoreLevel.textContent = 'Aceptable';
        scoreLevel.style.color = 'var(--warning, #f59e0b)';
      } else {
        scoreLevel.textContent = 'Bajo';
        scoreLevel.style.color = 'var(--danger, #ef4444)';
      }
    }

    if (checklist) {
      if (recommendations.length === 0) {
        checklist.innerHTML = `<li style="color: var(--success, #10b981);"><i class="fas fa-circle-check"></i> ¡Tu currículum está 100% optimizado para ATS! Listo para postular.</li>`;
      } else {
        checklist.innerHTML = recommendations.map(rec => `<li style="margin-bottom: 0.8vh; display: flex; align-items: flex-start;"><span>${rec}</span></li>`).join('');
      }
    }
  };

  // Actualiza el JSON debug visual y recalcula el ATS Score
  const updateJsonDebug = () => {
    if (jsonDebug) {
      jsonDebug.textContent = JSON.stringify(currentCv, null, 2);
    }
    recalculateAtsScore();
  };

  // Renderizar experiencias laborales en el formulario
  const renderExperiences = () => {
    if (!expContainer) return;
    expContainer.innerHTML = '';

    currentCv.experiencias.forEach((exp, index) => {
      const expBlock = document.createElement('div');
      expBlock.className = 'lab_exp_block';
      expBlock.innerHTML = `
        <div class="lab_exp_block_header">
          <span class="lab_exp_block_title">${exp.empresa || 'Empresa'} - ${exp.puesto || 'Puesto'} (Idx: ${index})</span>
          <button type="button" class="lab_btn danger btn-delete-exp" data-idx="${index}" style="padding: 0.5vh 1vh; font-size: 0.75rem;">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        <div class="lab_group">
          <label>Empresa</label>
          <input type="text" class="lab_input exp-empresa" data-idx="${index}" value="${exp.empresa || ''}" />
        </div>
        <div class="lab_group">
          <label>Puesto</label>
          <input type="text" class="lab_input exp-puesto" data-idx="${index}" value="${exp.puesto || ''}" />
        </div>
        <div class="lab_group">
          <label>Logros</label>
          <textarea class="lab_input lab_textarea exp-logros" data-idx="${index}" rows="3">${exp.logros || ''}</textarea>
        </div>
      `;
      expContainer.appendChild(expBlock);
    });

    // Agregar event listeners a los inputs de las experiencias
    expContainer.querySelectorAll('.exp-empresa').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt(e.target.getAttribute('data-idx') || '0');
        currentCv.experiencias[idx].empresa = e.target.value;
        saveToStorage();
        updateJsonDebug();
      });
    });

    expContainer.querySelectorAll('.exp-puesto').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt(e.target.getAttribute('data-idx') || '0');
        currentCv.experiencias[idx].puesto = e.target.value;
        saveToStorage();
        updateJsonDebug();
      });
    });

    expContainer.querySelectorAll('.exp-logros').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt(e.target.getAttribute('data-idx') || '0');
        currentCv.experiencias[idx].logros = e.target.value;
        saveToStorage();
        updateJsonDebug();
      });
    });

    expContainer.querySelectorAll('.btn-delete-exp').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const btnEl = e.target.closest('.btn-delete-exp');
        if (!btnEl) return;
        const idx = parseInt(btnEl.getAttribute('data-idx') || '0');
        currentCv.experiencias.splice(idx, 1);
        saveToStorage();
        renderExperiences();
        updateJsonDebug();
      });
    });
  };

  // Llenar formulario desde los datos de currentCv
  const populateForm = () => {
    if (inputNombre) inputNombre.value = currentCv.nombre || '';
    if (inputTitulo) inputTitulo.value = currentCv.titulo || '';
    if (inputResumen) inputResumen.value = currentCv.resumen || '';
    renderExperiences();
    updateJsonDebug();
  };

  // Event listeners para los datos principales
  inputNombre?.addEventListener('input', (e) => {
    currentCv.nombre = e.target.value;
    saveToStorage();
    updateJsonDebug();
  });

  inputTitulo?.addEventListener('input', (e) => {
    currentCv.titulo = e.target.value;
    saveToStorage();
    updateJsonDebug();
  });

  inputResumen?.addEventListener('input', (e) => {
    currentCv.resumen = e.target.value;
    saveToStorage();
    updateJsonDebug();
  });

  document.getElementById('btn_add_exp')?.addEventListener('click', () => {
    currentCv.experiencias.push({
      id: 'exp_' + Math.random().toString(36).substring(2, 9),
      puesto: '',
      empresa: '',
      logros: ''
    });
    saveToStorage();
    renderExperiences();
    updateJsonDebug();
  });

  document.getElementById('btn_reset_cv')?.addEventListener('click', () => {
    currentCv = JSON.parse(JSON.stringify(MOCK_CV_SEED));
    saveToStorage();
    populateForm();
  });

  document.getElementById('btn_save_cv')?.addEventListener('click', () => {
    saveToStorage();
    if (window.Mensaje) {
      window.Mensaje('CV Guardado localmente en el Lab', 'success');
    }
  });

  // --- INTEGRACIÓN DE CHATWII FLOTANTE ---
  const startFloatingChatwii = () => {
    // Inicializar Chatwii usando la API expuesta por visual.js
    // Pasamos el mock getCvData y updateCvData reactivos
    initChat(
      'es',
      () => currentCv,
      (newData) => {
        if (newData && typeof newData === 'object') {
          if ('experiencias' in newData) {
            Object.keys(currentCv).forEach(k => delete currentCv[k]);
          }
          Object.assign(currentCv, newData);
        }
        saveToStorage();
        populateForm(); // Refrescar formulario en pantalla
      }
    );
  };

  // Inicializar todo
  populateForm();
  
  // Darle un pequeño timeout para esperar que el script de inicialización global de Astro termine
  setTimeout(startFloatingChatwii, 200);
</script>
