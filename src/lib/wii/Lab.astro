          type="button" 
          class="modalX" 
          style="background: var(--bg4); border: none; width: 4.5vh; height: 4.5vh; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--tx2); transition: all 0.2s ease;"
          onmouseover="this.style.background='var(--brd)'; this.style.color='var(--tx1)';"
