        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>{lang === 'en' ? 'Active session: ' : 'Sesión activa: '}</strong>
          <span id="txt_auth_status" style="font-weight: 700; color: var(--error);">{lang === 'en' ? 'No user' : 'Sin usuario'}</span>
        </div>
