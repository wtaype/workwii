        {lang === 'en' ? 'Testing input focus behavior on modal open:' : 'Comprobando auto-foco en el primer campo:'}
      </p>
      
      <input 
        type="text" 
        placeholder={lang === 'en' ? 'This gains focus automatically...' : 'Este campo gana foco al abrir...'} 
        style="width: 100%; padding: 1.2vh 1.8vh; background: var(--bg4); border: 1px solid var(--brd); border-radius: 0.8vh; color: var(--tx1); font-weight: 500; font-size: var(--fz_s3); margin-bottom: 2.5vh; transition: border-color 0.2s ease, box-shadow 0.2s ease; outline: none;"
        onfocus="this.style.borderColor='var(--mco)'; this.style.boxShadow='0 0 0 3px rgba(0, 112, 243, 0.15)';"
        onblur="this.style.borderColor='var(--brd)'; this.style.boxShadow='none';"
      />
      
      <div style="display: flex; gap: 2vh; justify-content: flex-end;">
        <button 
          type="button" 
          class="lab_btn_submit" 
          data-wimodal-close
          style="background: var(--bg4); color: var(--tx1); display: inline-flex; align-items: center; gap: 1vh;"
