        </h3>
        <p class="lab_text">{lang === 'en' ? 'Simulates dynamic CSS font load on user interaction:' : 'Simula la carga dinámica de fuentes con la primera interacción:'}</p>
        
        <button type="button" id="btn_wismart_trigger" class="lab_btn_submit" style="width: 100%; background: var(--mco);">
          {lang === 'en' ? 'Load Test Font (Lobster)' : 'Cargar Fuente de Prueba (Lobster)'}
        </button>

        <div class="lab_item" style="font-size: var(--fz_s3); margin-top: 1.5vh;">
          <strong>{lang === 'en' ? 'Status: ' : 'Estado: '}</strong>
          <span id="txt_wismart_status" style="font-weight: 700; color: var(--warning);">{lang === 'en' ? 'Idle' : 'Inactivo'}</span>
        </div>
      </div>

      <!-- Módulo 26: Bus de Autenticación (wiAuth) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-user-shield"></i> 
