---
// src/lib/wii/Lab.astro
// Componente de laboratorio y pruebas para todos los componentes modularizados de widev/

import Layout from '../../layouts/Layout.astro';
import labcss from './lab.css?inline';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
---

<style is:global set:html={labcss}></style>

<Layout title={lang === 'en' ? 'Testing Lab — widev/' : 'Laboratorio de Pruebas — widev/'}>
  <div class="lab_container">
    
    <!-- Módulo 1: Cabecera de Pruebas (Ancho Completo) -->
    <div class="lab_card lab_card--full">
      <div class="lab_title">
        <i class="fas fa-flask"></i> 
        {lang === 'en' ? 'Modular Components Lab' : 'Laboratorio de Componentes Modularizados'}
      </div>
      <p id="lab_saludo" class="lab_saludo"></p>
      
      <div style="display: flex; gap: 2vh; flex-wrap: wrap; margin-top: 2vh;">
        <!-- Botón A: Tooltip JS Modular (Inyecta el CSS internamente) -->
        <button 
          type="button" 
          id="btn_tooltip" 
          class="lab_btn_submit" 
          data-witip={lang === 'en' ? 'This tooltip style is injected by the JS module!' : '¡Los estilos de este tooltip son inyectados por el módulo JS!'} 
          data-wtipo="info"
        >
          {lang === 'en' ? 'JS Tooltip (wiTip)' : 'Tooltip JS (wiTip)'}
        </button>

        <!-- Botón B: Tooltip 100% CSS (Sin una línea de JS) -->
        <a 
          href="#"
          class="lab_btn_submit" 
          style="background: var(--success);"
          data-witip-css={lang === 'en' ? '100% CSS Tooltip (GPU accelerated!)' : '¡Tooltip 100% CSS (acelerado por GPU!)'}
        >
          {lang === 'en' ? 'CSS Tooltip' : 'Tooltip CSS'}
        </a>
      </div>
    </div>

    <!-- Contenedor en dos columnas para pruebas lógicas -->
    <div class="lab_grid">
      <!-- Módulo 3: Animaciones JS (herowi) -->
      <div class="lab_card" data-herowi="100">
        <h3 class="lab_sec_title">
          <i class="fas fa-wand-magic-sparkles"></i> 
          {lang === 'en' ? 'Header Animation (herowi)' : 'Test de Cabeceras (herowi)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Animated item 1' : 'Elemento animado incremental 1'}</p>
        <p class="lab_text">{lang === 'en' ? 'Animated item 2' : 'Elemento animado incremental 2'}</p>
        <p class="lab_text">{lang === 'en' ? 'Animated item 3' : 'Elemento animado incremental 3'}</p>
      </div>

      <!-- Módulo 4: Animaciones en Scroll (showi vs CSS Scroll-Driven) -->
      <div class="lab_card" data-showi="150">
        <h3 class="lab_sec_title">
          <i class="fas fa-eye"></i> 
          {lang === 'en' ? 'Scroll Animation (showi)' : 'Test de Scroll (showi)'}
        </h3>
        <div class="lab_item">{lang === 'en' ? 'Item 1' : 'Item 1'}</div>
        <div class="lab_item">{lang === 'en' ? 'Item 2' : 'Item 2'}</div>
        <div class="lab_item">{lang === 'en' ? 'Item 3' : 'Item 3'}</div>
      </div>

      <!-- Módulo 5: Entrada al viewport (wiVista) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-binoculars"></i> 
          {lang === 'en' ? 'Viewport Entry (wiVista)' : 'Entrada al Viewport (wiVista)'}
        </h3>
        <p class="lab_text" style="font-size: var(--fz_s3);">
          {lang === 'en' ? 'Scroll down or check the console when items light up.' : 'Haz scroll o revisa la consola cuando los elementos se iluminen.'}
        </p>
        <div class="lab_vista_item">{lang === 'en' ? 'Target A' : 'Objetivo A'}</div>
        <div class="lab_vista_item">{lang === 'en' ? 'Target B' : 'Objetivo B'}</div>
      </div>

      <!-- Módulo 6: Transición de contenidos (wiFade vs CSS @starting-style) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-arrows-rotate"></i> 
          {lang === 'en' ? 'Dynamic Transition Test' : 'Test de Transiciones'}
        </h3>
        
        <!-- Sub-test A: wiFade -->
        <div id="fade_target" class="lab_fade_box">
          {lang === 'en' ? 'Original text (wiFade)' : 'Texto original (wiFade)'}
        </div>
        <button type="button" id="btn_fade" class="lab_btn_submit" style="width: 100%; margin-bottom: 2.5vh;">
          {lang === 'en' ? 'Trigger wiFade' : 'Ejecutar wiFade'}
        </button>

        <!-- Sub-test B: @starting-style -->
        <button type="button" id="btn_add_alert" class="lab_btn_submit" style="width: 100%; background: var(--warning);">
          {lang === 'en' ? 'Insert Alert (@starting-style)' : 'Insertar Alerta (@starting-style)'}
        </button>
        <div id="alert_container" class="lab_alert_container"></div>
      </div>

      <!-- Módulo 7: Copiar al Portapapeles (wicopy) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-copy"></i> 
          {lang === 'en' ? 'Copy Clipboard (wicopy)' : 'Copiar Portapapeles (wicopy)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Copies text from the input below:' : 'Copia el texto del campo de abajo:'}</p>
        
        <input 
          type="text" 
          id="input_copy_demo" 
          value="https://workwii.com/wilder" 
          style="width: 100%; padding: 1.2vh 1.8vh; background: var(--bg4); border: 1px solid var(--brd); border-radius: 0.8vh; color: var(--tx1); font-weight: 500; margin-bottom: 2vh; font-size: var(--fz_s3);" 
          readonly 
        />
        
        <button type="button" id="btn_copy_input" class="lab_btn_submit" style="width: 100%; background: var(--mco);">
          {lang === 'en' ? 'Copy Link' : 'Copiar Enlace'}
        </button>
      </div>

      <!-- Módulo 8: Carga Diferida (imgwii) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-image"></i> 
          {lang === 'en' ? 'Lazy Image Loader (imgwii)' : 'Carga Diferida (imgwii)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Dynamic lazy image using public placeholder:' : 'Imagen diferida usando placeholder de public/:'}</p>
        
        <!-- Contenedor con borde y fondo para simular carga diferida -->
        <div style="height: 18vh; width: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 1vh; background: var(--bg4); border: 1px solid var(--brd);">
          <img 
            data-src="/perfil.webp" 
            style="width: 100%; height: 100%; object-fit: cover;" 
            alt="Lazy loaded user avatar" 
          />
        </div>
      </div>

      <!-- Módulo 9: Utilidades de Fecha (fecha.js) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-calendar-days"></i> 
          {lang === 'en' ? 'Time & Dates (fecha.js)' : 'Fechas y Tiempo (fecha.js)'}
        </h3>
        
        <!-- 1. year() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>year(): </strong>
          <span id="txt_year" style="color: var(--mco); font-weight: 600;"></span>
        </div>

        <!-- 2. fechaHoy() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>fechaHoy(): </strong>
          <span id="txt_fecha_hoy" style="color: var(--tx1); font-weight: 600;"></span>
        </div>

        <!-- 3. wiTiempo() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>wiTiempo(): </strong>
          <span id="txt_tiempo_rel" style="color: var(--success); font-weight: 600;"></span>
        </div>

        <!-- 4. calcMeses() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>calcMeses(): </strong>
          <span id="txt_meses_diff" style="color: var(--info); font-weight: 600;"></span>
        </div>

        <!-- 5. formatearFechaHora() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>formatearFechaHora(): </strong>
          <span id="txt_fecha_hora" style="color: var(--warning); font-weight: 600;"></span>
        </div>

        <!-- 6. formatearFechaParaInput() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>formatearFechaParaInput(): </strong>
          <span id="txt_fecha_input" style="color: var(--error); font-weight: 600;"></span>
        </div>

        <!-- 7. wiDate() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>wiDate() [Mock Firebase]: </strong>
          <span id="txt_widate_mock" style="color: var(--tx2); font-weight: 600;"></span>
        </div>
      </div>

      <!-- Módulo 10: Mensajes Flotantes (Mensaje) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-comment-dots"></i> 
          {lang === 'en' ? 'Toasts (Mensaje)' : 'Mensajes (Mensaje)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Trigger dynamic notification toasts:' : 'Dispara alertas flotantes dinámicas:'}</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1vh; margin-top: 1.5vh;">
          <button type="button" class="lab_btn_submit btn-toast" data-tipo="success" style="background: var(--success);">Success</button>
          <button type="button" class="lab_btn_submit btn-toast" data-tipo="error" style="background: var(--error);">Error</button>
          <button type="button" class="lab_btn_submit btn-toast" data-tipo="warning" style="background: var(--warning);">Warning</button>
          <button type="button" class="lab_btn_submit btn-toast" data-tipo="info" style="background: var(--info);">Info</button>
        </div>
      </div>

      <!-- Módulo 11: Ventanas Modales (abrirModal) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-window-restore"></i> 
          {lang === 'en' ? 'Modals (wiModal)' : 'Modales (wiModal)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Triggers a frosted-glass overlay dialog:' : 'Despliega una ventana emergente de pruebas:'}</p>
        <button type="button" id="btn_open_modal" class="lab_btn_submit" style="width: 100%; background: var(--mco);">
          {lang === 'en' ? 'Open Test Modal' : 'Abrir Modal de Pruebas'}
        </button>
      </div>

      <!-- Módulo 12: Control de Rutas (wiPath) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-route"></i> 
          {lang === 'en' ? 'Routes & Params (wiPath)' : 'Rutas y Params (wiPath)'}
        </h3>
        
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>wiPath.actual: </strong>
          <span id="txt_wipath_actual" style="color: var(--mco); font-weight: 600;"></span>
        </div>

        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>wiPath.params(): </strong>
          <span id="txt_wipath_params" style="color: var(--success); font-weight: 600;"></span>
        </div>

        <button type="button" id="btn_simular_ruta" class="lab_btn_submit" style="width: 100%; background: var(--info); margin-top: 1vh;">
          {lang === 'en' ? 'Simulate Navigation' : 'Simular Navegación (Query)'}
        </button>
      </div>

      <!-- Módulo 13: Formateo de Nombres (nombre.js) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-signature"></i> 
          {lang === 'en' ? 'Name Formatter (nombre.js)' : 'Formateador de Nombres (nombre.js)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Converts messy name formats dynamically:' : 'Convierte formatos de texto dinámicamente:'}</p>
        
        <input 
          type="text" 
          id="input_nombre_demo" 
          value="  wilder Alexander vilchez SILVA  " 
          style="width: 100%; padding: 1.2vh 1.8vh; background: var(--bg4); border: 1px solid var(--brd); border-radius: 0.8vh; color: var(--tx1); font-weight: 500; font-size: var(--fz_s3); margin-bottom: 2.5vh; outline: none; transition: border-color 0.2s;" 
          onfocus="this.style.borderColor='var(--mco)';"
          onblur="this.style.borderColor='var(--brd)';"
        />

        <!-- 1. Capit() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>Capit(): </strong>
          <span id="txt_nombre_capit" style="color: var(--warning); font-weight: 600;"></span>
        </div>
        
        <!-- 2. NombreApellido() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>NombreApellido(): </strong>
          <span id="txt_nombre_completo" style="color: var(--success); font-weight: 600;"></span>
        </div>

        <!-- 3. getNombre() -->
        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>getNombre(): </strong>
          <span id="txt_nombre_get" style="color: var(--info); font-weight: 600;"></span>
        </div>
        
        <!-- 4. avatar() -->
        <div class="lab_item" style="font-size: var(--fz_s3); display: flex; align-items: center; justify-content: space-between;">
          <strong>avatar(): </strong>
          <span id="txt_nombre_avatar" style="color: var(--txa); font-weight: 700; background: var(--mco); width: 4.5vh; height: 4.5vh; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.15);"></span>
        </div>
      </div>

      <!-- Módulo 14: Notificaciones Apilables (Notificacion) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-bell"></i> 
          {lang === 'en' ? 'Stacked Banners (Notificacion)' : 'Banners Apilables (Notificacion)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Spam these triggers to stack side banners:' : 'Presiona varias veces para apilar avisos en cascada:'}</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1vh; margin-top: 1.5vh;">
          <button type="button" class="lab_btn_submit btn-notif" data-tipo="success" style="background: var(--success);">Success Notif</button>
          <button type="button" class="lab_btn_submit btn-notif" data-tipo="error" style="background: var(--error);">Error Notif</button>
          <button type="button" class="lab_btn_submit btn-notif" data-tipo="warning" style="background: var(--warning);">Warning Notif</button>
          <button type="button" class="lab_btn_submit btn-notif" data-tipo="info" style="background: var(--info);">Info Notif</button>
        </div>
      </div>

      <!-- Módulo 15: Limitador de Intentos (wiRateLimit) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-shield-halved"></i> 
          {lang === 'en' ? 'Rate Limiting (wiRateLimit)' : 'Limitador de Intentos (wiRateLimit)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Click limit test (Max 3 attempts, blocks for 1 min):' : 'Test de clics (Máx 3 intentos, bloquea por 1 min):'}</p>
        
        <div style="display: flex; gap: 1.5vh; align-items: center; margin-bottom: 2vh;">
          <button type="button" id="btn_ratelimit_trigger" class="lab_btn_submit" style="flex: 1; background: var(--mco);">
            {lang === 'en' ? 'Trigger Action' : 'Ejecutar Acción'}
          </button>
          <button type="button" id="btn_ratelimit_reset" class="lab_btn_submit" style="background: var(--bg4); color: var(--tx1);">
            Reset
          </button>
        </div>

        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>{lang === 'en' ? 'Remaining Attempts: ' : 'Intentos restantes: '}</strong>
          <span id="txt_ratelimit_remaining" style="font-weight: 700; color: var(--success);">3</span>
        </div>
      </div>

      <!-- Módulo 16: Scroll Spy (wiScroll) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-scroll"></i> 
          {lang === 'en' ? 'Scroll Spy (wiScroll)' : 'Scroll Espía (wiScroll)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Visual navigation highlights on viewport section entry:' : 'Indicador visual de sección activa en pantalla:'}</p>
        
        <!-- Menú Demo Mini -->
        <div style="display: flex; gap: 1vh; margin-bottom: 2vh; background: var(--bg4); padding: 1vh; border-radius: 0.8vh; border: 1px solid var(--brd);">
          <a href="#lab_sec_demo1" class="lab_spy_link active" style="flex: 1; text-align: center; text-decoration: none; color: var(--tx2); padding: 0.5vh; border-radius: 0.4vh; font-size: var(--fz_s3); font-weight: 600; transition: all 0.2s;">Sec 1</a>
          <a href="#lab_sec_demo2" class="lab_spy_link" style="flex: 1; text-align: center; text-decoration: none; color: var(--tx2); padding: 0.5vh; border-radius: 0.4vh; font-size: var(--fz_s3); font-weight: 600; transition: all 0.2s;">Sec 2</a>
        </div>
        
        <!-- Contenedor con Scroll Interno para Simular Spy -->
        <div id="spy_scroll_container" style="height: 12vh; overflow-y: scroll; border: 1px solid var(--brd); border-radius: 0.8vh; padding: 1.5vh; background: var(--bg3); scroll-behavior: smooth;">
          <div id="lab_sec_demo1" style="height: 10vh; background: rgba(0, 112, 243, 0.1); border-radius: 0.6vh; display: flex; align-items: center; justify-content: center; margin-bottom: 2vh; font-weight: 600;">Sección 1</div>
          <div id="lab_sec_demo2" style="height: 10vh; background: rgba(16, 185, 129, 0.1); border-radius: 0.6vh; display: flex; align-items: center; justify-content: center; font-weight: 600;">Sección 2</div>
        </div>
      </div>

      <!-- Módulo 17: SEO y Metadatos (seometa.js) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-search"></i> 
          {lang === 'en' ? 'SEO & Meta (seometa.js)' : 'SEO y Metadatos (seometa.js)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Simulates dynamic SEO meta-tag generation:' : 'Simulación de metadatos en el <head>:'}</p>
        
        <button type="button" id="btn_simular_seo" class="lab_btn_submit" style="width: 100%; background: var(--success); margin-bottom: 2vh;">
          {lang === 'en' ? 'Generate Article Schema' : 'Generar Schema de Artículo'}
        </button>

        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>document.title: </strong>
          <span id="txt_seo_title" style="color: var(--tx1); font-weight: 600;"></span>
        </div>
      </div>

      <!-- Módulo 18: Cargando en Botones (spin.js) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-spinner"></i> 
          {lang === 'en' ? 'Button Loader (spin.js)' : 'Cargando en Botón (spin.js)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Simulates progress animation on a button:' : 'Simula animación de progreso en un botón:'}</p>
        
        <button type="button" id="btn_spin_demo" class="lab_btn_submit" style="width: 100%; background: var(--mco);">
          {lang === 'en' ? 'Send Application' : 'Enviar Postulación'}
        </button>
      </div>

      <!-- Módulo 19: Almacenamiento (storage.js) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-database"></i> 
          {lang === 'en' ? 'Timed Storage (storage.js)' : 'Almacenamiento (storage.js)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Tests localStorage with expiration (saves for 5 sec):' : 'Guarda datos con expiración (guardado por 5 seg):'}</p>
        
        <div style="display: flex; gap: 1.5vh; margin-bottom: 2vh;">
          <button type="button" id="btn_storage_save" class="lab_btn_submit" style="flex: 1; background: var(--mco);">
            {lang === 'en' ? 'Save Value' : 'Guardar Dato'}
          </button>
          <button type="button" id="btn_storage_read" class="lab_btn_submit" style="flex: 1; background: var(--success);">
            {lang === 'en' ? 'Read Value' : 'Leer Dato'}
          </button>
        </div>

        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>{lang === 'en' ? 'Saved State: ' : 'Estado Guardado: '}</strong>
          <span id="txt_storage_state" style="color: var(--tx2); font-weight: 600;">{lang === 'en' ? 'No data' : 'Sin datos'}</span>
        </div>
      </div>

      <!-- Módulo 20: Carga Diferida (superfun.js) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-bolt"></i> 
          {lang === 'en' ? 'Interaction Deferred (superFun)' : 'Carga Diferida (superFun)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Postpones heavy execution until user interacts:' : 'Difiere la carga hasta la primera interacción:'}</p>
        
        <button type="button" id="btn_superfun_trigger" class="lab_btn_submit" style="width: 100%; background: var(--warning);">
          {lang === 'en' ? 'Queue Heavy Script' : 'Encolar Script Pesado'}
        </button>

        <div class="lab_item" style="font-size: var(--fz_s3); margin-top: 1.5vh;">
          <strong>{lang === 'en' ? 'Status: ' : 'Estado: '}</strong>
          <span id="txt_superfun_status" style="font-weight: 700; color: var(--error);">{lang === 'en' ? 'Waiting for interaction...' : 'Esperando interacción...'}</span>
        </div>
      </div>

      <!-- Módulo 21: Utilidades de Texto (texto.js) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-text-height"></i> 
          {lang === 'en' ? 'Text Formatting (texto.js)' : 'Formateo de Texto (texto.js)'}
        </h3>
        <p class="lab_text">{lang === 'en' ? 'Live lowercase conversion preserving selection:' : 'Conversión a minúsculas conservando selección:'}</p>
        
        <input 
          type="text" 
          id="input_texto_minus" 
          placeholder={lang === 'en' ? 'Type in uppercase, turns lowercase...' : 'Escribe en MAYÚSCULAS y se convertirá...'} 
          style="width: 100%; padding: 1.2vh 1.8vh; background: var(--bg4); border: 1px solid var(--brd); border-radius: 0.8vh; color: var(--tx1); font-weight: 500; font-size: var(--fz_s3); margin-bottom: 2vh; outline: none; transition: border-color 0.2s;" 
          onfocus="this.style.borderColor='var(--mco)';"
          onblur="this.style.borderColor='var(--brd)';"
        />

        <div class="lab_item" style="font-size: var(--fz_s3);">
          <strong>mis10() [Truncate]: </strong>
          <span id="txt_texto_mis10" style="color: var(--success); font-weight: 600;"></span>
        </div>
      </div>

      <!-- Módulo 22: Formateador de Código (wiCode) -->
      <div class="lab_card">
        <h3 class="lab_sec_title">
          <i class="fas fa-code"></i> 
          {lang === 'en' ? 'Code Block Wrapper (wiCode)' : 'Formato de Código (wiCode)'}
        </h3>
