---
// src/lib/todos/blog/slug/slugPage.astro
// Componente de visualización del artículo de blog modularizado y optimizado

import PostPage from '../../../../components/PostPage.astro';
import PostSidebar from '../../../../components/PostSidebar.astro';
import { procesarHtml } from '../recursos/procesarmd.js';

// Carga de estilos inline para alto rendimiento
import estilosSlug from './slug.css?inline';
import estilosContenido from '../contenido.css?inline';

interface Props {
  post: any;
  related?: any[];
  latest?: any[];
  prevPost?: any;
  nextPost?: any;
  lang?: string;
  translationSlug?: string | null;
}

const { post, related = [], latest = [], prevPost, nextPost, lang = 'es', translationSlug } = Astro.props;

// Generar encabezados y procesamiento HTML en el servidor para 0ms en cliente
const headings: { text: string; id: string; depth: number }[] = [];
let modifiedContenido = post.contenido || '';

if (modifiedContenido) {
  modifiedContenido = procesarHtml(modifiedContenido);

  let headingCount = 0;
  modifiedContenido = modifiedContenido.replace(/<(h2|h3)([^>]*?)>([\s\S]*?)<\/\1>/gi, (match: string, tag: string, attrs: string, content: string) => {
    let customId = '';
    let cleanContent = content;
    const trimmedContent = content.trim();
    const contentIdMatch = trimmedContent.match(/(.*?)\s*\{\#([a-zA-Z0-9_-]+)\}\s*$/i);
    
    if (contentIdMatch) {
      cleanContent = contentIdMatch[1].trim();
      customId = contentIdMatch[2];
    }

    const idMatch = attrs.match(/id=(['"])(.*?)\1/i);
    const id = customId || (idMatch ? idMatch[2] : `po_h_${headingCount++}`);
    
    let cleanAttrs = attrs;
    if (!idMatch) {
      cleanAttrs = `${attrs} id="${id}"`;
    } else if (customId) {
      cleanAttrs = attrs.replace(/id=(['"])(.*?)\1/i, `id="${id}"`);
    }

    const cleanText = cleanContent.replace(/<[^>]*>/g, '').trim();
    headings.push({
      text: cleanText,
      id,
      depth: tag.toLowerCase() === 'h3' ? 3 : 2
    });
    return `<${tag}${cleanAttrs}>${cleanContent}</${tag}>`;
  });
}

const processedPost = {
  ...post,
  contenido: modifiedContenido
};
---

<style slot="head" is:global set:html={estilosSlug + estilosContenido}></style>

<PostPage post={processedPost} headings={headings} prevPost={prevPost} nextPost={nextPost} lang={lang} translationSlug={translationSlug}>
  <PostSidebar post={processedPost} latest={latest} related={related} lang={lang} />
</PostPage>

<script>
  import { wicopy, showi, herowi, imgwii, getls, savels, wiSmart } from '../../../widev/widev.js';
  import { initYtModal,   cleanupYtModal   } from '../recursos/modalyt.js';
  import { initModalImgs, cleanupModalImgs } from '../recursos/modalimgs.js';

  let scrollListener: any  = null;
  let realtimeChannel: any  = null;
  let isPostCleanedUp = false;

  const getDb = async () => (await import('../../../supabase.js')).supabase;

  const initPost = () => {
    isPostCleanedUp = false;
    const postEl = document.querySelector('.po_wrap') as HTMLElement;
    if (!postEl) return;

    imgwii.ver('.po_wrap');

    const slug   = postEl.dataset.slug;
    const postId = postEl.dataset.id;
    const tSlug  = postEl.dataset.translationSlug;
    const pLang  = postEl.dataset.lang || 'es';
    if (!slug) return;

    // Switcher de idioma del footer dinámico si hay traducción vinculada (con setTimeout para evitar conflicto de carrera con el Footer)
    if (tSlug) {
      setTimeout(() => {
        const switcher = document.getElementById('footer-language-switcher');
        if (switcher) {
          if (pLang === 'es') {
            const btnEn = switcher.querySelector('[data-lang="en"]');
            if (btnEn) btnEn.setAttribute('href', `/en/${tSlug}`);
          } else {
            const btnEs = switcher.querySelector('[data-lang="es"]');
            if (btnEs) btnEs.setAttribute('href', `/${tSlug}`);
          }
        }
      }, 50);
    }

    // 1. Cargar estadísticas locales optimistas instantáneas
    const cached = getls(`wi_stats_${slug}`) || getls(`wi_post_${slug}`);
    if (cached) {
      document.querySelectorAll('.po_vistas_count_text').forEach((el: any) => el.textContent = String(cached.vistas || 0));
      document.querySelectorAll('.po_likes_count_text').forEach((el: any)  => el.textContent = String(cached.likes  || 0));
    }

    // 2. Barra de progreso de lectura
    const progress = document.getElementById('po_progress');
    if (progress) {
      scrollListener = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.width = total > 0 ? `${(window.scrollY / total) * 100}%` : '0%';
      };
      window.addEventListener('scroll', scrollListener);
    }

    // 3. Sistema de likes optimistas y RPC
    document.querySelectorAll('.po_like_sync').forEach((btn: any) => {
      if (localStorage.getItem(`wi_like_${slug}`)) btn.classList.add('active');

      btn.addEventListener('click', () => {
        const hasLiked = localStorage.getItem(`wi_like_${slug}`);
        const diff = hasLiked ? -1 : 1;

        if (hasLiked) {
          localStorage.removeItem(`wi_like_${slug}`);
          document.querySelectorAll('.po_like_sync').forEach((b: any) => b.classList.remove('active'));
        } else {
          localStorage.setItem(`wi_like_${slug}`, '1');
          document.querySelectorAll('.po_like_sync').forEach((b: any) => b.classList.add('active'));
        }

        document.querySelectorAll('.po_likes_count_text').forEach((el: any) => {
          el.textContent = String(Math.max(0, (parseInt(el.textContent || '0') || 0) + diff));
        });

        const cur = getls(`wi_stats_${slug}`) || { vistas: 0, likes: 0 };
        cur.likes = Math.max(0, (cur.likes || 0) + diff);
        savels(`wi_stats_${slug}`, cur, 1);

        if (diff > 0) {
          getDb().then((db: any) => db.rpc('incrementar_likes_blog', { post_slug: slug }));
        }
      });
    });

    // 4. Copiar Enlace
    document.querySelectorAll('.po_copy').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const postEl = document.querySelector('.po_wrap') as HTMLElement;
        const currentLang = postEl ? (window.location.pathname.startsWith('/en') ? 'en' : 'es') : 'es';
        const msg = currentLang === 'en' ? 'Link copied! 🔗' : '¡Enlace copiado! 🔗';
        wicopy(window.location.href, btn, msg);
      });
    });

    // 5. Inicializar modales
    initYtModal();
    initModalImgs('.po_contenido');

    // 6. wiSmart → Contador de vistas local/remoto + Canal WebSocket Realtime
    wiSmart({
      fn: [
        async () => {
          if (isPostCleanedUp) return;
          try {
            const db = await getDb();
            if (isPostCleanedUp) return;

            const viewMarkKey = `wi_view_${slug}`;
            let viewIncremented = false;

            if (!getls(viewMarkKey)) {
              savels(viewMarkKey, '1', 1);
              viewIncremented = true;

              const statsCached = getls(`wi_stats_${slug}`) || { vistas: 0, likes: 0 };
              statsCached.vistas = (statsCached.vistas || 0) + 1;
              savels(`wi_stats_${slug}`, statsCached, 1);
              
              document.querySelectorAll('.po_vistas_count_text').forEach((el: any) => {
                el.textContent = String(statsCached.vistas);
              });
            }

            if (viewIncremented) {
              await db.rpc('incrementar_vistas_blog', { post_slug: slug });
            }

            if (postId) {
              const { data } = await db.from('blog').select('likes, vistas').eq('id', postId).maybeSingle();
              if (isPostCleanedUp) return;
              if (data) {
                const localStats = getls(`wi_stats_${slug}`) || { vistas: 0 };
                const finalVistas = Math.max(data.vistas, localStats.vistas || 0);

                document.querySelectorAll('.po_likes_count_text').forEach((el: any)  => el.textContent = String(data.likes));
                document.querySelectorAll('.po_vistas_count_text').forEach((el: any) => el.textContent = String(finalVistas));
                savels(`wi_stats_${slug}`, { likes: data.likes, vistas: finalVistas }, 1);
              }

              if (isPostCleanedUp) return;
              realtimeChannel = db.channel(`stats_${postId}`)
                .on('postgres_changes', {
                  event: 'UPDATE',
                  schema: 'public',
                  table: 'blog',
                  filter: `id=eq.${postId}`
                }, (payload: any) => {
                  const { likes, vistas } = payload.new;
                  if (typeof likes  === 'number') document.querySelectorAll('.po_likes_count_text').forEach((el: any)  => el.textContent = String(likes));
                  if (typeof vistas === 'number') document.querySelectorAll('.po_vistas_count_text').forEach((el: any) => el.textContent = String(vistas));
                })
                .subscribe();

              if (isPostCleanedUp && realtimeChannel) {
                db.removeChannel(realtimeChannel);
                realtimeChannel = null;
              }
            }
          } catch (e: any) {
            console.error('[slug] Supabase init error:', e);
          }
        }
      ]
    });

    if (typeof herowi === 'function') herowi();
    if (typeof showi  === 'function') showi();
  };

  const cleanupPost = () => {
    isPostCleanedUp = true;
    if (scrollListener)  { window.removeEventListener('scroll', scrollListener); scrollListener = null; }
    if (realtimeChannel) { getDb().then((db: any) => { if (realtimeChannel) { db.removeChannel(realtimeChannel); realtimeChannel = null; } }); }
    cleanupYtModal();
    cleanupModalImgs();
  };

  document.addEventListener('astro:page-load', initPost);
  document.addEventListener('astro:before-preparation', cleanupPost);
</script>
