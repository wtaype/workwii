---
// src/lib/convertir/convertirPage.astro

import { app } from '../../../wii.js';

import estilosConvertir from './convertir.css?inline';
import { idiomaConvertir } from './idiomaConvertir.js';
import FooterConvertir from './footerConvertir.astro';

interface Props {lang: string;}
const { lang } = Astro.props as { lang: 'es' | 'en' };
const lg = idiomaConvertir[lang] || idiomaConvertir['es'];
---


  <style slot="head" is:global set:html={estilosConvertir}></style>

  <div class="conv_wrap">
    
    <!-- Encabezado general (Diseño Premium) -->
    <header class="conv_header">
      <div class="ats_header_glow"></div>
      <div class="ats_header_content">
        <h1 set:html={lg.header.tit}></h1>
        <p>{lg.header.desc}</p>
      </div>
    </header>

    <!-- PASO 1: SUBIR / PEGAR -->
    <section class="conv_step_card" id="convStep1">
      <h2 class="conv_card_tit"><i class="fas fa-file-invoice"></i> {lg.step1.tit}</h2>
      
      <div class="conv_field">
        
        <!-- Dropzone de archivo -->
        <div class="conv_dropzone" id="convDropzone">
          <i class="fas fa-cloud-arrow-up"></i>
          <span class="conv_dz_tit">{lg.step1.dzTit}</span>
          <span class="conv_dz_sub">{lg.step1.dzSub}</span>
          <input type="file" id="convFileInput" accept=".pdf,.docx" class="dpn">
        </div>

        <!-- Progreso de lectura -->
        <div id="convProgressContainer" class="upload_progress_container">
          <div class="upload_progress_header">
            <span><i class="fas fa-spinner fa-spin"></i> {lg.step1.progress}</span>
            <span id="convProgressPercent">0%</span>
          </div>
          <div class="upload_progress_bar_bg">
            <div id="convProgressBar" class="upload_progress_bar_fill"></div>
          </div>
        </div>

        <!-- Preview de archivo cargado -->
        <div id="convPreviewContainer" class="dpn"></div>
      </div>

      <!-- Textarea de revisión de texto extraído bruto -->
      <div class="conv_textarea_container" id="convTextareaContainer">
        <label for="convTextarea">{lg.step1.textareaLabel}</label>
        <textarea id="convTextarea" class="conv_field conv_raw_textarea" placeholder={lg.step1.textareaPl}></textarea>
      </div>

      <!-- Fila de Puesto Deseado e Idioma de Optimización -->
      <div class="conv_row_fields">
        <div class="conv_field flex_2">
          <label for="convTargetRole">
            {lg.step1.roleLabel}
            <i class="fas fa-circle-info ats_info_icon" data-witip={lg.step1.roleHelp} data-wtipo="info" data-wtiempo="4000"></i>
          </label>
          <input type="text" id="convTargetRole" placeholder={lg.step1.rolePl} />
        </div>
        <div class="conv_field flex_1">
          <label for="convTargetLang">
            {lg.step1.langLabel}
            <i class="fas fa-circle-info ats_info_icon" data-witip={lg.step1.langHelp} data-wtipo="info" data-wtiempo="4000"></i>
          </label>
          <select id="convTargetLang" class="conv_select">
            <option value="es" selected={lang === 'es'}>{lg.step1.langEs}</option>
            <option value="en" selected={lang === 'en'}>{lg.step1.langEn}</option>
          </select>
        </div>
      </div>

      <!-- Botón de Envío -->
      <button class="conv_btn" id="convBtnSubmit" disabled>
        <i class="fas fa-wand-magic-sparkles"></i> {lg.step1.btnSubmit}
      </button>
    </section>

    <!-- PASO 2: CARGANDO -->
    <section class="conv_loader" id="convLoader">
      <h3 class="loader_title"><i class="fas fa-brain" style="color:var(--mco); margin-right: 8px;"></i> <span id="convLoaderMsg">{lg.loader.tit}</span></h3>
      <p class="loader_eta" id="convLoaderEta">{lg.loader.desc}</p>

      <div class="loader_bar_wrap">
        <div class="loader_bar_header">
          <span>{lg.loader.progress}</span>
          <span id="convLoaderBarPct" style="color:var(--mco);font-family:var(--ff_O);font-weight:800;">0%</span>
        </div>
        <div class="loader_bar_bg">
          <div class="loader_bar_fill" id="convLoaderBarFill"></div>
        </div>
      </div>

      <div id="convLoaderStepper"></div>

      <div class="loader_tip_wrap">
        <span class="loader_tip_label"><i class="fas fa-lightbulb"></i> {lg.loader.tip}</span>
        <div id="convLoaderTipContent">{lg.loader.cargandoTip}</div>
      </div>
    </section>

    <!-- PASO 3: EDITAR Y PREVISUALIZAR (Split workspace) -->
    <main class="conv_workspace_split" id="convWorkspace" data-locale={lang}>
      
      <!-- Panel Izquierdo: Formularios -->
      <section class="conv_left_pane">
        <!-- Navegación interna de pestañas -->
        <div class="conv_tabs_header" id="convTabsHeader">
          <!-- Renderizado dinámico desde visual.js -->
        </div>

        <!-- Contenido dinámico del formulario -->
        <form id="convFormContent" onsubmit="return false;">
          <!-- Renderizado dinámico desde visual.js -->
        </form>
      </section>

      <!-- Panel Derecho: Vista previa y herramientas -->
      <section class="conv_right_pane">
        
        <!-- Barra de Herramientas -->
        <div class="conv_preview_tools">
          <div class="conv_preview_tools_left">
            <span><i class="fas fa-circle-check"></i> {lg.workspace.previewATS}</span>
            <button class="conv_tip_btn_icon" id="convPreviewTipFoto" title={lg.workspace.tipFoto} data-witip={lg.workspace.tipFotoDesc} data-wtipo="info" data-wtiempo="6000">
              <i class="fas fa-circle-info"></i>
            </button>
          </div>
        </div>

        <!-- Escritorio de Vista Previa -->
        <div class="conv_a4_wrapper">
          <div id="convPreviewA4">
            <!-- La hoja A4 se inyecta desde visual.js -->
          </div>
        </div>

      </section>
      
    </main>

    <!-- Panel Flotante de Burbujas (Estilo Chatwii) -->
    <div class="ats_floating_actions" id="botonesConvertir">
      
      <!-- Burbuja 1: Info Límite (Remaining conversions) -->
      <div class="ats_float_bubble ats_float_info" id="convSidebarLimit" data-witip="Conversiones gratis restantes" data-wtipo="right">
        <i class="fas fa-chart-pie"></i>
        <span id="convFreeCount">5/5</span>
      </div>
      
      <!-- Burbuja 2: Nueva Conversión (Reset) -->
      <button class="ats_float_bubble ats_float_btn_back" id="convBtnResetFloat" data-witip="Nueva Conversión" data-wtipo="right">
        <i class="fas fa-plus"></i>
      </button>
      
      <!-- Burbuja 3: Descargar -->
      <div class="ats_float_dropdown_wrap">
        <button class="ats_float_bubble ats_btn_download" id="convBtnDownloadDropdown" data-witip="Descargar CV" data-wtipo="right">
          <i class="fas fa-download"></i>
        </button>
        <div class="ats_float_dropdown_menu" id="convDownloadMenu">
          <button class="ats_dropdown_item" id="convBtnDownloadPdfDirect">
            <i class="fas fa-file-pdf"></i> {lg.workspace.btnPdf}
          </button>
          <button class="ats_dropdown_item" id="convBtnDownloadDocx">
            <i class="fas fa-file-word"></i> {lg.workspace.btnWord}
          </button>
          <button class="ats_dropdown_item" id="convBtnDownloadTxt">
            <i class="fas fa-file-lines"></i> {lg.workspace.btnTxt}
          </button>
          <button class="ats_dropdown_item" id="convBtnDownloadMd">
            <i class="fab fa-markdown"></i> {lg.workspace.btnMd}
          </button>
          <button class="ats_dropdown_item" id="convBtnDownloadJson">
            <i class="fas fa-file-code"></i> {lg.workspace.btnJson}
          </button>
        </div>
      </div>
    </div>

    <!-- Modal de confirmación para nuevo análisis (Bilingüe) -->
    <div class="wiModal" id="convModalConfirmReset">
      <div class="wiModal-content">
        <div class="modal_header">
          <h3 class="modal_title">{lg.workspace.confirmNewTitle}</h3>
          <button class="modalX" data-wimodal-close>&times;</button>
        </div>
        <div class="modal_body">
          <p>{lg.workspace.confirmNewDesc}</p>
        </div>
        <div class="modal_actions">
          <button class="modal_cancel_btn" data-wimodal-close>{lg.workspace.confirmCancel}</button>
          <button class="modal_confirm_btn" id="convBtnConfirmReset">{lg.workspace.confirmOk}</button>
        </div>
      </div>
    </div>

  </div>

  <FooterConvertir lang={lang} />


<script>
  import { initEntrada, removeFile } from './entrada.js';
  import { estructurarCvConIA } from './convertidor.js';
  import { initVisual, convertir_limites } from './visual.js';
  import { Notificacion, wiRateLimit, abrirModal, cerrarTodos } from '../../widev/widev.js';
  import { idiomaConvertir } from './idiomaConvertir.js';

  // Referencias a los pasos
  let step1: HTMLElement | null;
  let step2: HTMLElement | null;
  let step3: HTMLElement | null;
  let convHeader: HTMLElement | null;
  
  let btnSubmit: HTMLButtonElement | null;
  let loaderMsg: HTMLElement | null;
  const workspace = document.getElementById('convWorkspace');
  const pageLang = workspace?.getAttribute('data-locale') || 'es';
  const lg = (idiomaConvertir as any)[pageLang] || idiomaConvertir['es'];

  const init = () => {
    step1 = document.getElementById('convStep1');
    step2 = document.getElementById('convLoader');
    step3 = document.getElementById('convWorkspace');
    convHeader = document.querySelector('.conv_header') as HTMLElement;
    btnSubmit = document.getElementById('convBtnSubmit') as HTMLButtonElement;
    loaderMsg = document.getElementById('convLoaderMsg');

    // Inicializar lógica de lectura de archivos
    initEntrada(
      // Callback de extracción
      (text: string) => {
        const textareaContainer = document.getElementById('convTextareaContainer');
        if (textareaContainer) textareaContainer.style.display = 'flex';
        
        if (btnSubmit) {
          btnSubmit.disabled = !text.trim();
        }
      },
      // Callback de reset
      () => {
        const textareaContainer = document.getElementById('convTextareaContainer');
        if (textareaContainer) textareaContainer.style.display = 'none';
        if (btnSubmit) btnSubmit.disabled = true;
      }
    );

    // Eventos de botones
    btnSubmit?.addEventListener('click', procesarConversionConIA);
    document.getElementById('convBtnResetFloat')?.addEventListener('click', () => {
      abrirModal('convModalConfirmReset');
    });
    document.getElementById('convBtnConfirmReset')?.addEventListener('click', () => {
      cerrarTodos();
      reiniciarFlujo();
    });

    // Cargar caché local de CV activo (F5)
    const activeKey = localStorage.getItem('convertir_ats_active_key');
    if (activeKey) {
      const cached = localStorage.getItem(activeKey);
      if (cached) {
        try {
          const parsed = JSON.parse(cached);
          if (step1) step1.style.display = 'none';
          if (step3) step3.style.display = 'grid';
          if (convHeader) convHeader.style.display = 'none';
          initVisual(parsed);
          return;
        } catch (e) {
          console.error('Error al cargar caché local:', e);
        }
      }
    }
  };

  const getLoaderSteps = () => {
    const isEn = pageLang === 'en';
    return [
      { icon: 'fa-file-import',          label: isEn ? 'Reading resume structure...' : 'Leyendo estructura del CV...',                   sub: isEn ? 'Extracting text and meta-data' : 'Extrayendo texto y metadatos' },
      { icon: 'fa-sitemap',              label: isEn ? 'Structuring data...' : 'Estructurando datos...',                             sub: isEn ? 'Organizing sections into standard ATS' : 'Organizando secciones en formato ATS estándar' },
      { icon: 'fa-brain',                label: isEn ? 'Optimizing achievements...' : 'Optimizando logros...',                         sub: isEn ? 'Polishing achievements with action verbs' : 'Puliendo logros con verbos de acción' },
      { icon: 'fa-magnifying-glass-chart', label: isEn ? 'Aligning skills...' : 'Alineando habilidades...',                             sub: isEn ? 'Matching technical capabilities' : 'Mapeando capacidades técnicas' },
      { icon: 'fa-wand-magic-sparkles',    label: isEn ? 'Ensuring layout readability...' : 'Asegurando legibilidad de formato...',       sub: isEn ? 'Readying single-column template layout' : 'Preparando el diseño de columna única' }
    ];
  };

  const procesarConversionConIA = async () => {
    const rawTextarea = document.getElementById('convTextarea') as HTMLTextAreaElement;
    const targetRoleInp = document.getElementById('convTargetRole') as HTMLInputElement;

    if (!rawTextarea || !rawTextarea.value.trim()) {
      Notificacion(lg.step1.textareaPl, 'warning');
      return;
    }

    // Control de límite de uso contra abusos
    const isLogged = localStorage.getItem('wiSmile');
    let rate: any = null;

    if (!isLogged) {
      rate = wiRateLimit('ats_cv_conversion', convertir_limites, 315360000000 as any);
      if (!rate.ok) {
        const msg = pageLang === 'en'
          ? `You have reached the limit of ${convertir_limites} test conversions. Register for free to continue without limits.`
          : `Has alcanzado el límite de ${convertir_limites} conversiones de prueba. Regístrate gratis para continuar sin límites.`;
        Notificacion(msg, 'warning', 6000);
        const { abrirLogin } = await import('../../wiauth/visual.js');
        abrirLogin('registrar');
        return;
      }
    } else {
      rate = wiRateLimit('ats_cv_conversion', convertir_limites, 'dia');
      if (!rate.ok) {
        const msg = pageLang === 'en'
          ? `Daily limit reached (${convertir_limites} conversions). Return in ${rate.min} minutes.`
          : `Límite diario alcanzado (${convertir_limites} conversiones). Regresa en ${rate.min} minutos.`;
        Notificacion(msg, 'warning', 5000);
        return;
      }
    }

    // Transicionar al Paso 2: Loader
    if (step1) step1.style.display = 'none';
    if (step2) step2.style.display = 'flex';

    // Inicializar stepper
    const stepperEl = document.getElementById('convLoaderStepper');
    const barFill   = document.getElementById('convLoaderBarFill') as HTMLElement;
    const barPct    = document.getElementById('convLoaderBarPct');
    const etaEl     = document.getElementById('convLoaderEta');

    const steps = getLoaderSteps();
    if (stepperEl) {
      stepperEl.innerHTML = steps.map((s, i) => `
        <div class="loader_step" id="cstep_${i}">
          <div class="loader_step_icon pending"><i class="fas ${s.icon}"></i></div>
          <div class="loader_step_body">
            <span class="loader_step_label">${s.label}</span>
            <span class="loader_step_sub">${s.sub}</span>
          </div>
          <div class="loader_step_check"><i class="fas fa-check"></i></div>
        </div>
      `).join('');
    }

    let pct = 0;
    const totalSteps = steps.length;
    const stepDuration = 2200; // ms por paso (total ~11 segundos)
    const totalDuration = stepDuration * totalSteps;

    const activateStep = (idx: number) => {
      if (idx > 0) {
        const prev = document.getElementById(`cstep_${idx - 1}`);
        if (prev) {
          prev.classList.remove('active');
          prev.classList.add('done');
        }
      }
      const curr = document.getElementById(`cstep_${idx}`);
      if (curr) curr.classList.add('active');
    };

    // Barra de progreso suave
    const startTime = performance.now();
    let animationFrameId: number;
    const animBar = (time: number) => {
      const elapsed = time - startTime;
      pct = Math.min(Math.round((elapsed / totalDuration) * 95), 95);
      if (barFill) barFill.style.width = `${pct}%`;
      if (barPct)  barPct.textContent  = `${pct}%`;

      const remaining = Math.max(0, Math.round((totalDuration - elapsed) / 1000));
      const isEn = pageLang === 'en';
      if (etaEl) {
        etaEl.textContent = remaining > 0 
          ? (isEn ? `~${remaining}s remaining` : `~${remaining}s restantes`) 
          : (isEn ? 'Finishing...' : 'Finalizando...');
      }

      if (pct < 95) {
        animationFrameId = requestAnimationFrame(animBar);
      }
    };
    animationFrameId = requestAnimationFrame(animBar);

    activateStep(0);
    const stepTimers: any[] = [];
    for (let i = 1; i < totalSteps; i++) {
      const t = setTimeout(() => activateStep(i), stepDuration * i);
      stepTimers.push(t);
    }

    // Rotación de tips de carga
    const tipsList = pageLang === 'en' ? [
      'Two-column layouts are hard for some ATS. Single-column is safer.',
      'Always start your bullet points with action verbs like Developed, Managed, Built.',
      'Including a photo can sometimes trigger format errors in automated parsers.',
      'Focus on metrics (percentages, numbers) to show real job impact.',
      'Avoid text inside shapes, images or non-standard fonts.',
      'List certifications and online courses with the issuing entity and year.',
      'Make sure to name your featured projects and list the key technologies used.',
      'Use a professional email address (first.last@domain.com) for high readability.'
    ] : [
      'Los formatos de dos columnas a veces confunden al ATS. El de columna única es el más seguro.',
      'Comienza cada logro con verbos de acción fuertes como Diseñé, Implementé, Automaticé.',
      'Incluir una foto a veces puede disparar errores de lectura en filtros ATS internacionales.',
      'Usa porcentajes y números para cuantificar tus logros y demostrar impacto.',
      'Evita cuadros de texto flotantes, gráficos de barras o fuentes no estándar.',
      'Menciona tus certificaciones y cursos con la entidad emisora y el año de obtención.',
      'Identifica tus proyectos destacados y detalla las tecnologías utilizadas.',
      'Utiliza un correo profesional legible (nombre.apellido@dominio.com) para evitar filtros.'
    ];
    let tipIdx = 0;
    const tipContainer = document.getElementById('convLoaderTipContent');
    const rotateTips = setInterval(() => {
      if (tipContainer) {
        tipContainer.style.opacity = '0';
        setTimeout(() => {
          tipContainer.innerHTML = `<i class="fas fa-lightbulb" style="color:var(--mco); margin-right: 8px;"></i> ${tipsList[tipIdx]}`;
          tipContainer.style.opacity = '1';
          tipIdx = (tipIdx + 1) % tipsList.length;
        }, 300);
      }
    }, 3500);

    try {
      const textToConvert = rawTextarea.value.trim();
      const targetRole = targetRoleInp ? targetRoleInp.value.trim() : '';
      const targetLangSelect = document.getElementById('convTargetLang') as HTMLSelectElement;
      const targetLang = targetLangSelect ? targetLangSelect.value : 'es';

      // Llamada a la IA de Workwii
      const structuredCv = await estructurarCvConIA(textToConvert, targetRole, targetLang);

      // Finalizar loader de forma bonita
      cancelAnimationFrame(animationFrameId);
      clearInterval(rotateTips);
      stepTimers.forEach(t => clearTimeout(t));
      
      const lastStep = document.getElementById(`cstep_${steps.length - 1}`);
      if (lastStep) {
        lastStep.classList.remove('active');
        lastStep.classList.add('done');
      }
      if (barFill) barFill.style.width = '100%';
      if (barPct) barPct.textContent = '100%';
      if (etaEl) etaEl.textContent = pageLang === 'en' ? 'Finished!' : '¡Estructurado!';

      setTimeout(() => {
        // Guardar en caché local
        const cacheKey = `convertir_ats_${Date.now()}`;
        localStorage.setItem(cacheKey, JSON.stringify(structuredCv));
        localStorage.setItem('convertir_ats_active_key', cacheKey);

        if (step2) step2.style.display = 'none';
        if (step3) step3.style.display = 'grid';
        if (convHeader) convHeader.style.display = 'none';

        // Descontar del rate limit (Consumir un intento exitoso)
        if (rate) rate.fail();

        initVisual(structuredCv);

        Notificacion(lg.workspace.successMsg, 'success', 4000);
      }, 500);
    } catch (err: any) {
      console.error(err);
      cancelAnimationFrame(animationFrameId);
      clearInterval(rotateTips);
      stepTimers.forEach(t => clearTimeout(t));

      if (step2) step2.style.display = 'none';
      if (step1) step1.style.display = 'flex';
      
      const failMsg = pageLang === 'en'
        ? 'Could not complete the structuring with the AI.'
        : 'No se pudo completar la estructuración con la IA.';
      Notificacion(err.message || failMsg, 'error');
    }
  };

  const reiniciarFlujo = () => {
    // Limpiar caché activa
    localStorage.removeItem('convertir_ats_active_key');

    // Resetear archivos
    removeFile();
    
    // Limpiar input del puesto e idioma
    const targetRoleInp = document.getElementById('convTargetRole') as HTMLInputElement;
    if (targetRoleInp) targetRoleInp.value = '';

    const targetLangSelect = document.getElementById('convTargetLang') as HTMLSelectElement;
    if (targetLangSelect) targetLangSelect.value = 'es';

    // Volver a mostrar pantalla de subida
    if (step3) step3.style.display = 'none';
    if (step2) step2.style.display = 'none';
    if (step1) step1.style.display = 'flex';
    if (convHeader) convHeader.style.display = 'block';

    const floatBar = document.getElementById('botonesConvertir');
    if (floatBar) floatBar.classList.remove('show');
  };

  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('.conv_wrap')) {
      init();
    }
  });
</script>
