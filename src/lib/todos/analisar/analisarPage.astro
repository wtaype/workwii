---
// src/lib/analisar/analisarPage.astro

import { app } from '../../../wii.js';
import estilosAnalisar from './analisar.css?inline';
import { idiomaAnalisar } from './idiomaAnalisar.js';

const lang = Astro.locals.lang;
const lg   = idiomaAnalisar[lang];
---


  <style slot="head" is:global set:html={estilosAnalisar}></style>

  <div class="anal_ats">
    
    <!-- CABECERA HÉROE -->
    <header class="ats_header">
      <div class="ats_header_glow"></div>
      <div class="ats_header_content">
        <h1 set:html={lg.header.tit}></h1>
        <p>{lg.header.desc}</p>
      </div>
    </header>

    <!-- FORMULARIO DE ENTRADA -->
    <main id="atsWorkspace" data-locale={lang}>
      
      <div class="ats_card ats_entry_card">
        <h2 class="ats_card_tit"><i class="fas fa-file-invoice"></i> {lg.entry.tit}</h2>
        
        <div class="ats_file_field">
          <label class="ats_file_label">{lg.entry.fileLabel}</label>
          <!-- Dropzone de archivo -->
          <div class="ats_dropzone" id="atsDropzone">
            <i class="fas fa-cloud-upload-alt"></i>
            <span class="ats_dz_tit">{lg.entry.dzTit}</span>
            <span class="ats_dz_sub">{lg.entry.dzSub}</span>
            <input type="file" id="fileInput" accept=".pdf,.docx">
          </div>
          
          <!-- Contenedor de progreso de subida -->
          <div id="uploadProgressContainer" class="upload_progress_container">
            <div class="upload_progress_header">
              <span class="upload_progress_label">
                <i class="fas fa-spinner fa-spin"></i> {lg.entry.progress}
              </span>
              <span id="uploadProgressPercent" class="upload_progress_percent">0%</span>
            </div>
            <div class="upload_progress_bar_bg">
              <div id="uploadProgressBar" class="upload_progress_bar_fill"></div>
            </div>
          </div>

          <div id="filePreviewContainer"></div>
        </div>

        <!-- Fila de Puesto de Interés e Idioma -->
        <div class="ats_row_fields">
          <div class="ats_field flex_2">
            <label for="atsTargetRole">{lg.entry.roleLabel}</label>
            <input type="text" id="atsTargetRole" class="ats_input" placeholder={lg.entry.rolePl} />
          </div>
          <div class="ats_field flex_1">
            <label for="atsTargetLang">{lg.entry.langLabel}</label>
            <select id="atsTargetLang" class="ats_select">
              <option value="es" selected={lang === 'es'}>{lg.entry.langEs}</option>
              <option value="en" selected={lang === 'en'}>{lg.entry.langEn}</option>
            </select>
          </div>
        </div>

        <!-- Botón de Análisis -->
        <button id="btnAnalyze" class="ats_btn" disabled>
          <i class="fa-solid fa-wand-magic-sparkles"></i> {lg.entry.btnAnalyze}
        </button>
      </div>

    </main>

    <!-- PANTALLA DE CARGA PREMIUM (STEPPER) -->
    <section class="ats_card ats_loader" id="atsLoader">
      <h3 class="loader_title"><i class="fas fa-brain" style="color:var(--mco);"></i> {lg.loader.tit}</h3>
      <p class="loader_eta" id="loaderEta">{lg.loader.eta}</p>

      <!-- Barra de progreso -->
      <div class="loader_bar_wrap">
        <div class="loader_bar_header">
          <span>{lg.loader.progress}</span>
          <span id="loaderBarPct" style="color:var(--mco);font-family:var(--ff_O);font-weight:800;">0%</span>
        </div>
        <div class="loader_bar_bg">
          <div class="loader_bar_fill" id="loaderBarFill"></div>
        </div>
      </div>

      <!-- Stepper de 5 fases -->
      <div id="loaderStepper"></div>

      <!-- Tip rotativo -->
      <div class="loader_tip_wrap">
        <span class="loader_tip_label"><i class="fas fa-lightbulb"></i> {lg.loader.tip}</span>
        <div id="loaderTipContent">{lg.loader.cargandoTip}</div>
      </div>
    </section>

    <!-- RESULTADOS DETALLADOS -->
    <section class="ats_results" id="atsResults">
      <div class="ats_dashboard_split">
        
        <!-- COLUMNA IZQUIERDA: SCORE & BREAKDOWN (STICKY) -->
        <div class="ats_dash_left">
          
          <!-- Círculo de puntuación circular -->
          <div class="ats_card ats_gauge_card">
            <h3 class="ats_card_tit ats_gauge_tit"><i class="fas fa-chart-line"></i> {lg.results.gaugeTit}</h3>
            <div class="ats_gauge_wrap">
              <div class="ats_gauge_glow_center"></div>
              <svg class="ats_gauge" viewBox="0 0 100 100">
                <circle class="ats_gauge_bg" cx="50" cy="50" r="45"></circle>
                <circle class="ats_gauge_fill" cx="50" cy="50" r="45" id="gaugeCircle"></circle>
              </svg>
              <div class="ats_gauge_text">
                <span class="ats_gauge_num" id="gaugeNum">0%</span>
                <span class="ats_gauge_lbl">ATS Match</span>
              </div>
            </div>
            <span class="ats_status_badge" id="gaugeStatus">{lg.results.gaugeStatus}</span>

            <!-- Banda de contexto del score -->
            <div id="scoreContextBand" class="score_context_band band_good">{lg.results.readyToApply}</div>

            <!-- Stat chips -->
            <div class="stat_chips_row" id="statChips">
              <span class="stat_chip"><i class="fas fa-file-lines"></i> 1 {lg.results.paginas}</span>
              <span class="stat_chip"><i class="fas fa-align-left"></i> 0 {lg.results.palabras}</span>
              <span class="stat_chip"><i class="fas fa-layer-group"></i> 0/6 {lg.results.secciones}</span>
            </div>

            <!-- Semáforo de legibilidad ATS -->
            <div id="atsSemaforo" class="ats_semaforo sem_ok">
              <span class="sem_dot"></span>
              <span>{lg.results.verificando}</span>
            </div>
          </div>

          <!-- Desglose Analítico (Breakdown) -->
          <div class="ats_card ats_breakdown_card">
            <h3 class="ats_card_tit ats_breakdown_tit"><i class="fas fa-list-check"></i> {lg.results.breakdownTit}</h3>
            <div class="ats_breakdown_items">
              <div class="breakdown_item">
                <div class="breakdown_header">
                  <span><i class="far fa-address-card breakdown_icon"></i> {lg.results.breakdownContact}</span>
                  <span id="scoreContact">0%</span>
                </div>
                <div class="breakdown_bar_bg">
                  <div class="breakdown_bar_fill" id="barContact"></div>
                </div>
              </div>
              <div class="breakdown_item">
                <div class="breakdown_header">
                  <span><i class="fas fa-briefcase breakdown_icon"></i> {lg.results.breakdownExperience}</span>
                  <span id="scoreExperience">0%</span>
                </div>
                <div class="breakdown_bar_bg">
                  <div class="breakdown_bar_fill" id="barExperience"></div>
                </div>
              </div>
              <div class="breakdown_item">
                <div class="breakdown_header">
                  <span><i class="fas fa-graduation-cap breakdown_icon"></i> {lg.results.breakdownEducation}</span>
                  <span id="scoreEducation">0%</span>
                </div>
                <div class="breakdown_bar_bg">
                  <div class="breakdown_bar_fill" id="barEducation"></div>
                </div>
              </div>
              <div class="breakdown_item">
                <div class="breakdown_header">
                  <span><i class="fas fa-award breakdown_icon"></i> {lg.results.breakdownSkills}</span>
                  <span id="scoreSkills">0%</span>
                </div>
                <div class="breakdown_bar_bg">
                  <div class="breakdown_bar_fill" id="barSkills"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Benchmark comparativo -->
          <div class="ats_card">
            <h3 class="ats_card_tit" style="font-size:var(--fz_m1);"><i class="fas fa-chart-bar"></i> {lg.results.compareTit}</h3>
            <div id="benchmarkCard"></div>
          </div>

        </div>

        <!-- COLUMNA DERECHA: CENTRO DE ANÁLISIS DE PESTAÑAS -->
        <div class="ats_dash_right">
          
          <!-- Pestañas Pills del Dashboard -->
          <div class="ats_dashboard_tabs">
            <button class="ats_dash_tab active" data-dash-tab="resumen">
              <i class="fas fa-circle-info"></i> {lg.tabs.diagnostico}
            </button>
            <button class="ats_dash_tab" data-dash-tab="plan">
              <i class="fas fa-clipboard-list"></i> {lg.tabs.plan}
            </button>
            <button class="ats_dash_tab" data-dash-tab="formato">
              <i class="fas fa-robot"></i> {lg.tabs.formato}
            </button>
          </div>

          <!-- CONTENIDO DE PESTAÑAS -->
          <div class="ats_dashboard_tab_content">
            
            <!-- PESTAÑA 1: DIAGNÓSTICO -->
            <div class="ats_dash_pane active" id="paneResumen">
              <div class="ats_card ats_feedback_card">
                <h3 class="ats_feedback_title">{lg.diagnostico.compatibilidadTit}</h3>
                <p class="ats_feedback_text" id="resultSummary">{lg.diagnostico.compatibilidadLoading}</p>
              </div>

              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-id-card"></i> {lg.diagnostico.detectedTit}</h3>
                <p class="ats_tab_desc">{lg.diagnostico.detectedDesc}</p>
                <div id="detectedProfileCard" style="display:flex;flex-direction:column;gap:1vh;"></div>
              </div>

              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-pen-fancy"></i> {lg.diagnostico.langQualTit}</h3>
                <p class="ats_tab_desc">{lg.diagnostico.langQualDesc}</p>
                <div id="languageQualityCard"></div>
              </div>

              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-tags"></i> {lg.diagnostico.kwTit}</h3>
                <p class="ats_tab_desc">{lg.diagnostico.kwDesc}</p>
                <div class="ats_keyword_grid">
                  <div class="ats_kw_group matched">
                    <h4><i class="fas fa-check-circle"></i> {lg.diagnostico.kwMatched}</h4>
                    <div class="ats_badge_container" id="matchedKeywordsContainer"></div>
                  </div>
                  <div class="ats_kw_group missing">
                    <h4><i class="fas fa-exclamation-triangle"></i> {lg.diagnostico.kwMissing}</h4>
                    <div class="ats_badge_container" id="missingKeywordsContainer"></div>
                  </div>
                </div>
              </div>

              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-lightbulb"></i> {lg.diagnostico.recTit}</h3>
                <div id="scoreTipsContainer"></div>
              </div>
            </div>

            <!-- PESTAÑA 3: PLAN DE ACCIÓN -->
            <div class="ats_dash_pane" id="panePlan">
              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-list-check"></i> {lg.plan.tit}</h3>
                <p class="ats_tab_desc">{lg.plan.desc}</p>
                
                <div class="plan_progress_wrap" id="planProgressWrap">
                  <div class="plan_progress_header">
                    <span>{lg.plan.progreso}</span>
                    <span id="planProgressPercent">0%</span>
                  </div>
                  <div class="plan_progress_bar_bg">
                    <div id="planProgressBar"></div>
                  </div>
                  <span id="planProgressText">{lg.plan.completadas.replace('{done}', '0').replace('{total}', '0')}</span>
                </div>

                <div class="ats_rec_list" id="recommendationsContainer"></div>
              </div>
            </div>

            <!-- PESTAÑA 4: FORMATO ATS -->
            <div class="ats_dash_pane" id="paneFormato">
              <div class="ats_card">
                <h3 class="ats_card_tit"><i class="fas fa-robot"></i> {lg.formato.tit}</h3>
                <p class="ats_tab_desc_lg">{lg.formato.desc}</p>
                
                <div class="ats_audit_list" id="atsAuditList"></div>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- Panel Flotante de Burbujas (Estilo Chatwii) -->
      <div class="ats_floating_actions" id="atsFloatingActions">
        
        <!-- Burbuja 1: Info Límite -->
        <div class="ats_float_bubble ats_float_info" id="atsSidebarLimit" data-witip="Análisis gratis restantes" data-wtipo="info">
          <i class="fas fa-chart-pie"></i>
          <span id="atsFreeCount">5/5</span>
        </div>
        
        <!-- Burbuja 2: Nuevo Análisis -->
        <button class="ats_float_bubble ats_float_btn_back" id="btnBack" data-witip="Nuevo Análisis" data-wtipo="top">
          <i class="fas fa-plus"></i>
        </button>
        
        <!-- Burbuja 3: Descargar -->
        <div class="ats_float_dropdown_wrap">
          <button class="ats_float_bubble ats_btn_download" id="btnDownloadDropdown" data-witip="Descargar Reporte" data-wtipo="top">
            <i class="fas fa-download"></i>
          </button>
          <div class="ats_float_dropdown_menu" id="downloadMenu">
            <button class="ats_dropdown_item" id="btnCopyReport">
              <i class="fas fa-copy"></i> {lg.results.btnCopy}
            </button>
            <button class="ats_dropdown_item" id="btnDownloadTxt">
              <i class="fas fa-file-lines"></i> {lg.results.btnDownloadTxt}
            </button>
            <button class="ats_dropdown_item" id="btnDownloadMd">
              <i class="fas fa-file-code"></i> Descargar Markdown (.md)
            </button>
            <button class="ats_dropdown_item" id="btnDownloadDocx">
              <i class="fas fa-file-word"></i> {lg.results.btnDownloadDocx}
            </button>
            <button class="ats_dropdown_item" id="btnDownloadPdf">
              <i class="fas fa-file-pdf"></i> {lg.results.btnDownloadPdf}
            </button>
            <button class="ats_dropdown_item" id="btnDownloadJson">
              <i class="fas fa-file-code"></i> {lg.results.btnDownloadJson}
            </button>
          </div>
        </div>
      </div>

    </section>

    <!-- Modal de confirmación para nuevo análisis (Bilingüe) -->
    <div class="wiModal" id="modalConfirmBack">
      <div class="wiModal-content">
        <div class="modal_header">
          <h3 class="modal_title">{lg.results.confirmNewTitle}</h3>
          <button class="modalX" data-wimodal-close>&times;</button>
        </div>
        <p class="modal_desc">
          {lg.results.confirmNewDesc}
        </p>
        <div class="modal_actions">
          <button class="ats_btn_sec modal_cancel_btn" data-wimodal-close>{lg.results.confirmCancel}</button>
          <button class="ats_btn modal_confirm_btn" id="btnConfirmReset">{lg.results.confirmAccept}</button>
        </div>
      </div>
    </div>

  </div>


<script>
  import { initVisual } from './visual.js';
  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('.anal_ats')) {
      const workspace = document.getElementById('atsWorkspace');
      const pageLang = workspace?.getAttribute('data-locale') || 'es';
      initVisual(pageLang);
    }
  });
</script>
