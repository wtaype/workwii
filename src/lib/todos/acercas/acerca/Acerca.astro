---
import Layout from '../../../../layouts/Layout.astro';
import { app } from '../../../../wii.js';
import { seo } from '../../../../lib/seo.js';
import { idiomaAcerca } from './idiomaAcerca.js';
import estilosAcercas from '../acercas.css?inline';

const { lang = 'es' } = Astro.props as { lang?: 'es' | 'en' };
const t = (idiomaAcerca as any)[lang] || idiomaAcerca['es'];

// Rutas dinámicas localizadas
const route = (path: string) => lang === 'en' ? `/en${path}` : path;
---


<Layout {...(lang === 'en' ? (seo.acerca as any).en : (seo.acerca as any).es)}>
  <style is:global set:html={estilosAcercas}></style>
  
  <div class="ac_wrap">

  <!-- ══ HERO ══ -->
  <section class="ac_hero">
    <div class="ac_hero_orb ac_orb1"></div>
    <div class="ac_hero_orb ac_orb2"></div>
    <div class="ac_hero_orb ac_orb3"></div>
    <div class="ac_hero_body">
      <div class="ac_hero_logo">
        <img src="/logo_square.webp" alt={app} loading="lazy">
      </div>
      <div class="ac_hero_badge"><i class="fas fa-briefcase"></i> {t.hero.badge}</div>
      <h1 class="ac_hero_tit">{t.hero.tit1}</h1>
      <p class="ac_hero_sub">{t.hero.sub}</p>
      
      <div class="ac_hero_stats">
          <div class="ac_stat" style="--sc:#0EBEFF">
            <i class="fas fa-file-invoice" style="color:#0EBEFF"></i>
            <strong>{t.hero.stat1_num}</strong>
            <span>{t.hero.stat1_lbl}</span>
          </div>
          <div class="ac_stat" style="--sc:#FF5C69">
            <i class="fas fa-heart" style="color:#FF5C69"></i>
            <strong>{t.hero.stat2_num}</strong>
            <span>{t.hero.stat2_lbl}</span>
          </div>
          <div class="ac_stat" style="--sc:#29C72E">
            <i class="fas fa-robot" style="color:#29C72E"></i>
            <strong>{t.hero.stat3_num}</strong>
            <span>{t.hero.stat3_lbl}</span>
          </div>
          <div class="ac_stat" style="--sc:#7000FF">
            <i class="fas fa-check-double" style="color:#7000FF"></i>
            <strong>{t.hero.stat4_num}</strong>
            <span>{t.hero.stat4_lbl}</span>
          </div>
      </div>
      
      <div class="ac_hero_btns">
        <a href={route('/crear')} class="ac_btn_p"><i class="fas fa-file-signature"></i> {t.hero.btnOptimizar}</a>
        <button class="ac_btn_s" id="ac_compartir" data-share-text={t.shareText} data-share-copied={t.hero.btnCompartido}><i class="fas fa-share-nodes"></i> {t.hero.btnCompartir}</button>
      </div>
      <div class="ac_hero_scroll"><i class="fas fa-chevron-down"></i></div>
    </div>
  </section>

  <!-- ══ COUNTER BAND ══ -->
  <div class="ac_counter_band">
    <div class="ac_counter_item">
      <span class="ac_counter_num" data-target={t.counters.c1_num}>{t.counters.c1_num}</span><span>%</span>
      <p>{t.counters.c1_lbl}</p>
    </div>
    <div class="ac_counter_sep"></div>
    <div class="ac_counter_item">
      <span class="ac_counter_num" data-target={t.counters.c2_num}>{t.counters.c2_num}</span><span>%</span>
      <p>{t.counters.c2_lbl}</p>
    </div>
    <div class="ac_counter_sep"></div>
    <div class="ac_counter_item">
      <i class="fas fa-infinity" style="font-size: var(--fz_l2); color: var(--tx);"></i>
      <p>{t.counters.c3_lbl}</p>
    </div>
    <div class="ac_counter_sep"></div>
    <div class="ac_counter_item">
      <span class="ac_counter_num" data-target={t.counters.c4_num}>{t.counters.c4_num}</span>
      <p>{t.counters.c4_lbl}</p>
    </div>
  </div>

  <!-- ══ NUESTRA HISTORIA ══ -->
  <section class="ac_sec">
    <div class="ac_sec_head">
      <div class="ac_sec_badge"><i class="fas fa-heart"></i> {t.historia.badge}</div>
      <h2 class="ac_sec_tit">{t.historia.tit} <span class="ac_grad">{app}</span></h2>
    </div>
    <div class="ac_historia wi_fadeUp">
      <p set:html={t.historia.p1}></p>
      <p set:html={t.historia.p2}></p>
      <p set:html={t.historia.p3}></p>
      <p set:html={t.historia.p4}></p>
      <p set:html={t.historia.p5}></p>

      <div class="ac_firma">
        <strong>{t.historia.firmaNombre}</strong>
        <span>{t.historia.firmaRol}</span>
      </div>
    </div>
  </section>

  <!-- ══ BENEFICIOS ══ -->
  <section class="ac_sec ac_sec_alt">
    <div class="ac_sec_head">
      <div class="ac_sec_badge"><i class="fas fa-star"></i> {t.beneficios.badge}</div>
      <h2 class="ac_sec_tit">{t.beneficios.tit}<span class="ac_grad">{t.beneficios.titGrad}</span></h2>
      <p class="ac_sec_sub">{t.beneficios.sub}</p>
    </div>
    <div class="ac_feat_grid">
        <div class="ac_feat_card wi_fadeUp ac_color_cielo">
          <div class="ac_feat_ico"><i class="fas fa-file-lines"></i></div>
          <h3>{t.beneficios.b1_tit}</h3>
          <p>{t.beneficios.b1_desc}</p>
        </div>
        <div class="ac_feat_card wi_fadeUp ac_color_dulce">
          <div class="ac_feat_ico"><i class="fas fa-magnifying-glass-chart"></i></div>
          <h3>{t.beneficios.b2_tit}</h3>
          <p>{t.beneficios.b2_desc}</p>
        </div>
        <div class="ac_feat_card wi_fadeUp ac_color_paz">
          <div class="ac_feat_ico"><i class="fas fa-comments"></i></div>
          <h3>{t.beneficios.b3_tit}</h3>
          <p>{t.beneficios.b3_desc}</p>
        </div>
        <div class="ac_feat_card wi_fadeUp ac_color_mora">
          <div class="ac_feat_ico"><i class="fas fa-lightbulb"></i></div>
          <h3>{t.beneficios.b4_tit}</h3>
          <p>{t.beneficios.b4_desc}</p>
        </div>
        <div class="ac_feat_card wi_fadeUp ac_color_cielo">
          <div class="ac_feat_ico"><i class="fas fa-wand-magic-sparkles"></i></div>
          <h3>{t.beneficios.b5_tit}</h3>
          <p>{t.beneficios.b5_desc}</p>
        </div>
        <div class="ac_feat_card wi_fadeUp ac_color_dulce">
          <div class="ac_feat_ico"><i class="fas fa-mobile-screen"></i></div>
          <h3>{t.beneficios.b6_tit}</h3>
          <p>{t.beneficios.b6_desc}</p>
        </div>
    </div>
  </section>

  <!-- ══ CÓMO FUNCIONA ══ -->
  <section class="ac_sec">
    <div class="ac_sec_head">
      <div class="ac_sec_badge"><i class="fas fa-route"></i> {t.pasos.badge}</div>
      <h2 class="ac_sec_tit">{t.pasos.tit}<span class="ac_grad">{t.pasos.titGrad}</span></h2>
      <p class="ac_sec_sub">{t.pasos.sub}</p>
    </div>
    <div class="ac_pasos">
        <div class="ac_paso wi_fadeUp">
          <div class="ac_paso_num">1</div>
          <div class="ac_paso_ico"><i class="fas fa-pen-nib"></i></div>
          <h3>{t.pasos.p1_tit}</h3>
          <p>{t.pasos.p1_desc}</p>
        </div>
        <div class="ac_paso_sep"><i class="fas fa-chevron-right"></i></div>
        <div class="ac_paso wi_fadeUp">
          <div class="ac_paso_num">2</div>
          <div class="ac_paso_ico"><i class="fas fa-chart-line"></i></div>
          <h3>{t.pasos.p2_tit}</h3>
          <p>{t.pasos.p2_desc}</p>
        </div>
        <div class="ac_paso_sep"><i class="fas fa-chevron-right"></i></div>
        <div class="ac_paso wi_fadeUp">
          <div class="ac_paso_num">3</div>
          <div class="ac_paso_ico"><i class="fas fa-user-astronaut"></i></div>
          <h3>{t.pasos.p3_tit}</h3>
          <p>{t.pasos.p3_desc}</p>
        </div>
    </div>
  </section>

  <!-- ══ TESTIMONIOS ══ -->
  <section class="ac_sec ac_sec_alt">
    <div class="ac_sec_head">
      <div class="ac_sec_badge"><i class="fas fa-comments"></i> {t.testimonios.badge}</div>
      <h2 class="ac_sec_tit">{t.testimonios.tit}<span class="ac_grad">{app}</span></h2>
      <p class="ac_sec_sub">{t.testimonios.sub}</p>
    </div>
    <div class="ac_test_grid">
        <div class="ac_test_card wi_fadeUp">
          <div class="ac_test_stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <p class="ac_test_txt">{t.testimonios.t1_txt}</p>
          <div class="ac_test_autor">
            <span class="ac_test_avatar"><i class="fas fa-user-graduate"></i></span>
            <div><strong>{t.testimonios.t1_aut}</strong><span>{t.testimonios.t1_crg}</span></div>
          </div>
        </div>
        <div class="ac_test_card wi_fadeUp">
          <div class="ac_test_stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <p class="ac_test_txt">{t.testimonios.t2_txt}</p>
          <div class="ac_test_autor">
            <span class="ac_test_avatar"><i class="fas fa-user-tie"></i></span>
            <div><strong>{t.testimonios.t2_aut}</strong><span>{t.testimonios.t2_crg}</span></div>
          </div>
        </div>
        <div class="ac_test_card wi_fadeUp">
          <div class="ac_test_stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <p class="ac_test_txt">{t.testimonios.t3_txt}</p>
          <div class="ac_test_autor">
            <span class="ac_test_avatar"><i class="fas fa-user-gear"></i></span>
            <div><strong>{t.testimonios.t3_aut}</strong><span>{t.testimonios.t3_crg}</span></div>
          </div>
        </div>
        <div class="ac_test_card wi_fadeUp">
          <div class="ac_test_stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <p class="ac_test_txt">{t.testimonios.t4_txt}</p>
          <div class="ac_test_autor">
            <span class="ac_test_avatar"><i class="fas fa-briefcase"></i></span>
            <div><strong>{t.testimonios.t4_aut}</strong><span>{t.testimonios.t4_crg}</span></div>
          </div>
        </div>
        <div class="ac_test_card wi_fadeUp">
          <div class="ac_test_stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <p class="ac_test_txt">{t.testimonios.t5_txt}</p>
          <div class="ac_test_autor">
            <span class="ac_test_avatar"><i class="fas fa-bolt"></i></span>
            <div><strong>{t.testimonios.t5_aut}</strong><span>{t.testimonios.t5_crg}</span></div>
          </div>
        </div>
        <div class="ac_test_card wi_fadeUp">
          <div class="ac_test_stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <p class="ac_test_txt">{t.testimonios.t6_txt}</p>
          <div class="ac_test_autor">
            <span class="ac_test_avatar"><i class="fas fa-graduation-cap"></i></span>
            <div><strong>{t.testimonios.t6_aut}</strong><span>{t.testimonios.t6_crg}</span></div>
          </div>
        </div>
    </div>
  </section>

  <!-- ══ MÓDULOS ══ -->
  <section class="ac_sec">
    <div class="ac_sec_head">
      <div class="ac_sec_badge"><i class="fas fa-layer-group"></i> {t.funciones.badge}</div>
      <h2 class="ac_sec_tit">{t.funciones.tit}<span class="ac_grad">{t.funciones.titGrad}</span></h2>
      <p class="ac_sec_sub">{t.funciones.sub}</p>
    </div>
    <div class="ac_modulos_grid">
        <a href={route('/crear')} class="ac_modulo_card wi_fadeUp" style="--mc:#0EBEFF">
          <div class="ac_modulo_ico"><i class="fas fa-file-word"></i></div>
          <div class="ac_modulo_info">
            <strong>{t.funciones.f1_tit}</strong>
            <span>{t.funciones.f1_sub}</span>
          </div>
          <div class="ac_modulo_arr"><i class="fas fa-arrow-right"></i></div>
        </a>
        <a href={route('/crear')} class="ac_modulo_card wi_fadeUp" style="--mc:#29C72E">
          <div class="ac_modulo_ico"><i class="fas fa-robot"></i></div>
          <div class="ac_modulo_info">
            <strong>{t.funciones.f2_tit}</strong>
            <span>{t.funciones.f2_sub}</span>
          </div>
          <div class="ac_modulo_arr"><i class="fas fa-arrow-right"></i></div>
        </a>
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <section class="ac_cta_sec">
    <div class="ac_cta_wrap wi_fadeUp">
      <div class="ac_hero_orb ac_orb1"></div>
      <div class="ac_hero_orb ac_orb2"></div>
      <div class="ac_cta_glow"></div>
      <div class="ac_cta_inner">
        <span class="ac_cta_emoji"><i class="fas fa-rocket" style="font-size: 3rem; color: var(--sc, #7000FF);"></i></span>
        <h2 set:html={t.cta.tit}></h2>
        <p>{t.cta.sub}</p>
        <div class="ac_cta_chips">
            <a href={route('/crear')} class="ac_chip" style="--cc:#0EBEFF" data-witip={t.cta.chipEditor} data-wtipo="top">
              <i class="fas fa-file-word"></i> {t.cta.chipEditor}
            </a>
            <a href={route('/crear')} class="ac_chip" style="--cc:#29C72E" data-witip={t.cta.chipSimulador} data-wtipo="top">
              <i class="fas fa-robot"></i> {t.cta.chipSimulador}
            </a>
        </div>
        <div class="ac_cta_btns">
          <a href={route('/crear')} class="ac_btn_p ac_btn_lg"><i class="fas fa-file-word"></i> {t.cta.btnEditor}</a>
          <a href={route('/blog')} class="ac_btn_s ac_btn_lg"><i class="fas fa-lightbulb"></i> {t.cta.btnBlog}</a>
        </div>
      </div>
    </div>
  </section>

</div>
</Layout>

<script>
  const animateCounters = () => {
    document.querySelectorAll('.ac_counter_num').forEach(el => {
      const targetVal = (el as HTMLElement).dataset.target;
      if (!targetVal) return;
      
      const target = parseInt(targetVal);
      const duration = 2000;
      let start: number | null = null;
      
      const step = (ts: number) => {
        if (!start) start = ts;
        const progress = Math.min((ts - start) / duration, 1);
        const ease = 1 - Math.pow(1 - progress, 4);
        const current = Math.floor(ease * target);
        el.textContent = current.toLocaleString();
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  };

  const initAcerca = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.wi_fadeUp').forEach(el => {
      observer.observe(el);
    });

    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounters();
          counterObserver.disconnect();
        }
      });
    }, { threshold: 0.5 });

    const band = document.querySelector('.ac_counter_band');
    if (band) counterObserver.observe(band);

    const shareBtn = document.getElementById('ac_compartir');
    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        const url = window.location.origin;
        const shareTxt = shareBtn.getAttribute('data-share-text') || '';
        const copiedTxt = shareBtn.getAttribute('data-share-copied') || '';
        
        if (navigator.share) {
          navigator.share({ 
            title: document.title, 
            text: shareTxt, 
            url 
          }).catch(() => {});
        } else {
          navigator.clipboard.writeText(url);
          shareBtn.textContent = copiedTxt;
          setTimeout(() => {
            shareBtn.innerHTML = '<i class="fas fa-share-nodes"></i> ' + (document.documentElement.lang === 'en' ? 'Share App' : 'Compartir App');
          }, 2000);
        }
      });
    }

  };

  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('.ac_wrap')) {
      initAcerca();
    }
  });
</script>
