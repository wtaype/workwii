---
// src/lib/inicio/Inicio.astro
// Shared Homepage Template for Workwii supporting ES/EN translations
import { Saludar, imgwii } from '../widev/widev.js';
import { app } from '../../wii.js';
import { supabase } from '../supabase.js';
import { locales } from './idiomaInicio.js';
import { useTranslations } from '../i18n/utils.js';
import { getCategoryLabel } from '../blog/post/idiomaPost.js';
import estilos from './inicio.css?inline';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const lg = useTranslations(lang, locales);

// We fetch blog posts dynamically on the server side
let posts: any[] = [];
try {
  // Query Supabase for active posts in the current language
  const { data: rawPosts, error } = await supabase
    .from('blog')
    .select('id, slug, titulo, descripcion, categoria, creado, imagen, vistas, likes')
    .eq('activo', true)
    .eq('lang', lang)
    .order('creado', { ascending: false })
    .limit(16);

  if (!error && rawPosts) {
    posts = rawPosts.map((p) => ({
      id: p.id,
      slug: p.slug,
      titulo: p.titulo,
      resumen: p.descripcion || '',
      categoria: p.categoria,
      creado: p.creado,
      imagen: p.imagen || '/poster.webp',
      vistas: p.vistas || 0,
      likes: p.likes || 0
    }));
  }
} catch (e) {
  console.error('Error fetching blog posts in Inicio.astro:', e);
}
---

<style is:global set:html={estilos}></style>

<div class="inicio" data-locale={lang}>
  <section class="hero">
    <div class="hero_txt">
      <div class="hero_saludo">
        <span>{Saludar()} {lg('inicio.saludo')}</span><span class="hero_wave"><i class="fa-regular fa-hand"></i></span>
      </div>
      <h1 class="font_o mainh">{lg('inicio.heroTitle')}</h1>
      <span class="gradiente hero_sub_tit font_o">{lg('inicio.heroSubtitle')}</span>
      <div class="hero_roles">
        <span class="role active">{lg('inicio.roles')[0]} <i class="fas fa-rocket"></i></span>
        <span class="role">{lg('inicio.roles')[1]} <i class="fas fa-expand"></i></span>
        <span class="role">{lg('inicio.roles')[2]} <i class="fas fa-comments"></i></span>
        <span class="role">{lg('inicio.roles')[3]} <i class="fab fa-linkedin"></i></span>
      </div>
      <div class="hero_oracion font_o">
        <p class="hero_pregunta">{lg('inicio.heroQuestion')}</p>
        <p>{lg('inicio.heroDescription1')}</p>
        <p set:html={lg('inicio.heroDescription2')}></p>
      </div>
      <div class="hero_ctas" data-herowi="50">
        <button class="btn_sec btn_principal font_o bt_auth registrar" id="btn-hero-cta">
          <i class="fas fa-rocket"></i><span>{lg('inicio.btnStart')}</span>
        </button>
        <a href="#dolores" class="btn_sec font_o">
          <span>{lg('inicio.btnLearnMore')}</span><i class="fas fa-arrow-down"></i>
        </a>
      </div>
    </div>
    <div class="hero_visual">
      <div class="hero_badge_float hb_1" data-witip={lang === 'en' ? "ATS Compatibility: 98%" : "Compatibilidad ATS: 98%"}><i class="fas fa-shield-halved"></i> 98% ATS</div>
      <div class="hero_badge_float hb_2" data-witip={lang === 'en' ? "Interview Simulator Active" : "Simulador de Entrevista Activo"}><i class="fas fa-microphone"></i> IA Feedback</div>
      <div class="hero_badge_float hb_3" data-witip={lang === 'en' ? "CV Approved" : "CV Listo"}><i class="fas fa-circle-check"></i> {lang === 'en' ? "Resume Ready" : "CV Listo"}</div>
      
      <div class="cv_mockup">
        <div class="mock_header">
          <div class="mock_dots"><span></span><span></span><span></span></div>
          <div class="mock_title">{lang === 'en' ? "Resume — ATS Optimizer" : "Curriculum Vitae — Optimizador ATS"}</div>
        </div>
        <div class="mock_body">
          <div class="mock_profile">
            <div class="mock_avatar"><i class="fas fa-user-tie"></i></div>
            <div class="mock_info">
              <div class="mock_name">Sofía Mendoza</div>
              <div class="mock_role">{lang === 'en' ? "Software Developer" : "Desarrolladora de Software"}</div>
            </div>
          </div>
          <div class="mock_bars">
            <div class="mock_bars">
              <div class="mock_bar_item">
                <span>{lang === 'en' ? "ATS Score" : "Puntuación ATS"}</span>
                <div class="bar_container"><div class="bar_fill ats"></div></div>
                <span class="bar_val">95%</span>
              </div>
              <div class="mock_bar_item">
                <span>{lang === 'en' ? "Keywords" : "Palabras Clave"}</span>
                <div class="bar_container"><div class="bar_fill keywords"></div></div>
                <span class="bar_val">89%</span>
              </div>
            </div>
          </div>
          <div class="mock_badges">
            <span class="m_badge active"><i class="fas fa-check"></i> {lang === 'en' ? "Readable for Recruiters" : "Legible para Reclutadores"}</span>
            <span class="m_badge active"><i class="fas fa-check"></i> {lang === 'en' ? "PDF Format" : "Formato PDF"}</span>
            <span class="m_badge warn"><i class="fas fa-exclamation-triangle"></i> {lang === 'en' ? "No GitHub Link" : "Sin Enlace a GitHub"}</span>
          </div>
        </div>
      </div>

      <div class="hero_deco"><i class="fas fa-briefcase"></i><i class="fas fa-star"></i><i class="fas fa-arrow-trend-up"></i></div>
    </div>
  </section>

  <section class="sec_ib" id="sec_blog">
    <h2 class="mainh1"><i class="fas fa-graduation-cap"></i> {lg('inicio.blogTitle')}</h2>
    <p class="sec_desc">{lg('inicio.blogSubtitle')}</p>
    <div class="ib_grid" id="ib_grid" data-herowi="100">
      {posts.length > 0 ? (
        posts.map((p) => {
          const normalizedCat = (p.categoria || '').toLowerCase().trim();
          const catColors = { 
            animales:'#0EBEFF', animals:'#0EBEFF',
            naturaleza:'#25b62a', nature:'#25b62a',
            amor:'#ff3849', love:'#ff3849',
            inspiración:'#ffa726', inspiration:'#ffa726',
            vida:'#6a00f5', life:'#6a00f5' 
          };
          const c = catColors[normalizedCat as keyof typeof catColors] ?? 'var(--mco)';
          const localeString = lang === 'en' ? 'en-US' : 'es-PE';
          const formattedDate = p.creado ? new Date(p.creado).toLocaleDateString(localeString, { day:'numeric', month:'short', year:'numeric' }) : '';
          return (
            <a href={lang === 'en' ? `/en/${p.slug || p.id || ''}` : `/${p.slug || p.id || ''}`} class="ib_card" data-slug={p.slug || p.id}>
              <div class="ib_img_wrap">
                <img src={imgwii.svg} data-src={p.imagen || '/poster.webp'} alt={p.titulo || 'Artículo'} class="ib_img wi_skeleton img_fade" />
                <span class="ib_cat" style={`background:color-mix(in srgb,${c} 20%,transparent);color:${c}`}>{getCategoryLabel(p.categoria, lang)}</span>
              </div>
              <div class="ib_body">
                <h3 class="ib_tit">{p.titulo || 'Sin título'}</h3>
                <p class="ib_resumen">{(p.descripcion || p.resumen || '').slice(0, 90)}...</p>
                <div class="ib_meta">
                  <span><i class="fas fa-calendar-alt"></i> {formattedDate}</span>
                  <span><i class="fas fa-eye"></i> {p.vistas || 0}</span>
                  <span><i class="fas fa-heart" style="color:#fe0149"></i> {p.likes || 0}</span>
                </div>
              </div>
            </a>
          );
        })
      ) : (
        <p class="ib_empty"><i class="fas fa-dove"></i> {lg('inicio.blogEmpty')}</p>
      )}
    </div>
    <div class="ib_footer">
      <a class="btn_sec ib_ver_mas font_o" href={lang === 'en' ? "/en/blog" : "/blog"}>
        <i class="fas fa-arrow-right"></i><span>{lg('inicio.blogVerMas')}</span>
      </a>
    </div>
  </section>

  <section class="sec_preguntas" id="dolores">
    <div class="sec_head">
      <h2><i class="fas fa-circle-question"></i> {lg('inicio.preguntasTitle')}</h2>
      <div class="sec_line"></div>
    </div>
    <p class="sec_desc">{lg('inicio.preguntasDesc')}</p>
    <div class="preg_grid" data-herowi="100">
      {lg('inicio.preguntas').map((p: any, idx: number) => (
        <div class="preg_card">
          <div class="preg_num font_o">0{idx + 1}</div>
          <p>{p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec_ej" id="beneficios">
    <div class="sec_head">
      <h2><i class="fas fa-award"></i> {lg('inicio.beneficiosTitle')}</h2>
      <div class="sec_line"></div>
    </div>
    <p class="sec_desc">{lg('inicio.beneficiosDesc')}</p>
    <div class="ej_grid" data-herowi="100">
      {lg('inicio.beneficios').map((b: any) => (
        <div class="ej_item" style={`--x:${b[3]}`}>
          <div class="ej_top"><span><i class={`fas ${b[0]}`}></i></span><span class="ej_tag font_o">{lg('inicio.beneficiosTag')}</span></div>
          <h3 class="font_o ej_title">{b[1]}</h3>
          <p class="font_o ej_desc">{b[2]}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Nueva Sección de Testimonios Latam -->
  <section class="sec_testimonios" id="testimonios">
    <h2 class="mainh1"><i class="fas fa-star" style="color: #FFB800;"></i> {lg('inicio.testimoniosTitle')}</h2>
    <p class="sec_desc">{lg('inicio.testimoniosDesc')}</p>
    <div class="test_grid" data-herowi="120">
      {lg('inicio.testimonios').map((test: any) => (
        <div class="test_card">
          <div class="test_header">
            <div class="test_avatar" style={`background: ${test.avatarColor}; color: ${test.avatarTextColor};`}><i class={`fas ${test.avatarIcon}`}></i></div>
            <div class="test_user">
              <strong>{test.nombre}</strong>
              <span>{test.ciudad}</span>
            </div>
          </div>
          <div class="test_stars">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
          </div>
          <p class="test_comment">{test.comentario}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec_feat" id="sec_funcionamiento">
    <div class="sec_head"><h2><i class="fas fa-circle-nodes"></i> {lg('inicio.pasosTitle')}</h2><div class="sec_line"></div></div>
    <p class="sec_desc">{lg('inicio.pasosDesc')}</p>
    <div class="feat_grid" data-herowi="150">
      {lg('inicio.pasos').map(([num, title, desc]: any) => (
        <div class="feat_card paso_card">
          <div class="feat_ico paso_num font_o">{num}</div>
          <h3 class="font_o">{title}</h3>
          <p>{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec_test">
    <div class="test_bg">
      <div class="test_inner_single">
        <div class="test_left">
          <h2 class="font_o"><i class="fas fa-briefcase"></i> {lg('inicio.acercaTitle')}</h2>
          <div class="about_text">
            <p set:html={lg('inicio.acercaP1')}></p>
            <p set:html={lg('inicio.acercaP2')}></p>
            <div class="sec_cta">
              <a href={lang === 'en' ? "/en/acerca" : "/acerca"} class="btn_sec font_o sec_cta_btn"><i class="fas fa-arrow-right"></i><span>{lg('inicio.acercaLink')}</span></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { herowi, imgwii, getls, savels } from '../widev/widev.js';

  /** @type {ReturnType<typeof setInterval>|null} */
  let roleInterval: any = null;

  const cleanup = () => { if (roleInterval) { clearInterval(roleInterval); roleInterval = null; } };

  const getLanguage = () => {
    return document.querySelector('.inicio')?.getAttribute('data-locale') || 'es';
  };

  const checkSession = () => {
    const wi = localStorage.getItem('wiSmile');
    const btnCta = document.getElementById('btn-hero-cta');
    const lang = getLanguage();
    if (btnCta) {
      if (wi) {
        btnCta.innerHTML = '<i class="fas fa-house-user"></i> <span>' + (lang === 'en' ? 'Go to Dashboard' : 'Ir a mi Panel') + '</span>';
        btnCta.setAttribute('data-target-url', lang === 'en' ? '/en/smile' : '/smile');
        btnCta.classList.remove('bt_auth', 'registrar');
      } else {
        btnCta.innerHTML = '<i class="fas fa-rocket"></i> <span>' + (lang === 'en' ? 'Start for Free' : 'Comenzar Gratis') + '</span>';
        btnCta.removeAttribute('data-target-url');
        btnCta.classList.add('bt_auth', 'registrar');
      }
    }
  };

  const updateDOMWithCache = (cached: any[]) => {
    cached.slice(0, 16).forEach(p => {
      const card = document.querySelector(`.ib_card[data-slug="${p.slug || p.id}"]`);
      if (!card) return;
      const meta = card.querySelector('.ib_meta');
      const lang = getLanguage();
      if (meta) {
        meta.innerHTML = `
          <span><i class="fas fa-calendar-alt"></i> ${p.creado ? new Date(p.creado).toLocaleDateString(lang === 'en' ? 'en-US' : 'es-PE', { day:'numeric', month:'short', year:'numeric' }) : ''}</span>
          <span><i class="fas fa-eye"></i> ${p.vistas || 0}</span>
          <span><i class="fas fa-heart" style="color:#fe0149"></i> ${p.likes || 0}</span>
        `;
      }
    });
  };

  const syncCache = async () => {
    const lang = getLanguage();
    const cacheKey = `ultimosposts_${lang}`;
    let cached = getls(cacheKey);
    if (cached && Array.isArray(cached) && cached.length) {
      updateDOMWithCache(cached);
      return;
    }
    try {
      const { supabase } = await import('../supabase.js');
      const { data } = await supabase
        .from('blog')
        .select('id, slug, titulo, descripcion, categoria, creado, imagen, vistas, likes')
        .eq('activo', true)
        .eq('lang', lang)
        .order('creado', { ascending: false })
        .limit(16);
      if (data) {
        const mapped = data.map(p => ({
          id: p.id,
          slug: p.slug,
          titulo: p.titulo,
          resumen: p.descripcion || '',
          categoria: p.categoria,
          creado: p.creado,
          imagen: p.imagen || '/poster.webp',
          vistas: p.vistas || 0,
          likes: p.likes || 0
        }));
        savels(cacheKey, mapped, 24);
        updateDOMWithCache(mapped);
      }
    } catch (e) {
      console.error(e);
    }
  };

  const init = () => {
    cleanup();

    let idx = 0;
    const roles = document.querySelectorAll('.hero_roles .role');
    if (roles.length) {
      roleInterval = setInterval(() => {
        roles[idx].classList.remove('active');
        idx = (idx + 1) % roles.length;
        roles[idx].classList.add('active');
      }, 2500);
    }

    checkSession();

    const btnCta = document.getElementById('btn-hero-cta');
    if (btnCta) {
      btnCta.addEventListener('click', (e) => {
        const targetUrl = btnCta.getAttribute('data-target-url');
        if (targetUrl) {
          e.preventDefault();
          window.location.href = targetUrl;
        }
      });
    }

    syncCache();
    herowi();
    imgwii.ver('#sec_blog');
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-preparation', cleanup);
</script>
