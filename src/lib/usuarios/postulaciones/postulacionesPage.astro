---
// src/lib/usuarios/postulaciones/postulacionesPage.astro
// Maquetacion y Layout del modulo de postulaciones
import { idiomaPostulaciones } from './idiomaPostulaciones.js';
const lang = Astro.locals.lang || 'es';
const lg   = idiomaPostulaciones[lang];
---

<div class="post_root">

  <!-- ══ BARRA SUPERIOR (TOPBAR UNIFICADA) ══════════════════════════════════ -->
  <header class="post_topbar">
    
    <!-- Izquierda: logo + selector de candidatura + nombre editable -->
    <div class="post_topbar_left">
      <div class="post_brand">
        <div class="post_brand_icon">
          <i class="fas fa-briefcase"></i>
        </div>
        <div class="post_brand_text">
          <span class="post_brand_title">{lg['post.titulo']}</span>
        </div>
      </div>

      <div class="post_divider_v"></div>

      <!-- Selector de postulación -->
      <div class="post_selector_group">
        <div class="post_sel_wrapper">
          <i class="fas fa-folder-open post_sel_ico"></i>
          <select id="post_selector" class="post_selector">
            <option value="">{lg['post.seleccionar']}</option>
          </select>
          <i class="fas fa-chevron-down post_sel_arrow"></i>
        </div>
        
        <div class="post_badge_estado" id="post_badge_estado">
          <span class="post_estado_dot" id="post_estado_dot"></span>
          <span class="post_estado_txt" id="post_estado_txt"></span>
        </div>
      </div>

      <div class="post_divider_v post_desc_divider post_hidden"></div>

      <!-- Campo para editar el nombre de la postulación activa -->
      <div class="post_nombre_edit_group post_hidden" id="post_nombre_edit_container">
        <div class="post_header_input_wrap">
          <i class="fas fa-pen"></i>
          <input type="text" id="post_nombre_input" class="post_header_nombre_input" placeholder={lg['post.nombreLabel']} autocomplete="off" />
        </div>
        <button id="post_btn_guardar_nombre" class="post_btn_save_nombre" data-witip={lg['post.guardarNombre']}>
          <i class="fas fa-save"></i>
        </button>
      </div>

    </div>

    <!-- Derecha: Estado de postulación, subir CV, nueva postulación, eliminar -->
    <div class="post_topbar_right">
      <!-- Subir CV -->
      <div class="post_upload_wrapper post_hidden" id="post_upload_container">
        <input type="file" id="post_cv_file" accept=".pdf,.docx,.doc" class="dpn" />
        <button id="post_btn_subir_cv" class="post_btn_upload">
          <i class="fas fa-cloud-upload-alt"></i>
          <span>{lg['post.subirCV']}</span>
        </button>
      </div>

      <!-- Selector de estado -->
      <select id="post_estado_sel" class="post_estado_sel post_hidden">
        <option value="postulado">{lg['post.estados.postulado']}</option>
        <option value="entrevista">{lg['post.estados.entrevista']}</option>
        <option value="rechazado">{lg['post.estados.rechazado']}</option>
        <option value="oferta">{lg['post.estados.oferta']}</option>
      </select>

      <!-- Nueva Postulación -->
      <button id="post_btn_nueva" class="post_btn_cta">
        <i class="fas fa-plus"></i>
        <span>{lg['post.nueva']}</span>
      </button>

      <!-- Eliminar candidatura -->
      <button id="post_btn_eliminar" class="post_btn_icon_del post_hidden" data-witip={lg['post.eliminar']}>
        <i class="fas fa-trash-alt"></i>
      </button>
    </div>

  </header>

  <!-- ══ ESTADO VACIO ══════════════════════════════════════════════════════ -->
  <div class="post_empty_state post_hidden" id="post_empty">
    <div class="post_empty_glow"></div>
    <div class="post_empty_icon"><i class="fas fa-briefcase"></i></div>
    <h2 class="post_empty_h">{lg['post.sinPostulaciones']}</h2>
    <p class="post_empty_p">{lg['post.sinPostulacionesSub']}</p>
    <button class="post_btn_cta" onclick="document.getElementById('post_btn_nueva')?.click()">
      <i class="fas fa-plus"></i> {lg['post.crearPrimera']}
    </button>
  </div>

  <!-- ══ WORKSPACE PRINCIPAL (2 COLUMNAS) ═══════════════════════════════════ -->
  <main class="post_workspace post_hidden" id="post_workspace">
    
    <!-- Columna Izquierda: ChatWii Plano -->
    <section class="post_pane chatwii_postulaciones">
      <div id="post_chat_container" class="chatwii_main"></div>
    </section>

    <!-- Columna Derecha: CV Preview A4 (Ocupa 100% de la columna) -->
    <section class="post_pane post_pane_preview">
      
      <!-- Area A4 Scrollable -->
      <div class="ps_preview_pdf" id="post_a4_scroll">
        <div class="post_preview_empty" id="post_preview_vacio">
          <div class="post_prev_empty_ico"><i class="fas fa-file-circle-plus"></i></div>
          <p>{lg['post.previewVacio']}</p>
          <span>{lg['post.previewVacioSub']}</span>
          <button class="post_btn_upload_lg" onclick="document.getElementById('post_btn_subir_cv')?.click()">
            <i class="fas fa-cloud-upload-alt"></i> {lg['post.subirCV']}
          </button>
        </div>
        
        <div id="post_cv_printable_area" class="cr_printable_pages_container"></div>
      </div>

    </section>
  </main>

</div>

<!-- ══ MODAL NUEVA POSTULACION (DOS COLUMNAS Y ICONOS EN LABELS) ════════════ -->
<div class="wiModal" id="post_modal_nueva">
  <div class="modalBody cr_confirm_modal_body post_modal_dos_columnas" id="nueva_postulacion">
    <button class="modalX" data-wimodal-close>&times;</button>
    <div class="cr_confirm_content">
      
      <!-- Header del Modal -->
      <div class="post_modal_header_custom">
        <div class="post_modal_hico"><i class="fas fa-plus-circle"></i></div>
        <h3 class="post_modal_htit_custom">{lg['post.modalTitulo']}</h3>
      </div>

      <!-- Grid de Dos Columnas -->
      <div class="post_modal_grid_layout">
        
        <!-- Columna Izquierda: Formulario (forms_postul) -->
        <div class="post_modal_col" id="forms_postul">

          <div class="post_fld">
            <label class="post_lbl">
              <i class="fas fa-building post_lbl_ico"></i>
              <span>{lg['post.modalEmpresa']}</span>
            </label>
            <input id="postul_empresa" type="text" class="post_inp" placeholder={lg['post.modalEmpresaPl']} autocomplete="off" />
          </div>

          <div class="post_fld">
            <label class="post_lbl">
              <i class="fas fa-user-tie post_lbl_ico"></i>
              <span>{lg['post.modalCargo']}</span>
            </label>
            <input id="postul_cargo" type="text" class="post_inp" placeholder={lg['post.modalCargoPl']} autocomplete="off" />
          </div>

          <div class="post_fld">
            <label class="post_lbl">
              <i class="fas fa-language post_lbl_ico"></i>
              <span>{lg['post.modalIdioma']}</span>
            </label>
            <select id="postul_idioma" class="post_inp">
              <option value="es">Español</option>
              <option value="en">English</option>
            </select>
          </div>

          <!-- Campo subir CV desde el modal -->
          <div class="post_fld">
            <label class="post_lbl">
              <i class="fas fa-file-pdf post_lbl_ico"></i>
              <span>{lg['post.modalCv']}</span>
            </label>
            <div class="post_cv_upload_row">
              <input type="file" id="postul_cv" accept=".pdf,.docx,.doc" class="dpn" />
              <button type="button" id="postul_cv_btn" class="post_btn_upload_modal">
                <i class="fas fa-cloud-upload-alt"></i>
                <span>{lg['post.modalCvBtn']}</span>
              </button>
              <span id="postul_cv_nombre" class="post_cv_filename">{lg['post.modalCvNinguno']}</span>
            </div>
          </div>

        </div>

        <!-- Columna Derecha: Descripción/Notas de Vacante (descri_postul) -->
        <div class="post_modal_col" id="descri_postul">
          <div class="post_fld post_fld_textarea">
            <label class="post_lbl">
              <i class="fas fa-align-left post_lbl_ico"></i>
              <span>{lg['post.ofertaLabel']}</span>
            </label>
            <textarea id="postul_vacante" class="post_inp post_modal_textarea" placeholder={lg['post.ofertaPlaceholder']} rows="8"></textarea>
          </div>
        </div>

      </div>

      <!-- Footer / Acción -->
      <div class="post_modal_footer_custom">
        <button id="post_modal_guardar" class="post_btn_cta post_btn_full">
          <i class="fas fa-check"></i> {lg['post.modalGuardar']}
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  import { protegerRuta } from '../../wiauth/sesion.js';
  import { idiomaPostulaciones } from './idiomaPostulaciones.js';
  import { initPostulaciones } from './postulacionesVisual.js';

  const init = async () => {
    const u = await protegerRuta(['usuario', 'editor', 'gestor', 'admin']);
    if (!u) return;
    const lang = document.documentElement.lang || 'es';
    const lg   = (idiomaPostulaciones as any)[lang] || idiomaPostulaciones['es'];
    initPostulaciones(lang, lg);
  };

  document.addEventListener('astro:page-load', init);
</script>
