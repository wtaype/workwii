---
// src/components/Footer.astro
import { app, lanzamiento, by, linkme, version, id } from '../wii.js';
import { useTranslations, getRelativeLocaleUrl } from '../lib/i18n/utils.js';

const lang = Astro.currentLocale || 'es';
const lg = useTranslations(lang);

const REDES = [
  { tit: 'YouTube',   ico: 'fab fa-youtube',   url: `https://www.youtube.com/@${id}`,   bg: '#ff0000' },
  { tit: 'Facebook',  ico: 'fab fa-facebook-f', url: `https://www.facebook.com/${id}e`, bg: '#1877F2' },
  { tit: 'Instagram', ico: 'fab fa-instagram',  url: `https://www.instagram.com/${app}e`, bg: 'linear-gradient(45deg,#f58529,#dd2a7b,#515bd4)' },
  { tit: 'TikTok',    ico: 'fab fa-tiktok',     url: `https://www.tiktok.com/@${id}`,   bg: '#000'    },
];

const ahora = new Date();

// Calcular las URLs correspondientes de idioma para el path actual
const path = Astro.url.pathname;
const cleanPath = path.replace(/^\/en/, '').replace(/\/$/, '') || '/';
const urlEs = cleanPath === '/' ? '/' : cleanPath;
const urlEn = cleanPath === '/' ? '/en' : `/en${cleanPath}`;
---

<footer class="foo">
  <div class="foo_inner">
    <div class="foo_left">
      <div class="foo_brand">
        <span class="foo_app"><a href={getRelativeLocaleUrl(lang, '/')}>{app}</a></span>
        <span class="foo_ver">{version}</span>
      </div>
      <div class="foo_links">
        <a href={getRelativeLocaleUrl(lang, '/terminos')}   class="foo_link nv_item" data-page="terminos"  ><i class="fas fa-file-contract"></i> {lg('footer.terminos')}</a>
        <a href={getRelativeLocaleUrl(lang, '/cookies')}    class="foo_link nv_item" data-page="cookies"   ><i class="fas fa-cookie-bite"></i> {lg('footer.cookies')}</a>
        <a href={getRelativeLocaleUrl(lang, '/privacidad')} class="foo_link nv_item" data-page="privacidad"><i class="fas fa-lock"></i> {lg('footer.privacidad')}</a>
        <a href={getRelativeLocaleUrl(lang, '/feedback')}   class="foo_link nv_item" data-page="feedback"  ><i class="fas fa-comment-dots"></i> {lg('footer.feedback')}</a>
        <a href={getRelativeLocaleUrl(lang, '/contacto')}   class="foo_link nv_item" data-page="contacto"  ><i class="fas fa-envelope"></i> {lg('footer.contacto')}</a>
        {REDES.map(r => (
          <a href={r.url} class="redsscc" target="_blank" rel="noopener noreferrer" title={r.tit} style={`--rb:${r.bg}`}><i class={r.ico}></i></a>
        ))}
      </div>
    </div>
    <div class="foo_right">
      <!-- Selector de idioma premium footer -->
      <div class="nv_lang" id="footer-language-switcher">
        <a href={urlEs} class={`lang_btn ${lang === 'es' ? 'active' : ''}`} data-lang="es">ES</a>
        <span class="lang_divider">|</span>
        <a href={urlEn} class={`lang_btn ${lang === 'en' ? 'active' : ''}`} data-lang="en">EN</a>
      </div>

      <span>{lg('footer.creadoCon')} <i class="fas fa-heart" style="color:var(--mco);"></i> {lg('footer.por')} <a href={linkme} target="_blank"><strong>{by}</strong></a> {lanzamiento} - {ahora.getFullYear()}</span>
    </div>
  </div>
</footer>

<div class="cookiess" id="cookiess" role="dialog" aria-live="polite" aria-label={lg('cookies.mensaje')} aria-describedby="cookiess-desc">
  <p class="cookiess_txt" id="cookiess-desc"> <i class="fas fa-cookie-bite cookiess_ico"></i>
    {lg('cookies.mensaje')}
    <a href={getRelativeLocaleUrl(lang, '/cookies')} class="cookiess_link nv_item" data-page="cookies">{lg('cookies.masInfo')}</a>
  </p>
  <div class="cookiess_btns">
    <button class="cookiess_aceptar" id="ck_aceptar"><i class="fas fa-check"></i> {lg('cookies.aceptar')}</button>
    <button class="cookiess_rechazar" id="ck_rechazar">{lg('cookies.rechazar')}</button>
  </div>
</div>

<script>
  import { savels, getls } from '../lib/widev.js';

  const CK_KEY = 'cookiesPrivacidad';

  const initCookiesBanner = () => {
    const banner = document.getElementById('cookiess');
    if (!banner) return;

    if (getls(CK_KEY) !== null) {
      banner.remove();
      return;
    }

    setTimeout(() => {
      // Check again to avoid showing if accepted during the delay
      if (getls(CK_KEY) !== null) {
        banner.remove();
        return;
      }
      banner.classList.add('cookiess_show');
    }, 800);
  };

  const handleAction = (val: boolean) => {
    const banner = document.getElementById('cookiess');
    if (!banner) return;
    savels(CK_KEY, val);
    banner.classList.remove('cookiess_show');
    setTimeout(() => banner.remove(), 400);
  };

  // Click handler delegation for banner actions
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#ck_aceptar')) {
      handleAction(true);
    } else if (target.closest('#ck_rechazar')) {
      handleAction(false);
    }
  });

  const initLangSwitcher = () => {
    const switcher = document.getElementById('footer-language-switcher');
    if (!switcher) return;

    const lang = document.documentElement.lang || 'es';
    const path = window.location.pathname;
    const cleanPath = path.replace(/^\/en/, '').replace(/\/$/, '') || '/';

    const btnEs = switcher.querySelectorAll('[data-lang="es"]');
    const btnEn = switcher.querySelectorAll('[data-lang="en"]');

    const esHref = cleanPath === '/' ? '/' : cleanPath;
    const enHref = cleanPath === '/' ? '/en' : `/en${cleanPath}`;

    btnEs.forEach(el => {
      el.setAttribute('href', esHref);
      el.classList.toggle('active', lang === 'es');
    });
    btnEn.forEach(el => {
      el.setAttribute('href', enHref);
      el.classList.toggle('active', lang === 'en');
    });
  };

  // Re-run every page-load since we use ClientRouter
  document.addEventListener('astro:page-load', () => {
    initCookiesBanner();
    initLangSwitcher();
  });
</script>
